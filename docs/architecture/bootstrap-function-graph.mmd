flowchart LR
  subgraph Parser["Parser and AST construction"]
    ast_stmt["ast_stmt<br/>Parses a statement<br/>returns AST node id"]
    ast_expr["ast_expr<br/>Parses an expression<br/>returns AST node id"]
    ast_expr_prec["ast_expr_prec<br/>Precedence-climbing parser<br/>returns AST node id"]
    ast_type["ast_type<br/>Parses a type expression<br/>returns type node id or 0"]
  end

  subgraph Checker["Type checking, ownership, and control-flow facts"]
    tc_stmt["tc_stmt<br/>Checks a statement<br/>returns void; mutates checker state"]
    tc_expr["tc_expr<br/>Checks an expression<br/>returns void; annotates AST/state"]
    tc_consume_call["tc_consume_call<br/>Checks consuming calls<br/>returns void; updates ownership"]
    tc_enter_scope["tc_enter_scope<br/>Pushes lexical scope<br/>returns void"]
    tc_leave_scope["tc_leave_scope<br/>Pops lexical scope<br/>returns void"]
    tc_flow_save_base["tc_flow_save_base<br/>Snapshots baseline flow<br/>returns void"]
    tc_flow_save_yes["tc_flow_save_yes<br/>Snapshots successful branch<br/>returns void"]
    tc_flow_restore_base["tc_flow_restore_base<br/>Restores baseline flow<br/>returns void"]
    tc_flow_merge_yes["tc_flow_merge_yes<br/>Merges branch ownership facts<br/>returns void"]
    tc_flow_end["tc_flow_end<br/>Closes flow frame<br/>returns void"]
  end

  subgraph Emitter["C emitter, reachability, and defer cleanup"]
    gen_program["gen_program<br/>Emits complete C translation unit<br/>returns void"]
    gen_function["gen_function<br/>Emits one function definition<br/>returns void"]
    gen_stmt["gen_stmt<br/>Emits one statement<br/>returns void"]
    gen_stmt_terminates["gen_stmt_terminates<br/>Computes terminal control flow<br/>returns int predicate"]
    gen_match_stmt["gen_match_stmt<br/>Emits match dispatch and arm cleanup<br/>returns void"]
    gen_expr["gen_expr<br/>Emits one expression<br/>returns void"]
    gen_collect_stmt["gen_collect_stmt<br/>Collects reachable declarations<br/>returns void"]
    gen_collect_expr["gen_collect_expr<br/>Collects expression dependencies<br/>returns void"]
    gen_defer_push["gen_defer_push<br/>Registers deferred expression<br/>returns void"]
    gen_emit_defer_from["gen_emit_defer_from<br/>Emits cleanup from stack baseline<br/>returns void"]
    gen_emit_all_defers["gen_emit_all_defers<br/>Emits function-level cleanup<br/>returns void"]
    code_emit["code_emit<br/>Appends a token to C buffer<br/>returns void; grows buffer"]
    emit_runtime["emit_runtime<br/>Emits portable C runtime<br/>returns void"]
  end

  subgraph Includes["Source loading and recursive include expansion"]
    include_process_line["include_process_line<br/>Classifies and expands one source line<br/>returns void"]
    include_expand_handle["include_expand_handle<br/>Reads and expands a source handle<br/>returns void"]
    source_import_fail["source_import_fail<br/>Reports include/dependency failure<br/>returns void; terminates compilation"]
  end

  subgraph External["Selected external helper boundaries"]
    source_io["source_put / c_source_put<br/>append source or C text"]
    include_io["basalt_include_open_line / close / realpath<br/>include backend and path resolution"]
    dependency["source_dep_add / source_dep_reaches<br/>dependency graph and cycle detection"]
    allocation["alloc_ints / grow_ints / free_ints<br/>temporary line-buffer ownership"]
    file_io["open_file / read_char / close_file<br/>file-handle I/O"]
  end

  ast_stmt -->|parses expressions| ast_expr
  ast_stmt -->|parses annotations| ast_type
  ast_expr -->|delegates precedence| ast_expr_prec
  ast_expr_prec -->|recurses for grouped/call operands| ast_expr
  ast_type -->|recurses for tuples, pointers, arrays, generics| ast_type

  tc_stmt -->|checks nested expressions| tc_expr
  tc_stmt -->|validates consuming calls| tc_consume_call
