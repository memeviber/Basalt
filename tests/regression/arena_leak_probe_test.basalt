include "../../src/stdlib/arena.basalt"

struct Edge {
  weight: int;
  target: Node*;
}

struct Node {
  value: int;
  next: Node*;
  edge: Edge*;
}

func main(): int {
  let root: arena::Arena = arena::new();
  let child: arena::Arena = arena::child(root);
  let zero_node: Node = 0;
  let zero_edge: Edge = 0;
  let first: Node* = arena::alloc(child, 1, zero_node);
  let second: Node* = arena::alloc(child, 1, zero_node);
  let first_edge: Edge* = arena::alloc(child, 1, zero_edge);
  let second_edge: Edge* = arena::alloc(child, 1, zero_edge);
  first.value = 5;
  second.value = 8;
  first.next = second;
  second.next = first;
  first.edge = first_edge;
  second.edge = second_edge;
  first_edge.weight = 3;
  second_edge.weight = 5;
  first_edge.target = second;
  second_edge.target = first;
  let next_probe: Node* = first.next;
  let first_edge_probe: Edge* = first.edge;
  let second_edge_probe: Edge* = second.edge;
  let checksum: int = first.value + next_probe.value + first_edge_probe.weight + second_edge_probe.weight;
  println checksum;
  // Intentional leak probe: neither child nor root is explicitly freed.
  // The process-level registry may reclaim tracked blocks at exit; this test
  // verifies the missing explicit lifetime boundary and generated behavior.
  return 0;
}
