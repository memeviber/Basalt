include "../../src/stdlib/arena.basalt"

struct RingNode {
  value: int;
  next: RingNode*;
}

func main(): int {
  let arena: arena::Arena = arena::new();
  let zero: RingNode = 0;
  let first: RingNode* = arena::alloc(arena, 1, zero);
  let cursor: RingNode* = first;
  let index: int = 1;
  first.value = 0;
  while index < 1024 {
    let node: RingNode* = arena::alloc(arena, 1, zero);
    node.value = index;
    cursor.next = node;
    cursor = node;
    index = index + 1;
  }
  cursor.next = first;
  let probe: RingNode* = first;
  let steps: int = 0;
  while steps < 1024 {
    probe = probe.next;
    steps = steps + 1;
  }
  let valid: int = 0;
  if probe == first then valid = 1;
  arena = arena::free(arena);
  println valid;
  return 0;
}
