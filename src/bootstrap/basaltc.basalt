let N_TUPLE: int = 43;
let N_TUPLE_BIND: int = 44;
let N_MOVE: int = 46;
let N_CLOSURE: int = 47;
let N_CLOSURE_CALL: int = 48;
let N_PRINTLN: int = 49;

let OP_ADD: int = 1;
let OP_SUB: int = 2;
let OP_MUL: int = 3;
let OP_DIV: int = 4;
let OP_EQ: int = 5;
