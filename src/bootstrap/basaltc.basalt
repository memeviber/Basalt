let tc_var_elem_name: int* = 0;
let tc_var_type: int* = 0;
let tc_var_fun_target: int* = 0;
let tc_var_owned: int* = 0;
let tc_var_moved: int* = 0;
let tc_var_borrow_count: int* = 0;
