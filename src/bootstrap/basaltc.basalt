func tc_find_function(name: int): int {
  let item: int = node_a[tc_root];
  while item != 0 {
    if (node_kind[item] == N_FUNC || node_kind[item] == N_GENERIC_FUNC || node_kind[item] == N_EXTERN) && node_value[item] == name then return item;
    item = node_next[item];
  }
  return 0;
}

func sym_find_last_scope(name: int): int {
  let i: int = sym_len[name] - 1;
  while i > 1 {
    if source[sym_start[name] + i] == 58 && source[sym_start[name] + i - 1] == 58 then return i - 1;
    i = i - 1;
  }
  return 0;
}

func sym_prefix_scope(name: int, length: int): int {
  if length <= 0 then return 0;
  let start: int = source_len + sym_text_len;
  let i: int = 0;
  while i < length { ensure_source(start + i); source[start + i] = source[sym_start[name] + i]; i = i + 1; }
  let id: int = sym_intern(start, length, L_ID, 0);
  sym_text_len = sym_text_len + length;
  return id;
}

func tc_find_function_ctx(name: int, ns: int): int {
  let exact: int = tc_find_function(name);
  if exact != 0 then return exact;
  if ns == 0 then return 0;
  let scope: int = ns;
  while scope != 0 {
    let candidate: int = sym_qualified(scope, name);
    let item: int = tc_find_function(candidate);
    if item != 0 then return item;
    let split: int = sym_find_last_scope(scope);
    if split == 0 then scope = 0;
    else scope = sym_prefix_scope(scope, split);
  }
  return 0;
}

func tc_find_enum_value(name: int): int {
  let item: int = node_a[tc_root];
  while item != 0 {
    if node_kind[item] == N_ENUM then {
      let f: int = node_a[item];
      while f != 0 { if node_a[f] == name then return node_value[item]; f = node_next[f]; }
    }
    item = node_next[item];
  }
  return 0;
}

func tc_find_enum_variant(name: int): int {
  tc_variant_enum = 0;
  tc_variant_member = 0;
  let item: int = node_a[tc_root];
  while item != 0 {
    if node_kind[item] == N_ENUM then {
      let f: int = node_a[item];
      while f != 0 {
        let qualified: int = sym_qualified(node_value[item], node_a[f]);
        if qualified == name then { tc_variant_enum = node_value[item]; tc_variant_member = f; return 1; }
        f = node_next[f];
      }
    }
    item = node_next[item];
  }
  return 0;
}

func tc_match_enum_decl(ty: int): int {
  if ty == 0 || node_kind[ty] != TY_NAMED then return 0;
  let decl: int = tc_find_enum_ctx(node_value[ty], node_scope[ty]);
  if decl == 0 then decl = tc_find_enum(node_value[ty]);
  return decl;
}

func tc_match_variant_member(decl: int, name: int): int {
  if decl == 0 || node_kind[decl] != N_ENUM then return 0;
  let field: int = node_a[decl];
  while field != 0 {
    if node_a[field] == name then return field;
    let qualified: int = sym_qualified(node_value[decl], node_a[field]);
    if qualified == name then return field;
    field = node_next[field];
  }
  return 0;
}

func tc_match_seen_variant(head: int, member: int): int {
  let arm: int = head;
  while arm != 0 {
    if node_aux[arm] == member then return 1;
    arm = node_next[arm];
  }
  return 0;
}

func tc_match_check_arm_bindings(variant: int, bindings: int): void {
  let field: int = node_b[variant];
  let binding: int = bindings;
  while field != 0 && binding != 0 {
    tc_type_node(node_b[field]);
    let bk: int = tc_kind; let bn: int = tc_name; let bek: int = tc_elem_kind; let ben: int = tc_elem_name;
    tc_add_var(node_value[binding], bk, bn, bek, ben, node_b[field]);
    binding = node_next[binding];
    field = node_next[field];
  }
  if field != 0 || binding != 0 then tc_fail(50);
}

func tc_emit_field_type(id: int): int {
  if id == 0 || node_kind[id] != N_FIELD_ACCESS then return 0;
  let base_ty: int = tc_emit_arg_type(node_a[id]);
  if base_ty == 0 then return 0;
  base_ty = gen_substitute_type(base_ty);
  if node_kind[base_ty] == TY_VARIANT then {
    let variant_item: int = node_value[base_ty];
    let variant_field: int = node_b[variant_item];
    while variant_field != 0 { if node_a[variant_field] == node_value[id] then return gen_substitute_type(node_b[variant_field]); variant_field = node_next[variant_field]; }
    return 0;
  }
  let struct_name: int = 0;
  let args: int = 0;
  if node_kind[base_ty] == TY_GENERIC then { struct_name = node_value[base_ty]; args = node_a[base_ty]; }
  else if node_kind[base_ty] == TY_NAMED then struct_name = node_value[base_ty];
  else return 0;
  let decl: int = tc_find_struct(struct_name);
  if decl == 0 then return 0;
  let field_bind_pushed: int = 0;
  if node_kind[decl] == N_GENERIC_STRUCT then {
    let gp: int = node_c[decl]; let ga: int = args;
    tc_bind_push(); field_bind_pushed = 1; tc_bind_clear();
    while gp != 0 && ga != 0 { if tc_bind_add(node_a[gp], ga) == 0 then { tc_bind_pop(); return 0; } gp = node_next[gp]; ga = node_next[ga]; }
  }
  let f: int = node_a[decl];
  while f != 0 {
    if node_a[f] == node_value[id] then { let result_field_type: int = tc_substitute_type(node_b[f]); if field_bind_pushed == 1 then tc_bind_pop(); return result_field_type; }
    f = node_next[f];
  }
  if field_bind_pushed == 1 then tc_bind_pop();
  return 0;
}

func tc_emit_arg_type(id: int): int {
  if id == 0 then return 0;
  if node_type[id] != 0 && (node_kind[id] == N_VAR || node_kind[id] == N_DEREF || node_kind[id] == N_INDEX) then return gen_substitute_type(node_type[id]);
  if node_kind[id] == N_ADDRESS then {
    if node_kind[node_a[id]] == N_VAR then {
      let addressed_function: int = tc_find_function_ctx(node_value[node_a[id]], node_scope[node_a[id]]);
      if addressed_function != 0 then return tc_signature_type(addressed_function);
    }
    tc_expr(id);
    return tc_result_type;
  }
  if node_kind[id] == N_CLOSURE then {
    if node_aux[id] > 0 then {
      let closure_serial_value: int = node_aux[id] - 1;
      let closure_scan: int = 0;
      while closure_scan < gen_closure_count {
        if gen_closure_serial[closure_scan] == closure_serial_value then return gen_closure_sig[closure_scan];
        closure_scan = closure_scan + 1;
      }
    }
    return gen_closure_signature(id);
  }
  if node_kind[id] == N_FIELD_ACCESS && node_aux[id] != 0 && node_kind[node_aux[id]] == TY_VARIANT then return node_aux[id];
  if node_kind[id] == N_FIELD_ACCESS then {
    let field_ty: int = tc_emit_field_type(id);
    if field_ty != 0 then return field_ty;
  }
  if node_kind[id] == N_INDIRECT_CALL then {
    let callee_type: int = tc_emit_arg_type(node_a[id]);
    if callee_type != 0 && (node_kind[callee_type] == TY_FUN || node_kind[callee_type] == TY_CLOSURE) then return gen_substitute_type(node_b[callee_type]);
  }
  if node_kind[id] == N_CALL && node_aux[id] != 0 then return gen_substitute_type(node_aux[id]);
  if node_kind[id] == N_CALL then {
    let call_param_type: int = gen_active_param_type(node_value[id]);
    if call_param_type != 0 && (node_kind[call_param_type] == TY_FUN || node_kind[call_param_type] == TY_CLOSURE) then return gen_substitute_type(node_b[call_param_type]);
  }
  if node_kind[id] == N_VAR then {
    let stable_type: int = node_type[id];
    if stable_type != 0 then return gen_substitute_type(stable_type);
    let formal_type: int = gen_active_param_type(node_value[id]);
    if formal_type != 0 then return gen_substitute_type(formal_type);
    let declared_type: int = gen_active_local_decl_type(node_value[id]);
    if declared_type != 0 then return gen_substitute_type(declared_type);
    if node_aux[id] != 0 then {
      let local_type: int = node_aux[id];
      let resolved_local_type: int = gen_substitute_type(local_type);
      if resolved_local_type != 0 then return resolved_local_type;
      return local_type;
    }
  }
  if node_kind[id] == N_STRING then return ast_node(TY_STRING, 0, 0, 0, 0, 0);
  if node_kind[id] == N_INT then return ast_node(TY_INT, 0, 0, 0, 0, 0);
  if node_kind[id] == N_BOOL then return ast_node(TY_BOOL, 0, 0, 0, 0, 0);
  if node_kind[id] == N_CHAR then return ast_node(TY_CHAR, 0, 0, 0, 0, 0);
  if node_kind[id] == N_FLOAT then { if node_aux[id] == TY_FLOAT then return ast_node(TY_FLOAT, 0, 0, 0, 0, 0); return ast_node(TY_DOUBLE, 0, 0, 0, 0, 0); }
  if node_kind[id] == N_NULL then return ast_node(TY_PTR, ast_node(TY_VOID, 0, 0, 0, 0, 0), 0, 0, 0, 0);
  if node_kind[id] == N_TUPLE then {
    if node_aux[id] != 0 then return gen_substitute_type(node_aux[id]);
    tc_expr(id);
    return tc_result_type;
  }
  let ek: int = gen_expr_kind(id);
  return tc_type_node_from_summary(ek, 0, tc_elem_kind, tc_elem_name);
}

func tc_expr_kind_for_emit(id: int): int {
  if id != 0 && node_kind[id] == N_CLOSURE then return TY_CLOSURE;
  if id != 0 && node_kind[id] == N_CALL && node_aux[id] != 0 then return node_kind[node_aux[id]];
  if id != 0 && node_kind[id] == N_INDIRECT_CALL then {
    let indirect_result_type: int = tc_emit_arg_type(id);
    if indirect_result_type != 0 then return node_kind[indirect_result_type];
    return TY_INT;
  }
  if id != 0 && node_kind[id] == N_CALL then {
    let call_param_type: int = gen_active_param_type(node_value[id]);
    if call_param_type != 0 && (node_kind[call_param_type] == TY_FUN || node_kind[call_param_type] == TY_CLOSURE) then {
      let call_result_type: int = gen_substitute_type(node_b[call_param_type]);
      if call_result_type != 0 then return node_kind[call_result_type];
    }
  }
  let f: int = tc_find_function_ctx(node_value[id], node_scope[id]);
  if f != 0 then {
    if node_kind[f] == N_GENERIC_FUNC then {
      let actual: int = node_b[id]; let a: int = node_a[id];
      if actual == 0 then {
        while a != 0 {
          let q: int = tc_emit_arg_type(a);
          if q != 0 then { if actual == 0 then actual = q; else actual = ast_link(actual, q); }
          a = node_next[a];
        }
      }
      let saved_count: int = gen_bind_count;
      ensure_gen_bind(saved_count + saved_count);
      let save_i: int = 0;
      while save_i < saved_count {
        gen_bind_name[saved_count + save_i] = gen_bind_name[save_i];
        gen_bind_type[saved_count + save_i] = gen_bind_type[save_i];
        save_i = save_i + 1;
      }
      gen_bind_decl(f, actual);
      let ret: int = gen_substitute_type(node_b[f]);
      let result_kind: int = TY_INT;
      if ret != 0 then { result_kind = node_kind[ret]; }
      gen_bind_clear();
      let restore_i: int = 0;
      while restore_i < saved_count {
        gen_bind_name[restore_i] = gen_bind_name[saved_count + restore_i];
        gen_bind_type[restore_i] = gen_bind_type[saved_count + restore_i];
        restore_i = restore_i + 1;
      }
      gen_bind_count = saved_count;
      if result_kind == TY_PARAM then { return TY_INT; }
      return result_kind;
    }
    if node_b[f] != 0 then { return node_kind[node_b[f]]; }
  }
  return TY_INT;
}

func tc_stmt(id: int, expected_kind: int, expected_name: int): void {
  if id != 0 && tc_ok == 1 then tc_error_pos = node_pos[id];
  if tc_ok == 0 || id == 0 then return;
  let k: int = node_kind[id];
  if k == N_CONST then {
    tc_type_node(node_b[id]); let ck: int = tc_kind; let cn: int = tc_name; let ce: int = tc_elem_kind; let cen: int = tc_elem_name;
    tc_mark_float_expr(node_c[id], ck);
    tc_expr(node_c[id]);
    let const_ffi_borrowed: int = tc_expr_ffi_borrowed;
    let const_fun_target: int = tc_expr_fun_target;
    if tc_literal_fits(node_c[id], ck) == 0 then tc_fail(54);
    if tc_same_full(ck, cn, ce, cen, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then { if tc_integer_literal_conversion(node_c[id], ck, tc_kind) == 0 && (node_kind[node_c[id]] != N_INT || node_value[node_c[id]] != 0) && node_kind[node_c[id]] != N_NULL then tc_fail(30); }
    tc_add_var(node_a[id], ck, cn, ce, cen, node_b[id]); sym_type[node_a[id]] = ck + 100;
    tc_var_const[tc_last_var_index] = 1;
    tc_var_fun_target[tc_last_var_index] = const_fun_target;
    tc_var_ffi_borrowed[tc_last_var_index] = const_ffi_borrowed;
  } else   if k == N_LET then {
    tc_type_node(node_b[id]); let dk: int = tc_kind; let dn: int = tc_name; let de: int = tc_elem_kind; let den: int = tc_elem_name;
    tc_mark_float_expr(node_c[id], dk);
    tc_expr(node_c[id]);
    let ek: int = tc_kind; let en: int = tc_name; let ee: int = tc_elem_kind; let een: int = tc_elem_name; let rhs_borrow: int = tc_expr_borrow_source; let rhs_borrow_origin: int = tc_expr_borrow_origin; let rhs_borrow_mut: int = tc_expr_borrow_mut; let rhs_borrow_param: int = tc_expr_borrow_param; let rhs_ffi_borrowed: int = tc_expr_ffi_borrowed; let rhs_fun_target: int = tc_expr_fun_target;
    if tc_is_owner_kind(dk) == 1 && node_kind[node_c[id]] == N_VAR then tc_fail(40);

    if tc_literal_fits(node_c[id], dk) == 0 then tc_fail(54);
    if tc_same_full(dk, dn, de, den, ek, en, ee, een) == 0 then {
      if tc_integer_literal_conversion(node_c[id], dk, ek) == 0 && (node_kind[node_c[id]] != N_INT || node_value[node_c[id]] != 0) && node_kind[node_c[id]] != N_NULL then tc_fail_types(20, dk, ek);
    }
    if dk == TY_DYN_ARRAY && node_kind[node_c[id]] == N_VAR then tc_move_value(node_c[id]);
    tc_add_var(node_a[id], dk, dn, de, den, node_b[id]);
    tc_var_fun_target[tc_last_var_index] = rhs_fun_target;
    tc_var_ffi_borrowed[tc_last_var_index] = rhs_ffi_borrowed;
    if tc_is_owner_kind(dk) == 1 || tc_owned_initializer(node_c[id]) == 1 then tc_var_owned[tc_last_var_index] = 1;
    if dk == TY_CLOSURE && node_kind[node_c[id]] == N_CLOSURE then tc_attach_closure_caps(tc_last_var_index, node_a[node_c[id]]);
    if dk == TY_PTR then { if rhs_borrow < 0 then { } else { if rhs_borrow_mut == 1 then tc_record_borrow_ex(tc_last_var_index, rhs_borrow, 3, rhs_borrow_origin); else tc_record_borrow_ex(tc_last_var_index, rhs_borrow, 2, rhs_borrow_origin); tc_var_borrow_param[tc_last_var_index] = rhs_borrow_param; } }
  } else if k == N_ASSIGN || k == N_COMPOUND_ASSIGN then {
    if tc_place_is_const(node_a[id]) == 1 then tc_fail(31);
    let lhs_field_root: int = 0 - 1;
    let lhs_field_name: int = 0;
    if node_kind[node_a[id]] == N_FIELD_ACCESS then { lhs_field_root = tc_field_target_root_for_place(node_a[node_a[id]]); lhs_field_name = node_value[node_a[id]]; }
    tc_expr(node_a[id]); let lk: int = tc_kind; let ln: int = tc_name; let le: int = tc_elem_kind; let len: int = tc_elem_name; let lhs_index: int = tc_last_var_index;
    tc_require_mutable(node_a[id]);
    tc_mark_float_expr(node_b[id], lk);
    tc_expr(node_b[id]);
    let rhs_borrow_assign: int = tc_expr_borrow_source;
    let rhs_borrow_origin_assign: int = tc_expr_borrow_origin;
    let rhs_borrow_mut_assign: int = tc_expr_borrow_mut;
    let rhs_borrow_param_assign: int = tc_expr_borrow_param;
    let rhs_ffi_borrowed_assign: int = tc_expr_ffi_borrowed;
    let rhs_fun_target_assign: int = tc_expr_fun_target;
    if k == N_COMPOUND_ASSIGN then {
      let combined: int = ast_node(N_BINOP, node_a[id], node_b[id], 0, node_value[id], 0);
      tc_expr(combined);
    }
    if lk == TY_DYN_ARRAY && node_kind[node_b[id]] == N_VAR then tc_fail(40);
    if tc_literal_fits(node_b[id], lk) == 0 then tc_fail(54);
    if tc_same_full(lk, ln, le, len, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then { if tc_integer_literal_conversion(node_b[id], lk, tc_kind) == 0 && (node_kind[node_b[id]] != N_INT || node_value[node_b[id]] != 0) && node_kind[node_b[id]] != N_NULL then tc_fail_types(21, lk, tc_kind); }
    if tc_ok == 1 && node_kind[node_a[id]] == N_VAR && lk == TY_DYN_ARRAY then {
      tc_var_owned[lhs_index] = 1;
      tc_var_moved[lhs_index] = 0;
    }
    if tc_ok == 1 && lk == TY_FUN then {
      if node_kind[node_a[id]] == N_VAR then tc_var_fun_target[lhs_index] = rhs_fun_target_assign;
      else if node_kind[node_a[id]] == N_FIELD_ACCESS then {
        tc_field_target_set(lhs_field_root, lhs_field_name, rhs_fun_target_assign);
      }
    }
    if tc_ok == 1 && node_kind[node_a[id]] == N_VAR && lk == TY_PTR then {
      tc_release_borrow(lhs_index);
      tc_var_borrow_source[lhs_index] = 0 - 1;
      tc_var_borrow_mode[lhs_index] = 0;
      tc_var_borrow_parent[lhs_index] = 0 - 1;
      tc_var_borrow_param[lhs_index] = 0;
      tc_var_fun_target[lhs_index] = rhs_fun_target_assign;
      tc_var_ffi_borrowed[lhs_index] = rhs_ffi_borrowed_assign;
      if rhs_borrow_assign < 0 then { } else { if rhs_borrow_mut_assign == 1 then tc_record_borrow_ex(lhs_index, rhs_borrow_assign, 3, rhs_borrow_origin_assign); else tc_record_borrow_ex(lhs_index, rhs_borrow_assign, 2, rhs_borrow_origin_assign); tc_var_borrow_param[lhs_index] = rhs_borrow_param_assign; }
    }
  } else if k == N_DEFER then {
    tc_expr(node_a[id]);
    if tc_kind != TY_VOID then tc_fail(46);
  } else if k == N_TUPLE_BIND then {
    tc_type_node(node_b[id]);
    let declared_ty: int = tc_result_type;
    let declared_kind: int = tc_kind;
    tc_expr(node_c[id]);
    let rhs_ty: int = tc_result_type;
    if declared_kind != TY_TUPLE || tc_kind != TY_TUPLE then tc_fail(52);
    else if declared_ty == 0 || rhs_ty == 0 || tc_type_equal(declared_ty, rhs_ty) == 0 then tc_fail_types(20, declared_kind, tc_kind);
    else {
      let elem: int = node_a[declared_ty];
      let binding: int = node_a[id];
      while elem != 0 && binding != 0 {
        tc_type_node(elem);
        let ek: int = tc_kind; let en: int = tc_name; let eek: int = tc_elem_kind; let een: int = tc_elem_name;
        tc_add_var(node_value[binding], ek, en, eek, een, elem);
        elem = node_next[elem];
        binding = node_next[binding];
      }
      if elem != 0 || binding != 0 then tc_fail(53);
    }
  } else if k == N_MATCH then {
    tc_expr(node_a[id]);
    let subject_kind: int = tc_kind;
    let subject_type: int = tc_result_type;
    let enum_decl: int = 0;
    if subject_kind == TY_NAMED && subject_type != 0 then enum_decl = tc_match_enum_decl(subject_type);
    if enum_decl == 0 then tc_fail(47);
    else {
        let arm: int = node_b[id];
        let has_default: int = 0;
        while arm != 0 {
          if node_value[arm] == 0 then {
            if has_default == 1 || node_next[arm] != 0 then tc_fail(74);
            has_default = 1;
            tc_enter_scope();
            tc_stmt(node_b[arm], expected_kind, expected_name);
            tc_leave_scope();
          } else {
            let member: int = tc_match_variant_member(enum_decl, node_value[arm]);
            if member == 0 then tc_fail(48);
            else {
              if tc_match_seen_variant(node_b[id], member) == 1 then tc_fail(49);
              node_aux[arm] = member;
              tc_enter_scope();
              tc_match_check_arm_bindings(member, node_a[arm]);
              tc_stmt(node_b[arm], expected_kind, expected_name);
              tc_leave_scope();
            }
          }
          arm = node_next[arm];
        }
        if has_default == 0 then {
          let variant: int = node_a[enum_decl];
          while variant != 0 {
            if tc_match_seen_variant(node_b[id], variant) == 0 then tc_fail(51);
            variant = node_next[variant];
          }
        }
    }
        } else if k == N_PRINT || k == N_PRINTLN then tc_expr(node_a[id]);

  else if k == N_EXPR then { tc_expr(node_a[id]); if node_kind[node_a[id]] == N_CALL then tc_consume_call(node_a[id]); }
  else if k == N_RETURN then {
    if node_a[id] == 0 then { if expected_kind != TY_VOID then tc_fail(22); }
    else { tc_mark_float_expr(node_a[id], expected_kind); tc_expr(node_a[id]); let return_borrow: int = tc_expr_borrow_source; if tc_literal_fits(node_a[id], expected_kind) == 0 then tc_fail(54); if expected_kind == TY_PTR then { if node_kind[node_a[id]] == N_ADDRESS then tc_check_explicit_return_address_escape(return_borrow); else tc_check_return_escape(return_borrow); } if expected_kind == TY_CLOSURE then tc_check_closure_value_escape(node_a[id]); if tc_same_full(expected_kind, expected_name, tc_expected_elem_kind, tc_expected_elem_name, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 then if tc_integer_literal_conversion(node_a[id], expected_kind, tc_kind) == 0 && node_kind[node_a[id]] != N_NULL then tc_fail_types(23, expected_kind, tc_kind); }
  } else if k == N_BREAK || k == N_CONTINUE then { if tc_loop_depth == 0 then tc_fail(24);   } else if k == N_BLOCK then {
    tc_enter_scope();
    let x: int = node_a[id]; while x != 0 { tc_stmt(x, expected_kind, expected_name); x = node_next[x]; }
    tc_leave_scope();

  } else if k == N_IF then {
    tc_expr(node_a[id]); if tc_is_numeric_kind(tc_kind) == 0 && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(25);
    if node_kind[node_b[id]] == N_DEFER || node_kind[node_c[id]] == N_DEFER then tc_fail(77);
    tc_flow_save_base();
    tc_stmt(node_b[id], expected_kind, expected_name);
    tc_flow_save_yes();
    tc_flow_restore_base();
    tc_stmt(node_c[id], expected_kind, expected_name);
    tc_flow_merge_yes();
    tc_flow_end();
  } else if k == N_WHILE then {
    tc_expr(node_a[id]); if tc_is_numeric_kind(tc_kind) == 0 && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(26);
    tc_flow_save_base();
    tc_loop_depth = tc_loop_depth + 1; tc_stmt(node_b[id], expected_kind, expected_name); tc_loop_depth = tc_loop_depth - 1;
    if node_value[id] != 0 then tc_stmt(node_value[id], expected_kind, expected_name);
    tc_flow_save_yes();
    tc_flow_restore_base();
    tc_flow_merge_yes();
    tc_flow_end();
  } else if k == N_FOR then {
    tc_enter_scope();
    if node_a[id] != 0 then tc_stmt(node_a[id], expected_kind, expected_name);
    tc_expr(node_b[id]); if tc_is_numeric_kind(tc_kind) == 0 && tc_kind != TY_PTR && tc_kind != TY_FUN then tc_fail(27);
    tc_flow_save_base();
    tc_loop_depth = tc_loop_depth + 1; tc_stmt(node_c[id], expected_kind, expected_name); tc_loop_depth = tc_loop_depth - 1;
    if node_value[id] != 0 then tc_stmt(node_value[id], expected_kind, expected_name);
    tc_flow_save_yes();
    tc_flow_restore_base();
    tc_flow_merge_yes();
    tc_flow_end();
    tc_leave_scope();
  }
}

func tc_diag_line(pos: int): int {
  let i: int = 0; let line: int = 1;
  while i < pos && i < source_len { if source[i] == 10 then line = line + 1; i = i + 1; }
  return line;
}
func tc_diag_col(pos: int): int {
  let i: int = 0; let col: int = 1;
  while i < pos && i < source_len { if source[i] == 10 then col = 1; else col = col + 1; i = i + 1; }
  return col;
}
func tc_diag_file(pos: int): int {
  if pos < 0 then return 0;
  if pos < source_len then return source_file_at[pos];
  if source_len > 0 then return source_file_at[source_len - 1];
  return source_active_file;
}
func tc_print_source_byte(value: int): void {
  if value == 9 then runtime_write_char('\t');
  else if value == 10 then runtime_write_char('\n');
  else if value == 13 then runtime_write_char('\r');
  else if value > 31 then {
    if value < 127 then runtime_write_char(tc_diag_ascii[value - 32]);
    else runtime_write_char('?');
  } else runtime_write_char('?');
}
func tc_print_source_file(file_id: int): void {
  if file_id < 1 then runtime_write_string("<unknown>");
  else if file_id > source_file_count - 1 then runtime_write_string("<unknown>");
  else {
    let i: int = 0;
    while i < source_file_name_len[file_id] {
      tc_print_source_byte(source_file_name_text[source_file_name_start[file_id] + i]);
      i = i + 1;
    }
  }
}
func tc_print_source_excerpt(pos: int): void {
  let begin: int = pos;
  let end: int = pos;
  if begin < 0 then begin = 0;
  if begin > source_len then begin = source_len;
  while begin > 0 && source[begin - 1] != 10 { begin = begin - 1; }
  while end < source_len && source[end] != 10 { end = end + 1; }
  let i: int = begin;
  while i < end {
    tc_print_source_byte(source[i]);
    i = i + 1;
  }
}
func tc_print_type_kind(kind: int): void {
  if kind == TY_INT then runtime_write_string("int");
  else if kind == TY_BOOL then runtime_write_string("bool");
  else if kind == TY_STRING then runtime_write_string("string");
  else if kind == TY_VOID then runtime_write_string("void");
  else if kind == TY_PTR then runtime_write_string("pointer");
  else if kind == TY_ARRAY then runtime_write_string("array");
  else if kind == TY_DYN_ARRAY then runtime_write_string("Array<T>");
  else if kind == TY_NAMED then runtime_write_string("named type");
  else if kind == TY_CHAR then runtime_write_string("char");
  else if kind == TY_FLOAT then runtime_write_string("f32");
  else if kind == TY_DOUBLE then runtime_write_string("f64");
  else if kind == TY_FUN then runtime_write_string("function");
  else if kind == TY_PARAM then runtime_write_string("type parameter");
  else if kind == TY_GENERIC then runtime_write_string("generic type");
  else if kind == TY_LONG then runtime_write_string("long");
  else if kind == TY_LLONG then runtime_write_string("long long");
  else if kind == TY_VARIANT then runtime_write_string("enum variant");
  else if kind == TY_U8 then runtime_write_string("u8");
  else if kind == TY_U16 then runtime_write_string("u16");
  else if kind == TY_U32 then runtime_write_string("u32");
  else if kind == TY_U64 then runtime_write_string("u64");
  else if kind == TY_I8 then runtime_write_string("i8");
  else if kind == TY_I16 then runtime_write_string("i16");
  else if kind == TY_I32 then runtime_write_string("i32");
  else if kind == TY_I64 then runtime_write_string("i64");
  else if kind == TY_USIZE then runtime_write_string("usize");
  else if kind == TY_TUPLE then runtime_write_string("tuple");
  else runtime_write_string("unknown type");
}
func tc_diag_has_types(code: int): int {
  if code == 12 then return 1;
  if code == 20 then return 1;
  if code == 21 then return 1;
  if code == 23 then return 1;
  if code == 36 then return 1;
  return 0;
}
func tc_print_hint(code: int): void {
  if code == 12 then runtime_write_string("check each argument against its parameter type");
  else if code == 20 then runtime_write_string("make the initializer expression match the declared type");
  else if code == 21 then runtime_write_string("make the right-hand side match the left-hand side type");
  else if code == 23 then runtime_write_string("return a value matching the function return type");
  else if code == 36 then runtime_write_string("use an element type matching the existing array");
  else if code == 55 then runtime_write_string("use only scalar, pointer, fixed-array, or named struct types in extern parameters");
  else if code == 56 then runtime_write_string("use only scalar, pointer, fixed-array, or named struct types in extern return type");
  else if code == 57 then runtime_write_string("header path must contain only alphanumeric characters, '.', '/', '_', '-'");
  else if code == 65 then runtime_write_string("use the default borrowed C parameter or borrow/borrow_mut with a pointer-compatible type");
  else if code == 66 then runtime_write_string("use borrow or borrow_mut only with string or pointer parameters");
  else if code == 67 then runtime_write_string("do not pass an extern-returned pointer or string to memory_free; call the matching C release API instead");
  else if code == 58 then runtime_write_string("move only an owned binding or an owned container result");
  else if code == 59 then runtime_write_string("pass a tracked variable or address expression to a borrow parameter");
  else if code == 60 then runtime_write_string("keep a borrowed capture within the source binding's lexical lifetime");
  else if code == 61 then runtime_write_string("closure moved-capture used after move");
  else if code == 31 then runtime_write_string("assign only to a mutable binding");
  else if code == 68 then runtime_write_string("borrow target must be a variable, dereference, index, or field place");
  else if code == 69 then runtime_write_string("return-borrow lifetime must come from one consistent parameter");
  else if code == 70 then runtime_write_string("mutable borrow requires a mutable place");
  else if code == 74 then runtime_write_string("default match arm must appear once and last");
  else if code == 75 then runtime_write_string("do not move an owned value from a loop-carried binding");
  else if code == 76 then runtime_write_string("explicit generic arguments must match a generic function's parameters");
  else if code == 77 then runtime_write_string("put defer inside a block-scoped statement body");
  else if code == 72 then runtime_write_string("reference return escapes its owner");
  else if code == 73 then runtime_write_string("function-pointer target is unknown for an ownership-sensitive signature");
  else runtime_write_string("inspect the expression at the reported source location");
}
func tc_diag(): void {
  if tc_error_code == 3 then runtime_write_string("type error: duplicate declaration");
  else if tc_error_code == 5 then runtime_write_string("type error: unknown name");
  else if tc_error_code == 12 then runtime_write_string("type error: invalid function arguments");
  else if tc_error_code == 13 then runtime_write_string("type error: invalid argument count");
  else if tc_error_code == 14 then runtime_write_string("type error: string concatenation requires strings");
  else if tc_error_code == 17 then runtime_write_string("type error: invalid built-in argument type");
  else if tc_error_code == 18 then runtime_write_string("type error: invalid arithmetic operands");
  else if tc_error_code == 20 then runtime_write_string("type error: initializer type mismatch");
  else if tc_error_code == 21 then runtime_write_string("type error: assignment type mismatch");
  else if tc_error_code == 23 then runtime_write_string("type error: return type mismatch");
  else if tc_error_code == 28 then runtime_write_string("type error: recursive struct definition");
  else if tc_error_code == 31 then runtime_write_string("type error: assignment to const");
  else if tc_error_code == 33 then runtime_write_string("type error: use after ownership move");
  else if tc_error_code == 34 then runtime_write_string("type error: use after ownership move");
  else if tc_error_code == 35 then runtime_write_string("type error: release requires an owned value");
  else if tc_error_code == 36 then runtime_write_string("type error: array element type mismatch");
  else if tc_error_code == 37 then runtime_write_string("type error: cannot mutate or move while borrowed");
  else if tc_error_code == 38 then runtime_write_string("type error: borrowed reference escapes its owner");
  else if tc_error_code == 40 then runtime_write_string("type error: owned value copy requires an explicit move");
  else if tc_error_code == 41 then runtime_write_string("type error: unknown function");
  else if tc_error_code == 42 then runtime_write_string("type error: cannot call non-function value");
  else if tc_error_code == 43 then runtime_write_string("type error: function name is reserved by the C runtime");
  else if tc_error_code == 45 then runtime_write_string("type error: array index out of bounds");
  else if tc_error_code == 46 then runtime_write_string("type error: defer expression must return void");
  else if tc_error_code == 47 then runtime_write_string("type error: match subject must be an enum");
  else if tc_error_code == 48 then runtime_write_string("type error: unknown variant in match arm");
  else if tc_error_code == 49 then runtime_write_string("type error: duplicate variant in match");
  else if tc_error_code == 50 then runtime_write_string("type error: match arm payload arity mismatch");
  else if tc_error_code == 51 then runtime_write_string("type error: match is not exhaustive");
  else if tc_error_code == 52 then runtime_write_string("type error: tuple destructuring requires tuple type");
  else if tc_error_code == 53 then runtime_write_string("type error: tuple binding count mismatch");
  else if tc_error_code == 54 then runtime_write_string("type error: integer literal is out of range for its target type");
  else if tc_error_code == 55 then runtime_write_string("type error: extern parameter type is not FFI-safe");
  else if tc_error_code == 56 then runtime_write_string("type error: extern return type is not FFI-safe");
  else if tc_error_code == 57 then runtime_write_string("type error: extern header path contains invalid characters");
  else if tc_error_code == 65 then runtime_write_string("type error: extern move ownership is unsupported");
  else if tc_error_code == 66 then runtime_write_string("type error: extern borrow mode requires a pointer-compatible type");
  else if tc_error_code == 67 then runtime_write_string("type error: cannot release a borrowed extern return");
  else if tc_error_code == 58 then runtime_write_string("type error: explicit move requires an owned value");
  else if tc_error_code == 59 then runtime_write_string("type error: borrow parameter requires a tracked source");
  else if tc_error_code == 60 then runtime_write_string("type error: closure capture escapes its source lifetime");
  else if tc_error_code == 61 then runtime_write_string("type error: closure moved-capture used after move");
  else if tc_error_code == 68 then runtime_write_string("type error: borrow target is not a place");
  else if tc_error_code == 69 then runtime_write_string("type error: inconsistent return-borrow lifetime");
  else if tc_error_code == 70 then runtime_write_string("type error: mutable borrow requires a mutable place");
  else if tc_error_code == 74 then runtime_write_string("type error: default match arm must appear once and last");
  else if tc_error_code == 75 then runtime_write_string("type error: owned value move is not allowed inside a loop");
  else if tc_error_code == 76 then runtime_write_string("type error: explicit generic arguments do not match the function parameters");
  else if tc_error_code == 77 then runtime_write_string("type error: defer must be inside a block-scoped statement body");
  else if tc_error_code == 72 then runtime_write_string("type error: reference return escapes its owner");
  else if tc_error_code == 73 then runtime_write_string("type error: function-pointer target is unknown for an ownership-sensitive signature");
  else if tc_error_code == 44 then runtime_write_string("type error: distinct functions collide after C mangling");
  else runtime_write_string("type error: invalid expression");
  runtime_write_char('\n');
  runtime_write_string("diagnostic.code=");
  runtime_write_int(tc_error_code);
  runtime_write_char('\n');
  runtime_write_string("diagnostic.file=");
  tc_print_source_file(tc_diag_file(tc_error_pos));
  runtime_write_char('\n');
  runtime_write_string("diagnostic.line=");
  runtime_write_int(tc_diag_line(tc_error_pos));
  runtime_write_char('\n');
  runtime_write_string("diagnostic.column=");
  runtime_write_int(tc_diag_col(tc_error_pos));
  runtime_write_char('\n');
  runtime_write_string("diagnostic.hint=");
  tc_print_hint(tc_error_code);
  runtime_write_char('\n');
  if tc_diag_has_types(tc_error_code) == 1 then {
    runtime_write_string("diagnostic.expected=");
    tc_print_type_kind(tc_error_expected_kind);
    runtime_write_char('\n');
    runtime_write_string("diagnostic.found=");
    tc_print_type_kind(tc_error_found_kind);
    runtime_write_char('\n');
  }
  runtime_write_string("diagnostic.excerpt=");
  tc_print_source_excerpt(tc_error_pos);
  runtime_write_char('\n');
}
func source_import_diag(): void {
  let code: int = 64;
  if source_import_error_kind == 1 then code = 62;
  else if source_import_error_kind == 2 then code = 63;
  if source_import_error_kind == 1 then runtime_write_string("import error: dependency cycle detected");
  else if source_import_error_kind == 2 then runtime_write_string("import error: module file could not be opened");
  else runtime_write_string("import error: malformed or invalid include directive");
  runtime_write_char('\n');
  runtime_write_string("diagnostic.code=");
  runtime_write_int(code);
  runtime_write_char('\n');
  runtime_write_string("diagnostic.file=");
  tc_print_source_file(source_import_error_file);
  runtime_write_char('\n');
  runtime_write_string("diagnostic.line=");
  runtime_write_int(source_import_error_line);
  runtime_write_char('\n');
  runtime_write_string("diagnostic.column=1\n");
  runtime_write_string("diagnostic.hint=");
  if source_import_error_kind == 1 then runtime_write_string("remove the import edge that closes the dependency cycle");
  else if source_import_error_kind == 2 then runtime_write_string("check the canonical path and ensure the module exists");
  else runtime_write_string("use include or includec followed by a quoted path and optional semicolon");
  runtime_write_char('\n');
  runtime_write_string("diagnostic.target=");
  tc_print_source_file(source_import_error_target);
  runtime_write_char('\n');
  runtime_write_string("diagnostic.excerpt=include directive\n");
}

func tc_check_function_symbols(root: int): int {
  let a: int = node_a[root];
  while a != 0 {
    if node_kind[a] == N_FUNC || node_kind[a] == N_GENERIC_FUNC || node_kind[a] == N_EXTERN then {
      let b: int = node_next[a];
      while b != 0 {
        if (node_kind[b] == N_FUNC || node_kind[b] == N_GENERIC_FUNC || node_kind[b] == N_EXTERN) && node_value[a] != node_value[b] then {
          let ca: int = sym_c_symbol(node_value[a]);
          let cb: int = sym_c_symbol(node_value[b]);
          if ca == cb then { tc_error_code = 44; tc_error_pos = node_pos[b]; tc_ok = 0; return 0; }
        }
        b = node_next[b];
      }
    }
    a = node_next[a];
  }
  return 1;
}
func tc_reserved_function(name: int): int {
  if bi_has_flag(name, BI_FLAG_RESERVED) == 1 then return 1;
  return 0;
}
func tc_ffi_struct_safe(name: int): int {
  let i: int = 0;
  while i < tc_path_count { if tc_path_name[i] == name then return 0; i = i + 1; }
  let decl: int = tc_find_struct(name);
  if decl == 0 || node_kind[decl] != N_STRUCT then return 0;
  ensure_tc_path(tc_path_count);
  tc_path_name[tc_path_count] = name;
  tc_path_count = tc_path_count + 1;
  let field: int = node_a[decl];
  let safe: int = 1;
  while field != 0 {
    if tc_check_ffi_type(node_b[field]) == 0 then safe = 0;
    field = node_next[field];
  }
  tc_path_count = tc_path_count - 1;
  return safe;
}

func tc_ffi_enum_safe(name: int): int {
  let decl: int = tc_find_enum(name);
  if decl == 0 then return 0;
  let member: int = node_a[decl];
  while member != 0 { if node_b[member] != 0 then return 0; member = node_next[member]; }
  return 1;
}

func tc_check_ffi_type(ty: int): int {
  if ty == 0 then return 0;
  let k: int = node_kind[ty];
  if k == TY_INT || k == TY_BOOL || k == TY_CHAR || k == TY_STRING then return 1;
  if k == TY_VOID || k == TY_FLOAT || k == TY_DOUBLE then return 1;
  if k == TY_LONG || k == TY_LLONG then return 1;
  if tc_is_fixed_integer_kind(k) == 1 then return 1;
  if k == TY_PTR then {
    if node_a[ty] == 0 then return 0;
    return tc_check_ffi_type(node_a[ty]);
  }
  if k == TY_ARRAY then {
    if node_a[ty] == 0 || node_value[ty] < 1 then return 0;
    return tc_check_ffi_type(node_a[ty]);
  }
  if k == TY_NAMED then {
    let resolved_struct: int = tc_find_struct_ctx(node_value[ty], node_scope[ty]);
    let resolved_enum: int = tc_find_enum_ctx(node_value[ty], node_scope[ty]);
    if resolved_struct != 0 then { node_value[ty] = node_value[resolved_struct]; return tc_ffi_struct_safe(node_value[ty]); }
    if resolved_enum != 0 then { node_value[ty] = node_value[resolved_enum]; return tc_ffi_enum_safe(node_value[ty]); }
    return 0;
  }
  return 0;
}

func tc_ffi_pointer_compatible(ty: int): int {
  if ty == 0 then return 0;
  if node_kind[ty] == TY_PTR || node_kind[ty] == TY_STRING then return 1;
  return 0;
}

func tc_check_ffi_return_type(ty: int): int {
  if ty == 0 || node_kind[ty] == TY_ARRAY then return 0;
  return tc_check_ffi_type(ty);
}
func tc_program(root: int): int {
  tc_root = root; tc_ok = 1; tc_error_code = 0; tc_error_pos = 0 - 1; tc_error_expected_kind = 0; tc_error_found_kind = 0; tc_var_count = 0; tc_scope_count = 0; tc_path_count = 0; tc_loop_depth = 0; tc_flow_depth = 0; tc_flow_log_count = 0;
  tc_prepare_return_contracts(root);
  let collision_item: int = node_a[root];
  while collision_item != 0 {
    if (node_kind[collision_item] == N_FUNC || node_kind[collision_item] == N_GENERIC_FUNC) && tc_reserved_function(node_value[collision_item]) == 1 then { tc_error_code = 43; tc_error_pos = node_pos[collision_item]; tc_ok = 0; tc_diag(); return 0; }
    collision_item = node_next[collision_item];
  }
  if tc_check_function_symbols(root) == 0 then { tc_diag(); return 0; }
  tc_enter_scope();
  let item: int = node_a[root];
  while item != 0 { if node_kind[item] == N_STRUCT then { let f: int = node_a[item]; while f != 0 { tc_check_type(node_b[f]); f = node_next[f]; } if tc_cycle_struct(node_value[item]) == 1 then tc_fail(28); } item = node_next[item]; }
  item = node_a[root];
  while item != 0 {
    if node_kind[item] == N_EXTERN then {
      let header_id: int = node_a[item];
      if header_id != 0 then {
        if ffi_header_valid(header_id) == 0 then {
          if tc_ok == 1 then { tc_error_pos = node_pos[item]; tc_fail(57); }
        }
      }
      let ffi_param: int = node_c[item];
      while ffi_param != 0 {
        let ffi_mode: int = node_aux[ffi_param];
        if ffi_mode == 1 then {
          if tc_ok == 1 then { tc_error_pos = node_pos[ffi_param]; tc_fail(65); }
        } else if (ffi_mode == 2 || ffi_mode == 3) && tc_ffi_pointer_compatible(node_b[ffi_param]) == 0 then {
          if tc_ok == 1 then { tc_error_pos = node_pos[ffi_param]; tc_fail(66); }
        }
        if tc_check_ffi_type(node_b[ffi_param]) == 0 then {
          if tc_ok == 1 then { tc_error_pos = node_pos[ffi_param]; tc_fail(55); }
        }
        ffi_param = node_next[ffi_param];
      }
      tc_path_count = 0;
      if tc_check_ffi_return_type(node_b[item]) == 0 then {
        if tc_ok == 1 then { tc_error_pos = node_pos[item]; tc_fail(56); }
      }
    }
    item = node_next[item];
  }
  if tc_ok == 0 then { tc_diag(); return 0; }
  item = node_a[root];
    while item != 0 { if node_kind[item] == N_GLOBAL || node_kind[item] == N_CONST then { tc_type_node(node_b[item]); let gk: int = tc_kind; let gn: int = tc_name; let ge: int = tc_elem_kind; let gen: int = tc_elem_name; tc_add_var(node_a[item], gk, gn, ge, gen, node_b[item]); if node_kind[item] == N_CONST then { sym_type[node_a[item]] = gk + 100; tc_var_const[tc_last_var_index] = 1; }     tc_mark_float_expr(node_c[item], gk); tc_expr(node_c[item]); let global_fun_target: int = tc_expr_fun_target; tc_var_fun_target[tc_last_var_index] = global_fun_target;     if tc_literal_fits(node_c[item], gk) == 0 then tc_fail(54);     if tc_same_full(gk, gn, ge, gen, tc_kind, tc_name, tc_elem_kind, tc_elem_name) == 0 && tc_integer_literal_conversion(node_c[item], gk, tc_kind) == 0 && (node_kind[node_c[item]] != N_INT || node_value[node_c[item]] != 0) && node_kind[node_c[item]] != N_NULL then tc_fail(29); } item = node_next[item]; }

    tc_global_count = tc_var_count;
  item = node_a[root];
    while item != 0 { if node_kind[item] == N_FUNC || node_kind[item] == N_GENERIC_FUNC then { tc_var_count = tc_global_count; tc_scope_count = 1; tc_enter_scope();     let p: int = node_c[item]; let param_pos: int = 1;
    while p != 0 { tc_type_node(node_b[p]); let pk: int = tc_kind; let pn: int = tc_name; let pek: int = tc_elem_kind; let pen: int = tc_elem_name; tc_add_var(node_a[p], pk, pn, pek, pen, node_b[p]); tc_var_param[tc_last_var_index] = 1; tc_var_param_pos[tc_last_var_index] = param_pos; tc_var_mode[tc_last_var_index] = node_aux[p]; if node_aux[p] == 2 || node_aux[p] == 3 then { tc_var_borrow_source[tc_last_var_index] = tc_last_var_index; tc_var_borrow_mode[tc_last_var_index] = node_aux[p]; tc_var_borrow_param[tc_last_var_index] = param_pos; } if node_aux[p] == 1 then tc_var_owned[tc_last_var_index] = 1; else if node_aux[p] == 3 then tc_var_borrow_mut[tc_last_var_index] = 1; else if tc_is_owner_kind(pk) == 1 then tc_var_owned[tc_last_var_index] = 1; param_pos = param_pos + 1; p = node_next[p]; } tc_type_node(node_b[item]);
 tc_expected_elem_kind = tc_elem_kind; tc_expected_elem_name = tc_elem_name; tc_stmt(node_a[item], tc_kind, tc_name); tc_leave_scope(); } item = node_next[item]; }

  if tc_ok == 0 then { tc_diag(); return 0; }
  return 1;
}

func pipeline_main(path: string): int {
  load_tokens_from_file(path);
  node_count = 1;
    ast_parse_mode = 1;
    let root: int = ast_program();
    ast_parse_mode = 0;
  pipeline_root = root;
  let parsed: int = 1;
  if lexer_error == 1 then parsed = 0;
  if root < 0 then parsed = 0;
  if input_peek() != T_EOF then parsed = 0;
  if include_ok == 0 then parsed = 0;
  if parsed == 1 then {
    if tc_program(root) == 0 then parsed = 0;
  }
  if parsed == 1 then {
    code_reset();
    gen_program(root);
    code_reset();
    gen_program(root);
    let stable_count: int = code_count;
    code_reset();
    gen_program(root);
    if code_count != stable_count then parsed = 0;
  }
  if parsed == 0 then {
    if source_import_error_kind != 0 then source_import_diag();
    else if tc_error_code == 0 then {
      runtime_write_string("parse error\n");
      runtime_write_string("diagnostic.code=0\n");
      runtime_write_string("diagnostic.file=");
      tc_print_source_file(tc_diag_file(source_pos));
      runtime_write_char('\n');
      runtime_write_string("diagnostic.line=");
      runtime_write_int(tc_diag_line(source_pos));
      runtime_write_char('\n');
      runtime_write_string("diagnostic.column=");
      runtime_write_int(tc_diag_col(source_pos));
      runtime_write_char('\n');
      runtime_write_string("diagnostic.hint=check the syntax near the reported source location\n");
      runtime_write_string("diagnostic.excerpt=");
      tc_print_source_excerpt(source_pos);
      runtime_write_char('\n');
    }
  }
  if parsed == 1 then { return 0; }
  return 1;
}

func emit_symbol(out: int*, id: int): void {
  let i: int = 0;
  while i < sym_len[id] {
    write_char(out, source[sym_start[id] + i]);
    i = i + 1;
  }
}

func emit_string(out: int*, id: int): void {
  write_char(out, 34);
  emit_symbol(out, id);
  write_char(out, 34);
}

func emit_identifier(out: int*, id: int): void {
  let is_stdout: int = 0;
  let is_stderr: int = 0;
  if sym_len[id] == 6 then {
    if source[sym_start[id]] == 115 && source[sym_start[id] + 1] == 116 && source[sym_start[id] + 2] == 100 && source[sym_start[id] + 3] == 111 && source[sym_start[id] + 4] == 117 && source[sym_start[id] + 5] == 116 then is_stdout = 1;
    if source[sym_start[id]] == 115 && source[sym_start[id] + 1] == 116 && source[sym_start[id] + 2] == 100 && source[sym_start[id] + 3] == 101 && source[sym_start[id] + 4] == 114 && source[sym_start[id] + 5] == 114 then is_stderr = 1;
  }
  emit_symbol(out, id);
  if is_stdout == 1 || is_stderr == 1 then write_char(out, 95);
}

func emit_print_prefix(out: int*): void {
  write_string(out, "(");
  write_char(out, 34);
  write_string(out, "%d");
  write_char(out, 92);
  write_char(out, 110);
  write_char(out, 34);
  write_string(out, ", ");
}

func emit_int_text(out: int*, value: int): void {
  if value < 0 then {
    write_char(out, 45);
    emit_int_text(out, 0 - value);
  } else if value < 10 then {
    write_char(out, 48 + value);
  } else {
    emit_int_text(out, value / 10);
    write_char(out, 48 + (value - (value / 10) * 10));
  }
}

func emit_source_filename(out: int*, file_id: int): void {
  let i: int = 0;
  while i < source_file_name_len[file_id] {
    let c: int = source_file_name_text[source_file_name_start[file_id] + i];
    if c == 34 || c == 92 then { write_char(out, 92); write_char(out, c); }
    else if c == 10 then { write_char(out, 92); write_char(out, 110); }
    else if c == 13 then { write_char(out, 92); write_char(out, 114); }
    else if c == 9 then { write_char(out, 92); write_char(out, 116); }
    else write_char(out, c);
    i = i + 1;
  }
}

func emit_source_line(out: int*, pos: int): void {
  if pos < 0 || pos > source_len - 1 then return;
  let file_id: int = source_file_at[pos];
  if file_id < 1 || file_id > source_file_count - 1 then return;
  write_char(out, 10);
  write_string(out, "#line ");
  emit_int_text(out, source_line_at[pos]);
  write_string(out, " \"");
  emit_source_filename(out, file_id);
  write_string(out, "\"\n");
}

func emit_c_token(out: int*, kind: int, value: int): void {
  if emit_pending_space == 1 then {
    if kind == C_KW || kind == C_IDENT || kind == C_INT || kind == C_STRING || kind == C_RAW || kind == C_RAW_U64 then write_char(out, 32);
    emit_pending_space = 0;
  }
  if kind == C_KW then {
    if value == 1 then { write_string(out, "int"); emit_pending_space = 1; }
    else if value == 2 then { write_string(out, "int"); emit_pending_space = 1; }
    else if value == 3 then { write_string(out, "char*"); emit_pending_space = 1; }
    else if value == 4 then { write_string(out, "void"); emit_pending_space = 1; }
    else if value == 5 then { write_string(out, "return"); emit_pending_space = 1; }
    else if value == 6 then { write_string(out, "if"); emit_pending_space = 1; }
    else if value == 7 then { write_string(out, "else"); emit_pending_space = 1; }
    else if value == 8 then { write_string(out, "while"); emit_pending_space = 1; }
    else if value == 9 then { write_string(out, "break"); emit_pending_space = 1; }
    else if value == 10 then { write_string(out, "continue"); emit_pending_space = 1; }
    else if value == 11 then { write_string(out, "for"); emit_pending_space = 1; }
    else if value == 12 then { write_string(out, "struct"); emit_pending_space = 1; }
    else if value == 13 then { write_string(out, "enum"); emit_pending_space = 1; }
    else if value == 14 then { write_string(out, "typedef"); emit_pending_space = 1; }
    else if value == 15 then { write_string(out, "double"); emit_pending_space = 1; }
    else if value == 16 then { write_string(out, "const"); emit_pending_space = 1; }
    else if value == 18 then { write_string(out, "float"); emit_pending_space = 1; }
    else if value == 19 then { write_string(out, "long"); emit_pending_space = 1; }
    else if value == 20 then { write_string(out, "long long"); emit_pending_space = 1; }
    else if value == 21 then { write_string(out, "uint8_t"); emit_pending_space = 1; }
    else if value == 22 then { write_string(out, "uint16_t"); emit_pending_space = 1; }
    else if value == 23 then { write_string(out, "uint32_t"); emit_pending_space = 1; }
    else if value == 24 then { write_string(out, "uint64_t"); emit_pending_space = 1; }
    else if value == 25 then { write_string(out, "int8_t"); emit_pending_space = 1; }
    else if value == 26 then { write_string(out, "int16_t"); emit_pending_space = 1; }
    else if value == 27 then { write_string(out, "int32_t"); emit_pending_space = 1; }
    else if value == 28 then { write_string(out, "int64_t"); emit_pending_space = 1; }
    else if value == 29 then { write_string(out, "size_t"); emit_pending_space = 1; }
    else if value == 30 then { write_string(out, "union"); emit_pending_space = 1; }
    else if value == 17 then { write_string(out, "char"); emit_pending_space = 1; }
  } else if kind == C_IDENT then {
    if value == -1001 then write_string(out, "printf");
    else if value == -1002 then write_string(out, "runtime_string_concat");
    else if value == -1011 then write_string(out, "sizeof");
    else if value == -1012 then write_string(out, "len");
    else if value == -1013 then write_string(out, "cap");
    else if value == -1015 then write_string(out, "data");
    else if value == -1016 then write_string(out, "basalt_memory_alloc");
    else if value == -1017 then write_string(out, "basalt_memory_resize");
    else if value == -1018 then write_string(out, "basalt_memory_free");
    else if value == -1019 then write_string(out, "basalt_memory_alloc_aligned");
    else if value == -1020 then write_string(out, "_Alignas");
    else if value == -1021 then write_string(out, "f");
    else emit_identifier(out, value);
  } else if kind == C_INT then emit_int_text(out, value);
  else if kind == C_RAW then emit_symbol(out, value);
  else if kind == C_RAW_U64 then { emit_symbol(out, value); write_string(out, "ULL"); }
  else if kind == C_STRING then emit_string(out, value);
  else if kind == C_OP then {
    if value == 1 then write_string(out, "+");
    else if value == 2 then write_string(out, "-");
    else if value == 3 then write_string(out, "*");
    else if value == 4 then write_string(out, "/");
    else if value == 5 then write_string(out, "==");
    else if value == 6 then write_string(out, "!=");
    else if value == 7 then write_string(out, "<");
    else if value == 8 then write_string(out, ">");
    else if value == 9 then write_string(out, "&&");
    else if value == 10 then write_string(out, "||");
    else if value == 11 then write_string(out, "++");
    else if value == 12 then write_string(out, "&");
    else if value == 13 then write_string(out, "|");
    else if value == 14 then write_string(out, "^");
    else if value == 15 then write_string(out, "<<");
    else if value == 16 then write_string(out, ">>");
    else     if value == 17 then write_string(out, "%");
    else if value == 18 then write_string(out, ":");
    else if value == 19 then write_string(out, "+=");
    else if value == 20 then write_string(out, "-=");
    else if value == 21 then write_string(out, "*=");
    else if value == 22 then write_string(out, "/=");
    else if value == 23 then write_string(out, "%=");
    else if value == 24 then write_string(out, "&=");
    else if value == 25 then write_string(out, "|=");
    else if value == 26 then write_string(out, "^=");
    else if value == 27 then write_string(out, "<<=");
    else if value == 28 then write_string(out, ">>=");
    else if value == 29 then write_string(out, "!");
    else if value == 30 then write_string(out, "<=");
    else if value == 31 then write_string(out, ">=");

  } else if kind == C_PUNCT then {
    if value == 1 then write_string(out, "*");
    else if value == 2 then write_string(out, "[");
    else if value == 3 then write_string(out, "]");
    else if value == 4 then write_string(out, "(");
    else if value == 5 then write_string(out, ")");
    else if value == 6 then write_string(out, "(");
    else if value == 7 then write_string(out, ", ");
    else if value == 8 then write_string(out, ")");
    else if value == 9 then write_string(out, "*");
    else if value == 10 then write_string(out, "&");
    else if value == 11 then write_string(out, " = ");
    else if value == 12 then write_string(out, ";");
    else if value == 13 then write_string(out, "{\n");
    else if value == 14 then write_string(out, "}\n");
    else if value == 15 then emit_print_prefix(out);
    else if value == 16 then {
      write_char(out, 40);
      write_char(out, 34);
      write_string(out, "%s");
      write_char(out, 92);
      write_char(out, 110);
      write_char(out, 34);
      write_string(out, ", ");
    } else if value == 17 then write_string(out, ".");
    else if value == 20 then { write_char(out, 40); write_char(out, 34); write_string(out, "%c"); write_char(out, 92); write_char(out, 110); write_char(out, 34); write_string(out, ", "); }
    else if value == 21 then { write_char(out, 40); write_char(out, 34); write_string(out, "%g"); write_char(out, 92); write_char(out, 110); write_char(out, 34); write_string(out, ", "); }
    else if value == 26 then { write_char(out, 40); write_char(out, 34); write_string(out, "%p"); write_char(out, 92); write_char(out, 110); write_char(out, 34); write_string(out, ", "); }
    else if value == 18 then write_string(out, " ");
    else if value == 19 then write_string(out, "{0}");
    else if value == 22 then write_char(out, 32);
    else if value == 23 then { write_char(out, 40); write_char(out, 34); write_string(out, "%d"); write_char(out, 92); write_char(out, 110); write_char(out, 34); write_string(out, ", "); }
    else if value == 24 then write_string(out, "{");
    else if value == 25 then write_string(out, "}");
    else if value == 27 then write_string(out, "->");
    else if value == 28 then { write_char(out, 40); write_char(out, 34); write_string(out, "%ld"); write_char(out, 92); write_char(out, 110); write_char(out, 34); write_string(out, ", "); }
    else if value == 29 then { write_char(out, 40); write_char(out, 34); write_string(out, "%lld"); write_char(out, 92); write_char(out, 110); write_char(out, 34); write_string(out, ", "); }
    else if value == 32 then { write_char(out, 40); write_char(out, 34); write_string(out, "%s"); write_char(out, 34); write_string(out, ", "); }
    else if value == 33 then { write_char(out, 40); write_char(out, 34); write_string(out, "%c"); write_char(out, 34); write_string(out, ", "); }
    else if value == 34 then { write_char(out, 40); write_char(out, 34); write_string(out, "%g"); write_char(out, 34); write_string(out, ", "); }
    else if value == 35 then { write_char(out, 40); write_char(out, 34); write_string(out, "%ld"); write_char(out, 34); write_string(out, ", "); }
    else if value == 36 then { write_char(out, 40); write_char(out, 34); write_string(out, "%lld"); write_char(out, 34); write_string(out, ", "); }
    else if value == 37 then { write_char(out, 40); write_char(out, 34); write_string(out, "%p"); write_char(out, 34); write_string(out, ", "); }
    else if value == 38 then { write_char(out, 40); write_char(out, 34); write_string(out, "%d"); write_char(out, 34); write_string(out, ", "); }
  } else if kind == C_NEWLINE then write_char(out, 10);
}

func emit_runtime(out: int*): void {
  write_string(out, "#if defined(_WIN32)\n#include <direct.h>\n#else\n#define _POSIX_C_SOURCE 200809L\n#define _XOPEN_SOURCE 700\n#endif\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n#include <stdint.h>\n#include <stddef.h>\n#include <limits.h>\n#include <errno.h>\n#include <stdatomic.h>\n#if defined(_WIN32)\n#include <windows.h>\n#include <process.h>\n#else\n#include <unistd.h>\n#include <fcntl.h>\n#include <poll.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n#endif\n#if defined(_WIN32) && defined(__MINGW32__) && !defined(BASALT_USE_NATIVE_C11_THREADS)\n#include <pthread.h>\n#include <sched.h>\ntypedef pthread_t thrd_t;\ntypedef int (*basalt_thrd_start_t)(void*);\ntypedef struct basalt_thrd_start_context { basalt_thrd_start_t entry; void* argument; int result; } basalt_thrd_start_context;\nstatic void* basalt_thrd_start(void* raw){basalt_thrd_start_context* context=(basalt_thrd_start_context*)raw;context->result=context->entry(context->argument);return raw;}\nstatic int basalt_thrd_create(thrd_t* thread,basalt_thrd_start_t entry,void* argument){basalt_thrd_start_context* context;int status;context=(basalt_thrd_start_context*)malloc(sizeof(*context));if(!context)return 1;context->entry=entry;context->argument=argument;context->result=0;status=pthread_create(thread,NULL,basalt_thrd_start,context);if(status!=0)free(context);return status;}\nstatic int basalt_thrd_join(thrd_t thread,int* result){void* raw=NULL;int status=pthread_join(thread,&raw);if(status==0){basalt_thrd_start_context* context=(basalt_thrd_start_context*)raw;if(result)*result=context->result;free(context);}return status;}\n#define thrd_success 0\n#define thrd_create(thread,entry,argument) basalt_thrd_create((thread),(entry),(argument))\n#define thrd_join(thread,result) basalt_thrd_join((thread),(result))\n#define thrd_yield() sched_yield()\n#else\n#include <threads.h>\n#endif\n#if defined(_WIN32) && defined(__MINGW32__)\n#ifndef BASALT_ALIGNED_ALLOC_DECLARED\n#define BASALT_ALIGNED_ALLOC_DECLARED 1\nvoid *aligned_alloc(size_t alignment,size_t size);\n#endif\n#endif\n#if defined(__GNUC__) || defined(__clang__)\n#define BASALT_UNUSED __attribute__((unused))\n#else\n#define BASALT_UNUSED\n#endif\nstatic void basalt_panic(int code){(void)code;exit(2);}\nstatic size_t basalt_checked_bytes(int count,size_t elem_size){if(count<0)basalt_panic(1);if(elem_size!=0&&(size_t)count>(size_t)-1/elem_size)basalt_panic(1);return(size_t)count*elem_size;}\nstatic void* basalt_track(void*);static void basalt_release(void*);\n");
  write_string(out, "typedef struct basalt_atomic_int { atomic_int value; } basalt_atomic_int;\nstatic BASALT_UNUSED void* basalt_atomic_make(int initial){basalt_atomic_int*a=(basalt_atomic_int*)calloc(1,sizeof(*a));if(!a)basalt_panic(5);atomic_init(&a->value,initial);return basalt_track(a);}\nstatic BASALT_UNUSED int basalt_atomic_load(void*p){basalt_atomic_int*a=(basalt_atomic_int*)p;if(!a)basalt_panic(4);return atomic_load_explicit(&a->value,memory_order_acquire);}\nstatic BASALT_UNUSED void basalt_atomic_store(void*p,int value){basalt_atomic_int*a=(basalt_atomic_int*)p;if(!a)basalt_panic(4);atomic_store_explicit(&a->value,value,memory_order_release);}\nstatic BASALT_UNUSED int basalt_atomic_fetch_add(void*p,int delta){basalt_atomic_int*a=(basalt_atomic_int*)p;if(!a)basalt_panic(4);return atomic_fetch_add_explicit(&a->value,delta,memory_order_acq_rel);}\nstatic BASALT_UNUSED int basalt_atomic_compare_exchange(void*p,int expected,int desired){basalt_atomic_int*a=(basalt_atomic_int*)p;int old;if(!a)basalt_panic(4);old=expected;return atomic_compare_exchange_strong_explicit(&a->value,&old,desired,memory_order_acq_rel,memory_order_acquire);}\nstatic BASALT_UNUSED void basalt_atomic_free(void*p){basalt_release(p);}\ntypedef struct basalt_channel { _Atomic size_t head; _Atomic size_t tail; atomic_int closed; size_t capacity; int data[]; } basalt_channel;\nstatic BASALT_UNUSED void* basalt_channel_make(int requested){size_t cap=2;size_t bytes;basalt_channel*c;if(requested<1||requested>1073741824)basalt_panic(7);while(cap<(size_t)requested){if(cap>(size_t)-1/2)basalt_panic(1);cap*=2;}if(cap>(size_t)-1/sizeof(int))basalt_panic(1);bytes=sizeof(*c)+cap*sizeof(int);if(bytes<sizeof(*c))basalt_panic(1);c=(basalt_channel*)calloc(1,bytes);if(!c)basalt_panic(5);c->capacity=cap;atomic_init(&c->head,0);atomic_init(&c->tail,0);atomic_init(&c->closed,0);return basalt_track(c);}\nstatic BASALT_UNUSED int basalt_channel_send(void*p,int value){basalt_channel*c=(basalt_channel*)p;size_t head,tail;if(!c)basalt_panic(4);if(atomic_load_explicit(&c->closed,memory_order_acquire)!=0)return -1;head=atomic_load_explicit(&c->head,memory_order_relaxed);tail=atomic_load_explicit(&c->tail,memory_order_acquire);if(head-tail>=c->capacity)return 0;c->data[head&(c->capacity-1)]=value;atomic_store_explicit(&c->head,head+1,memory_order_release);return 1;}\nstatic BASALT_UNUSED int basalt_channel_recv(void*p,int*out){basalt_channel*c=(basalt_channel*)p;size_t head,tail;if(!c||!out)basalt_panic(4);tail=atomic_load_explicit(&c->tail,memory_order_relaxed);head=atomic_load_explicit(&c->head,memory_order_acquire);if(tail==head){if(atomic_load_explicit(&c->closed,memory_order_acquire)!=0)return -1;return 0;}*out=c->data[tail&(c->capacity-1)];atomic_store_explicit(&c->tail,tail+1,memory_order_release);return 1;}\nstatic BASALT_UNUSED void basalt_channel_close(void*p){basalt_channel*c=(basalt_channel*)p;if(!c)basalt_panic(4);atomic_store_explicit(&c->closed,1,memory_order_release);}\nstatic BASALT_UNUSED void basalt_channel_free(void*p){basalt_release(p);}\ntypedef struct basalt_thread_handle { thrd_t thread; } basalt_thread_handle;\nstatic BASALT_UNUSED void* basalt_thread_spawn(int(*entry)(void*),void*arg){basalt_thread_handle*h=(basalt_thread_handle*)calloc(1,sizeof(*h));if(!h)basalt_panic(5);if(thrd_create(&h->thread,entry,arg)!=thrd_success){free(h);return NULL;}return basalt_track(h);}\nstatic BASALT_UNUSED int basalt_thread_join(void*p){basalt_thread_handle*h=(basalt_thread_handle*)p;int result;if(!h)basalt_panic(4);if(thrd_join(h->thread,&result)!=thrd_success)basalt_panic(8);basalt_release(h);return result;}\nstatic BASALT_UNUSED void basalt_thread_yield(void){thrd_yield();}\n");
  write_string(out, "static char** basalt_inc_active=NULL;static size_t basalt_inc_active_n=0,basalt_inc_active_cap=0;static char** basalt_inc_loaded=NULL;static size_t basalt_inc_loaded_n=0,basalt_inc_loaded_cap=0;static char* basalt_inc_last_path=NULL;static char* basalt_inc_project_root=NULL;static int basalt_inc_status=0;\n");
  write_string(out, "static BASALT_UNUSED int basalt_inc_eq(const char*a,const char*b){return strcmp(a,b)==0;}\n");
  write_string(out, "static BASALT_UNUSED size_t basalt_inc_find(char**v,size_t n,const char*p){size_t i;for(i=0;i<n;i++)if(basalt_inc_eq(v[i],p))return i;return (size_t)-1;}\n");
  write_string(out, "static BASALT_UNUSED void basalt_inc_add(char***vp,size_t*np,size_t*cp,char*p){size_t c;char**q;if(*np==*cp){c=*cp?*cp*2:16;q=(char**)realloc(*vp,c*sizeof(char*));if(!q)exit(2);*vp=q;*cp=c;}(*vp)[(*np)++]=p;}\n");
  write_string(out, "static BASALT_UNUSED char* basalt_inc_strdup(const char*p){size_t n=strlen(p);char*q=(char*)malloc(n+1);if(!q)exit(2);memcpy(q,p,n+1);return(char*)basalt_track(q);}\n");
