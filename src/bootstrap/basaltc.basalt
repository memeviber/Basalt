let source: int* = 0;
let source_len: int = 0;
let source_pos: int = 0;
let c_source: int* = 0;
let c_source_len: int = 0;
let include_ok: int = 1;
// Initial capacity only; include directive lines grow dynamically and have no 4096-byte ceiling.
let include_line_initial_cap: int = 256;

func c_source_reset(): void { c_source_len = 0; }
func ensure_c_source(need: int): void {
  if need < c_source_cap then return;
  let n: int = next_capacity(c_source_cap, need);
  c_source = grow_ints(c_source, c_source_cap, n);
  c_source_cap = n;
}
func c_source_put(c: int): void {
  ensure_c_source(c_source_len);
  c_source[c_source_len] = c;
  c_source_len = c_source_len + 1;
}

func ensure_source_file_names(need: int): void {
  if need < source_file_cap then return;
  let n: int = next_capacity(source_file_cap, need);
  source_file_name_start = grow_ints(source_file_name_start, source_file_cap, n);
  source_file_name_len = grow_ints(source_file_name_len, source_file_cap, n);
  source_file_cap = n;
}

func ensure_source_file_text(need: int): void {
  if need < source_file_name_text_cap then return;
  let n: int = next_capacity(source_file_name_text_cap, need);
  source_file_name_text = grow_ints(source_file_name_text, source_file_name_text_cap, n);
  source_file_name_text_cap = n;
}

func source_path_length(path: string): int {
  let n: int = 0;
  while path[n] != '\0' { n = n + 1; }
  return n;
}

func source_file_intern(path: string): int {
  let length: int = source_path_length(path);
  let id: int = 1;
  while id < source_file_count {
    if source_file_name_len[id] == length then {
      let i: int = 0;
      let same: int = 1;
      while i < length { if source_file_name_text[source_file_name_start[id] + i] != path[i] then same = 0; i = i + 1; }
      if same == 1 then return id;
    }
    id = id + 1;
  }
  id = source_file_count;
  ensure_source_file_names(id);
  ensure_source_file_text(source_file_name_text_len + length);
  source_file_name_start[id] = source_file_name_text_len;
  source_file_name_len[id] = length;
  let j: int = 0;
  while j < length { source_file_name_text[source_file_name_text_len + j] = path[j]; j = j + 1; }
  source_file_name_text_len = source_file_name_text_len + length;
  source_file_count = source_file_count + 1;
  return id;
}

func ensure_source_deps(need: int): void {
  if need < source_dep_cap then return;
  let n: int = next_capacity(source_dep_cap, need);
  source_dep_from = grow_ints(source_dep_from, source_dep_cap, n);
  source_dep_to = grow_ints(source_dep_to, source_dep_cap, n);
  source_dep_cap = n;
}

func source_dep_add(from_id: int, to_id: int): void {
  if from_id < 1 || to_id < 1 then return;
  let i: int = 0;
  while i < source_dep_count {
    if source_dep_from[i] == from_id && source_dep_to[i] == to_id then return;
    i = i + 1;
  }
  ensure_source_deps(source_dep_count);
  source_dep_from[source_dep_count] = from_id;
  source_dep_to[source_dep_count] = to_id;
  source_dep_count = source_dep_count + 1;
}

func source_dep_reaches(current: int, target: int): int {
  let capacity: int = source_file_count + 1;
  let work: int* = alloc_ints(capacity);
  let seen: int* = alloc_ints(capacity);
  let work_count: int = 1;
  let found: int = 0;
  work[0] = current;
  if current >= 0 && current < capacity then seen[current] = 1;
  while work_count > 0 && found == 0 {
    work_count = work_count - 1;
    let item: int = work[work_count];
    if item == target then found = 1;
    else {
      let i: int = 0;
      while i < source_dep_count {
        if source_dep_from[i] == item then {
          let next: int = source_dep_to[i];
          if next >= 0 && next < capacity && seen[next] == 0 then {
            seen[next] = 1;
            work[work_count] = next;
            work_count = work_count + 1;
          }
        }
        i = i + 1;
      }
    }
  }
  free_ints(work);
  free_ints(seen);
  return found;
}

func source_import_fail(kind: int, file_id: int, target_id: int, line: int): void {
  if include_ok == 0 then return;
  include_ok = 0;
  source_import_error_kind = kind;
  source_import_error_file = file_id;
  source_import_error_target = target_id;
  source_import_error_line = line;
}

func source_reset(): void {
  source_len = 0;
  source_pos = 0;
  source_file_count = 1;
  source_file_name_text_len = 0;
  source_active_file = 0;
  source_active_line = 1;
  source_dep_count = 0;
  source_import_error_kind = 0;
  source_import_error_file = 0;
  source_import_error_target = 0;
  source_import_error_line = 1;
}

func source_put(c: int): void {
  ensure_source(source_len);
  source[source_len] = c;
  source_file_at[source_len] = source_active_file;
  source_line_at[source_len] = source_active_line;
  source_len = source_len + 1;
  if c == 10 then source_active_line = source_active_line + 1;
}

func is_space(c: int): int {
  if c == 32 then return 1;
  if c == 9 then return 1;
  if c == 10 then return 1;
  if c == 13 then return 1;
  return 0;
}

func is_digit(c: int): int {
  if c < 48 then return 0;
  if c > 57 then return 0;
  return 1;
}

func hex_digit_value(c: int): int {
  if c >= 48 && c <= 57 then return c - 48;
  if c >= 65 && c <= 70 then return c - 55;
  if c >= 97 && c <= 102 then return c - 87;
  return -1;
}

func is_hex_digit(c: int): int {
  if hex_digit_value(c) >= 0 then return 1;
  return 0;
}

func is_binary_digit(c: int): int {
  if c == 48 || c == 49 then return 1;
  return 0;
}

func is_alpha(c: int): int {
  if c > 64 then {
    if c < 91 then return 1;
  }
  if c > 96 then {
    if c < 123 then return 1;
  }
  if c == 95 then return 1;
  return 0;
}

func is_alnum(c: int): int {
  if is_alpha(c) == 1 then return 1;
  return is_digit(c);
}

func source_peek(): int {
  if source_pos < source_len then return source[source_pos];
  return 0;
}

func source_take(): int {
  let c: int = source_peek();
  if source_pos < source_len then source_pos = source_pos + 1;
  current_source_pos = source_pos;
  return c;
}

let sym_start: int* = 0;
let sym_len: int* = 0;
let sym_hash: int* = 0;
let sym_kind: int* = 0;
let sym_type: int* = 0;
let sym_elem_kind: int* = 0;
let sym_elem_name: int* = 0;
let sym_scope: int* = 0;
let sym_count: int = 1;
let sym_text_len: int = 0;
let BI_TC_NONE: int = 0;
let BI_TC_VOID: int = 1;
let BI_TC_INT: int = 2;
let BI_TC_STRING: int = 3;
