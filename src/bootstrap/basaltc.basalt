let BI_TC_SYS_COMPILE: int = 34;
let BI_TC_SYS_STRING: int = 32;
let BI_TC_SYS_INT: int = 33;
let BI_TC_MEM_RESIZE: int = 7;
let BI_TC_MEM_FREE: int = 8;
