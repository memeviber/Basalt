func gen_function_signature_parts(ret_ty: int, name: int, params: int, is_extern: int): void {
  let ret: int = gen_substitute_type(ret_ty);
  if ret != 0 && node_kind[ret] == TY_FUN then {
    let inner_ret: int = gen_substitute_type(node_b[ret]);
    gen_type(node_kind[inner_ret], inner_ret, node_value[inner_ret]);
    code_emit(C_PUNCT, 4); code_emit(C_PUNCT, 9); code_emit(C_IDENT, name);
    code_emit(C_PUNCT, 6); gen_function_params(params, is_extern); code_emit(C_PUNCT, 8); code_emit(C_PUNCT, 5);
    code_emit(C_PUNCT, 6); gen_function_type_params(node_a[ret]); code_emit(C_PUNCT, 8);
  } else {
    gen_type(node_kind[ret], ret, node_value[ret]);
    code_emit(C_IDENT, name); code_emit(C_PUNCT, 6); gen_function_params(params, is_extern); code_emit(C_PUNCT, 8);
