func word_code(start: int, length: int): int {
  let h: int = span_hash(start, length);
  if length == 2 then {
    if h == 10084 then return L_IF;
    if h == 9999 then return L_FN;
    if source[start] == 117 && source[start + 1] == 56 then return L_TU8;
    if source[start] == 105 && source[start + 1] == 56 then return L_TI8;
  }
  if length == 3 then {
    if source[start] == 109 && source[start + 1] == 117 && source[start + 2] == 116 then return L_MUT;
    if h == 315572 then return L_LET;
    if h == 312968 then return L_TINT;
    if h == 310114 then return L_FOR;
    if source[start] == 117 && source[start + 1] == 49 && source[start + 2] == 54 then return L_TU16;
    if source[start] == 102 && source[start + 1] == 51 && source[start + 2] == 50 then return L_TFLOAT;
    if source[start] == 102 && source[start + 1] == 54 && source[start + 2] == 52 then return L_TDOUBLE;
    if source[start] == 117 && source[start + 1] == 51 && source[start + 2] == 50 then return L_TU32;
    if source[start] == 117 && source[start + 1] == 54 && source[start + 2] == 52 then return L_TU64;
    if source[start] == 105 && source[start + 1] == 49 && source[start + 2] == 54 then return L_TI16;
    if source[start] == 105 && source[start + 1] == 51 && source[start + 2] == 50 then return L_TI32;
    if source[start] == 105 && source[start + 1] == 54 && source[start + 2] == 52 then return L_TI64;
  }
  if length == 4 then {
    if h == 619275 then return L_FUNC;
    if h == 580992 then return L_ELSE;
    if h == 582984 then return L_ENUM;
    if h == 33685 then return L_TRUE;
    if h == 494385 then return L_TBOOL;
    if h == 90011 then return L_TVOID;
    if h == 23588 then return L_THEN;
    if source[start] == 109 && source[start + 1] == 111 && source[start + 2] == 118 && source[start + 3] == 101 then return L_MOVE;
  }
  if length == 5 then {
    if h == 339014 then return L_PRINT;
    if h == 505674 then return L_WHILE;
    if h == 600380 then return L_FALSE;
    if h == 405464 then return L_BREAK;
    if source[start] == 100 && source[start + 1] == 101 && source[start + 2] == 102 && source[start + 3] == 101 && source[start + 4] == 114 then return L_DEFER;
    if source[start] == 109 && source[start + 1] == 97 && source[start + 2] == 116 && source[start + 3] == 99 && source[start + 4] == 104 then return L_MATCH;
  }
  if length == 7 then {
    if source[start] == 112 && source[start + 1] == 114 && source[start + 2] == 105 && source[start + 3] == 110 && source[start + 4] == 116 && source[start + 5] == 108 && source[start + 6] == 110 then return L_PRINTLN;
  }
  if length == 8 then {
    if source[start] == 99 then {
      if source[start + 1] == 111 then {
        if source[start + 2] == 110 then {
          if source[start + 3] == 116 then {
            if source[start + 4] == 105 then {
              if source[start + 5] == 110 then {
                if source[start + 6] == 117 then {
                  if source[start + 7] == 101 then return L_CONTINUE;
                }
              }
            }
          }
        }
      }
    }
  }
  if length == 4 then {
    if source[start] == 110 && source[start + 1] == 117 && source[start + 2] == 108 && source[start + 3] == 108 then return L_NULL;
    if source[start] == 99 && source[start + 1] == 104 && source[start + 2] == 97 && source[start + 3] == 114 then return L_TCHAR;
    if source[start] == 108 && source[start + 1] == 111 && source[start + 2] == 110 && source[start + 3] == 103 then return L_TLONG;
  }
  if length == 5 then {
    if source[start] == 99 && source[start + 1] == 111 && source[start + 2] == 110 && source[start + 3] == 115 && source[start + 4] == 116 then return L_CONST;
    if source[start] == 97 && source[start + 1] == 114 && source[start + 2] == 114 && source[start + 3] == 97 && source[start + 4] == 121 then return L_ARRAY;
  }
  if length == 6 then {
    if source[start] == 98 && source[start + 1] == 111 && source[start + 2] == 114 && source[start + 3] == 114 && source[start + 4] == 111 && source[start + 5] == 119 then return L_BORROW;
    if h == 448999 then return L_EXTERN;
    if source[start] == 114 then {
      if source[start + 1] == 101 then {
        if source[start + 2] == 116 then {
          if source[start + 3] == 117 then {
            if source[start + 4] == 114 then {
              if source[start + 5] == 110 then return L_RETURN;
            }
          }
        }
      }
    }
    if source[start] == 115 then {
      if source[start + 1] == 116 then {
        if source[start + 2] == 114 then {
          if source[start + 3] == 117 then {
            if source[start + 4] == 99 then {
              if source[start + 5] == 116 then return L_STRUCT;
            }
          }
        }
      }
    }
    if source[start] == 115 then {
      if source[start + 1] == 116 then {
        if source[start + 2] == 114 then {
          if source[start + 3] == 105 then {
            if source[start + 4] == 110 then {
              if source[start + 5] == 103 then return L_TSTRING;
            }
          }
        }
      }
    }
  }
  if length == 5 then {
    if source[start] == 102 && source[start+1] == 108 && source[start+2] == 111 && source[start+3] == 97 && source[start+4] == 116 then return L_TFLOAT;
    if source[start] == 117 && source[start+1] == 115 && source[start+2] == 105 && source[start+3] == 122 && source[start+4] == 101 then return L_TUSIZE;
  }
  if length == 7 then {
    if source[start] == 97 && source[start+1] == 108 && source[start+2] == 105 && source[start+3] == 103 && source[start+4] == 110 && source[start+5] == 97 && source[start+6] == 115 then return L_ALIGNAS;
    if source[start] == 99 && source[start+1] == 108 && source[start+2] == 111 && source[start+3] == 115 && source[start+4] == 117 && source[start+5] == 114 && source[start+6] == 101 then return L_CLOSURE;
  }
  if length == 9 then { if source[start] == 110 && source[start+1] == 97 && source[start+2] == 109 && source[start+3] == 101 && source[start+4] == 115 && source[start+5] == 112 && source[start+6] == 97 && source[start+7] == 99 && source[start+8] == 101 then return L_NAMESPACE; }
  if length == 10 then { if source[start] == 98 && source[start+1] == 111 && source[start+2] == 114 && source[start+3] == 114 && source[start+4] == 111 && source[start+5] == 119 && source[start+6] == 95 && source[start+7] == 109 && source[start+8] == 117 && source[start+9] == 116 then return L_BORROW_MUT; }
  if length == 6 then { if source[start] == 100 && source[start+1] == 111 && source[start+2] == 117 && source[start+3] == 98 && source[start+4] == 108 && source[start+5] == 101 then return L_TDOUBLE; }
  return L_ID;
}

let tok_kind: int = 0;
let tok_value: int = 0;
let tok_text: int = 0;
let tok_start: int = 0;
let tok_length: int = 0;
let lexer_error: int = 0;
let lexer_literal_digits: int* = 0;
let lexer_literal_digits_cap: int = 0;

func ensure_lexer_literal_digits(need: int): void {
  if need < lexer_literal_digits_cap then return;
  let n: int = next_capacity(lexer_literal_digits_cap, need);
  lexer_literal_digits = grow_ints(lexer_literal_digits, lexer_literal_digits_cap, n);
  lexer_literal_digits_cap = n;
}

func lexer_make_integer(start: int, length: int, base: int): int {
  ensure_lexer_literal_digits(32);
  let digit_count: int = 1;
  let overflow_u64: int = 0;
  let p: int = start;
  let end: int = start + length;
  let prefix: int = 0;
  if base == 16 || base == 2 then prefix = 2;
  p = start + prefix;
  lexer_literal_digits[0] = 0;
  while p < end {
    let digit: int = 0 - 1;
    if base == 16 then digit = hex_digit_value(source[p]);
    else if base == 2 then { if source[p] == 48 || source[p] == 49 then digit = source[p] - 48; }
    else if is_digit(source[p]) == 1 then digit = source[p] - 48;
    if digit < 0 || digit >= base then { lexer_error = 1; return 0; }
    if overflow_u64 == 0 then {
      let i: int = 0;
      let carry: int = digit;
      while i < digit_count {
        let product: int = lexer_literal_digits[i] * base + carry;
        lexer_literal_digits[i] = product % 10;
        carry = product / 10;
        i = i + 1;
      }
      if carry != 0 then {
        if digit_count >= 20 then overflow_u64 = 1;
        else { lexer_literal_digits[digit_count] = carry; digit_count = digit_count + 1; }
      }
    }
    p = p + 1;
  }
  if overflow_u64 == 1 then { lexer_error = 1; return 0; }
  let decimal_start: int = source_len + sym_text_len;
  let i: int = digit_count - 1;
  let out: int = 0;
  while i >= 0 { ensure_source(decimal_start + out); source[decimal_start + out] = 48 + lexer_literal_digits[i]; out = out + 1; i = i - 1; }
  let text_id: int = sym_intern(decimal_start, out, L_INT, 0);
  sym_text_len = sym_text_len + out;
  let value: int = 0;
  let overflow_int: int = 0;
  i = digit_count - 1;
  while i >= 0 {
    let digit: int = lexer_literal_digits[i];
    if overflow_int == 0 then {
      if value > 214748364 then overflow_int = 1;
      else if value == 214748364 && digit > 7 then overflow_int = 1;
      else value = value * 10 + digit;
    }
    i = i - 1;
  }
  tok_kind = L_INT;
  tok_value = value;
  if overflow_int == 1 then tok_value = 0 - 1;
  tok_text = text_id;
  tok_length = length;
  return 1;
}

func lexer_skip(): void {
  while 1 == 1 {
    while is_space(source_peek()) == 1 { source_take(); }
    if source_peek() != 47 || source_pos + 1 >= source_len then return;
    if source[source_pos + 1] == 47 then {
      source_take(); source_take();
      while source_peek() != 10 {
        if source_pos >= source_len then return;
        source_take();
      }
    } else if source[source_pos + 1] == 42 then {
      source_take(); source_take();
      let closed: int = 0;
      while source_pos < source_len {
        if source_peek() == 42 && source_pos + 1 < source_len && source[source_pos + 1] == 47 then {
          source_take(); source_take(); closed = 1; break;
        }
        source_take();
      }
      if closed == 0 then { lexer_error = 1; current_source_pos = source_pos; return; }
    } else return;
  }
}

func lexer_next(): int {
  lexer_skip();
  if lexer_error == 1 then { tok_kind = L_EOF; tok_value = 0; tok_text = 0; tok_length = 0; return tok_kind; }
  tok_start = source_pos;
  tok_length = 0;
  tok_text = 0;
  let c: int = source_peek();
  if c == 0 then {
    tok_kind = L_EOF;
    tok_value = 0;
    return tok_kind;
  }
  if is_alpha(c) == 1 then {
    while is_alnum(source_peek()) == 1 {
      source_take();
    }
    tok_length = source_pos - tok_start;
    tok_kind = word_code(tok_start, tok_length);
    if tok_kind == L_ID || tok_kind == L_ARRAY then tok_value = sym_intern(tok_start, tok_length, tok_kind, 0);
    else tok_value = 0;
    return tok_kind;
  }
  if c == 39 then {
    source_take();
    let v: int = source_take();
    if v == 92 then { let e: int = source_take(); if e == 110 then v = 10; else if e == 116 then v = 9; else if e == 114 then v = 13; else if e == 98 then v = 8; else if e == 102 then v = 12; else if e == 118 then v = 11; else if e == 48 then v = 0; else v = e; }
    if source_peek() != 39 then { tok_kind = L_EOF; tok_value = 0; return tok_kind; }
    source_take();
    tok_kind = L_CHAR; tok_value = v; tok_length = 3; return tok_kind;
  }
  if c == 34 then {
    source_take();
    while source_peek() != 34 {
      if source_pos > source_len - 1 then {
        tok_kind = L_EOF;
        tok_value = 0;
        return tok_kind;
      }
      if source_peek() == 92 then {
        source_take();
        if source_peek() != 0 then source_take();
      } else source_take();
    }
    source_take();
    tok_kind = L_STRING;
    tok_length = source_pos - tok_start;
    tok_value = sym_intern(tok_start + 1, tok_length - 2, L_STRING, 0);
    return tok_kind;
  }
  if is_digit(c) == 1 then {
    if c == 48 && source_pos + 1 < source_len && (source[source_pos + 1] == 120 || source[source_pos + 1] == 88) then {
      source_take(); source_take();
      let hex_start: int = tok_start;
      while is_hex_digit(source_peek()) == 1 { source_take(); }
      if source_pos == tok_start + 2 then { lexer_error = 1; return L_EOF; }
      tok_length = source_pos - tok_start;
      lexer_make_integer(hex_start, tok_length, 16);
      return tok_kind;
    }
    if c == 48 && source_pos + 1 < source_len && (source[source_pos + 1] == 98 || source[source_pos + 1] == 66) then {
      source_take(); source_take();
      let binary_start: int = tok_start;
      while is_binary_digit(source_peek()) == 1 { source_take(); }
      if source_pos == tok_start + 2 then { lexer_error = 1; return L_EOF; }
      tok_length = source_pos - tok_start;
      lexer_make_integer(binary_start, tok_length, 2);
      return tok_kind;
    }
    let value: int = 0;
    let overflow: int = 0;
    while is_digit(source_peek()) == 1 {
      let digit: int = source_peek() - 48;
      source_take();
      if overflow == 0 then {
        if value > 214748364 then overflow = 1;
        else if value == 214748364 && digit > 7 then overflow = 1;
        else value = value * 10 + digit;
      }
    }
    let is_float: int = 0;
    if source_peek() == 46 then { is_float = 1; source_take(); while is_digit(source_peek()) == 1 { source_take(); } }
    if source_peek() == 101 || source_peek() == 69 then {
      is_float = 1; source_take();
      if source_peek() == 43 || source_peek() == 45 then source_take();
      if is_digit(source_peek()) == 0 then { lexer_error = 1; return L_EOF; }
      while is_digit(source_peek()) == 1 { source_take(); }
    }
    if is_float == 1 then { tok_kind = L_FLOAT; tok_length = source_pos - tok_start; tok_text = 0; tok_value = sym_intern(tok_start, tok_length, L_FLOAT, 0); return tok_kind; }
    tok_kind = L_INT;
    tok_length = source_pos - tok_start;
    tok_text = sym_intern(tok_start, tok_length, L_INT, 0);
    if overflow == 1 then tok_value = 0 - 1; else tok_value = value;
    return tok_kind;
  }
  source_take();
  tok_length = 1;
  if c == 43 then {
    if source_peek() == 61 then { source_take(); tok_kind = L_PLUS_EQ; }
    else if source_peek() == 43 then { source_take(); tok_kind = L_CONCAT; }
    else tok_kind = L_PLUS;
  }
  else if c == 45 then { if source_peek() == 61 then { source_take(); tok_kind = L_MINUS_EQ; } else tok_kind = L_MINUS; }
  else if c == 42 then { if source_peek() == 61 then { source_take(); tok_kind = L_STAR_EQ; } else tok_kind = L_STAR; }
  else if c == 47 then { if source_peek() == 61 then { source_take(); tok_kind = L_DIV_EQ; } else tok_kind = L_DIV; }
  else if c == 37 then { if source_peek() == 61 then { source_take(); tok_kind = L_MOD_EQ; } else tok_kind = L_MOD; }
  else if c == 40 then tok_kind = L_LPAREN;
  else if c == 41 then tok_kind = L_RPAREN;
  else if c == 123 then tok_kind = L_LBRACE;
  else if c == 125 then tok_kind = L_RBRACE;
  else if c == 58 then { if source_peek() == 58 then { source_take(); tok_kind = L_SCOPE; } else tok_kind = L_COLON; }
  else if c == 59 then tok_kind = L_SEMI;
  else if c == 44 then tok_kind = L_COMMA;
  else if c == 91 then tok_kind = L_LBRACK;
  else if c == 93 then tok_kind = L_RBRACK;
  else if c == 46 then tok_kind = L_DOT;
  else if c == 60 then { if source_peek() == 60 then { source_take(); if source_peek() == 61 then { source_take(); tok_kind = L_SHL_EQ; } else tok_kind = L_SHL; } else if source_peek() == 61 then { source_take(); tok_kind = L_LE; } else tok_kind = L_LT; }
  else if c == 62 then { if source_peek() == 62 then { source_take(); if source_peek() == 61 then { source_take(); tok_kind = L_SHR_EQ; } else tok_kind = L_SHR; } else if source_peek() == 61 then { source_take(); tok_kind = L_GE; } else tok_kind = L_GT; }
  else if c == 124 then { if source_peek() == 124 then { source_take(); tok_kind = L_OR; } else if source_peek() == 61 then { source_take(); tok_kind = L_BITOR_EQ; } else tok_kind = L_BITOR; }
  else if c == 94 then { if source_peek() == 61 then { source_take(); tok_kind = L_BITXOR_EQ; } else tok_kind = L_BITXOR; }
  else if c == 126 then tok_kind = L_BITNOT;
  else if c == 61 then {
    if source_peek() == 61 then { source_take(); tok_kind = L_EQEQ; }
    else if source_peek() == 62 then { source_take(); tok_kind = L_FATARROW; }
    else tok_kind = L_EQ;
  }
  else if c == 33 then {
    if source_peek() == 61 then { source_take(); tok_kind = L_NEQ; }
    else tok_kind = L_NOT;
  }
  else if c == 38 then {
    if source_peek() == 38 then { source_take(); tok_kind = L_AND; }
    else if source_peek() == 61 then { source_take(); tok_kind = L_AMP_EQ; }
    else tok_kind = L_AMP;
  }
  else if c == 124 then {
    if source_peek() == 124 then { source_take(); tok_kind = L_OR; }
    else tok_kind = L_EOF;
  }
  else tok_kind = L_EOF;
  tok_value = 0;
  return tok_kind;
}

func include_process_line(line: int*, length: int): void {
  let mode: int = 0;
  let p: int = 0;
  while p < length && (line[p] == 32 || line[p] == 9) { p = p + 1; }
  if p + 7 < length then {
    if line[p] == 105 && line[p + 1] == 110 && line[p + 2] == 99 && line[p + 3] == 108 && line[p + 4] == 117 && line[p + 5] == 100 && line[p + 6] == 101 then {
      if line[p + 7] == 32 || line[p + 7] == 9 then mode = 1;
    }
  }
  if p + 8 < length && mode == 0 then {
    if line[p] == 105 && line[p + 1] == 110 && line[p + 2] == 99 && line[p + 3] == 108 && line[p + 4] == 117 && line[p + 5] == 100 && line[p + 6] == 101 && line[p + 7] == 99 then {
      if line[p + 8] == 32 || line[p + 8] == 9 then mode = 2;
    }
  }
  if mode == 0 then {
    let i: int = 0;
    while i < length { source_put(line[i]); i = i + 1; }
    source_put(10);
  } else if mode == 1 then {
    let parent_file: int = source_active_file;
    let parent_line: int = source_active_line;
    let child_module: int* = basalt_include_open_line(line, length, mode);
    let status_module: int = basalt_include_last_status();
    let target_path: string = basalt_inc_realpath("");
    let target_file: int = 0;
    if target_path[0] != '\0' then target_file = source_file_intern(target_path);
    if target_file == 0 then {
      source_import_fail(3, parent_file, 0, parent_line);
    } else {
      source_dep_add(parent_file, target_file);
      if source_dep_reaches(target_file, parent_file) == 1 then source_import_fail(1, parent_file, target_file, parent_line);
      else if child_module == 0 then {
        if status_module == 2 then { }
        else if status_module == 1 then source_import_fail(1, parent_file, target_file, parent_line);
        else if status_module == 3 then source_import_fail(2, parent_file, target_file, parent_line);
        else source_import_fail(3, parent_file, target_file, parent_line);
      } else {
        source_active_file = target_file;
        source_active_line = 1;
        include_expand_handle(child_module);
        source_active_file = parent_file;
        source_active_line = parent_line;
        close_file(child_module);
        basalt_include_close();
      }
    }
  } else {
    let parent_file: int = source_active_file;
    let parent_line: int = source_active_line;
    let child_c: int* = basalt_include_open_line(line, length, mode);
    let status_c: int = basalt_include_last_status();
    let target_path_c: string = basalt_inc_realpath("");
    let target_file_c: int = 0;
    if target_path_c[0] != '\0' then target_file_c = source_file_intern(target_path_c);
    if target_file_c == 0 then {
      source_import_fail(3, parent_file, 0, parent_line);
    } else {
      source_dep_add(parent_file, target_file_c);
      if source_dep_reaches(target_file_c, parent_file) == 1 then source_import_fail(1, parent_file, target_file_c, parent_line);
      else if child_c == 0 then {
        if status_c == 2 then { }
        else if status_c == 1 then source_import_fail(1, parent_file, target_file_c, parent_line);
        else if status_c == 3 then source_import_fail(2, parent_file, target_file_c, parent_line);
        else source_import_fail(3, parent_file, target_file_c, parent_line);
      } else {
        let c: int = read_char(child_c);
        while c != (0 - 1) { c_source_put(c); c = read_char(child_c); }
        close_file(child_c);
        basalt_include_close();
      }
    }
  }
}

func include_expand_handle(handle: int*): void {
  let line_capacity: int = include_line_initial_cap;
  let line: int* = alloc_ints(line_capacity);
  let length: int = 0;
  let line_number: int = 1;
  let c: int = read_char(handle);
  while c != (0 - 1) {
    if c == 10 then { include_process_line(line, length); length = 0; line_number = line_number + 1; source_active_line = line_number; }
    else {
      if length >= line_capacity then {
        let next_line_capacity: int = next_capacity(line_capacity, length);
        line = grow_ints(line, line_capacity, next_line_capacity);
        line_capacity = next_line_capacity;
      }
      line[length] = c;
      length = length + 1;
    }
    c = read_char(handle);
  }
  if length > 0 then include_process_line(line, length);
  free_ints(line);
  // `handle` is borrowed; the caller owns the root include handle.
}

func load_source_file(path: string): void {
  source_reset();
  let handle: int* = open_file(path, "r");
  let c: int = read_char(handle);
  while c != (0 - 1) {
    source_put(c);
    c = read_char(handle);
  }
  close_file(handle);
}


func map_token(k: int): int {
  if k == L_EOF then return T_EOF;
  if k == L_ID then return T_ID;
  if k == L_INT then return T_INT;
  if k == L_STRING then return T_STRING;
  if k == L_FUNC then return T_FUNC;
  if k == L_EXTERN then return T_EXTERN;
  if k == L_LET then return T_LET;
  if k == L_PRINT then return T_PRINT;
  if k == L_PRINTLN then return T_PRINTLN;
  if k == L_RETURN then return T_RETURN;
  if k == L_DEFER then return T_DEFER;
  if k == L_MATCH then return T_MATCH;
  if k == L_FATARROW then return T_FATARROW;
  if k == L_IF then return T_IF;
  if k == L_ELSE then return T_ELSE;
  if k == L_WHILE then return T_WHILE;
  if k == L_FOR then return T_FOR;
  if k == L_STRUCT then return T_STRUCT;
  if k == L_ENUM then return T_ENUM;
  if k == L_BREAK then return T_BREAK;
  if k == L_CONTINUE then return T_CONTINUE;
  if k == L_TRUE then return T_TRUE;
  if k == L_FALSE then return T_FALSE;
  if k == L_TINT then return T_TINT;
  if k == L_TBOOL then return T_TBOOL;
  if k == L_TSTRING then return T_TSTRING;
  if k == L_TVOID then return T_TVOID;
  if k == L_THEN then return T_THEN;
  if k == L_PLUS then return T_PLUS;
  if k == L_MINUS then return T_MINUS;
  if k == L_STAR then return T_STAR;
  if k == L_DIV then return T_DIVIDE;
  if k == L_MOD then return T_MOD;
  if k == L_TLONG then return T_TLONG;
  if k == L_ALIGNAS then return T_ALIGNAS;
  if k == L_TU8 then return T_TU8;
  if k == L_TU16 then return T_TU16;
  if k == L_TU32 then return T_TU32;
  if k == L_TU64 then return T_TU64;
  if k == L_TI8 then return T_TI8;
  if k == L_TI16 then return T_TI16;
  if k == L_TI32 then return T_TI32;
  if k == L_TI64 then return T_TI64;
  if k == L_TUSIZE then return T_TUSIZE;
  if k == L_PLUS_EQ then return T_PLUS_EQ;
  if k == L_MINUS_EQ then return T_MINUS_EQ;
  if k == L_STAR_EQ then return T_STAR_EQ;
  if k == L_DIV_EQ then return T_DIV_EQ;
  if k == L_MOD_EQ then return T_MOD_EQ;
  if k == L_AMP_EQ then return T_AMP_EQ;
  if k == L_BITOR_EQ then return T_BITOR_EQ;
  if k == L_BITXOR_EQ then return T_BITXOR_EQ;
  if k == L_SHL_EQ then return T_SHL_EQ;
  if k == L_SHR_EQ then return T_SHR_EQ;
  if k == L_CONCAT then return T_CONCAT;
  if k == L_AND then return T_AND_AND;
  if k == L_OR then return T_OR_OR;
  if k == L_EQ then return T_EQUAL;
  if k == L_EQEQ then return T_EQEQ;
  if k == L_NEQ then return T_NEQ;
  if k == L_LT then return T_LT;
  if k == L_GT then return T_GT;
  if k == L_LE then return T_LE;
  if k == L_GE then return T_GE;
  if k == L_NOT then return T_NOT;
  if k == L_MOVE then return T_MOVE;
  if k == L_BORROW then return T_BORROW;
  if k == L_BORROW_MUT then return T_BORROW_MUT;
  if k == L_CLOSURE then return T_CLOSURE;
  if k == L_MUT then return T_MUT;
  if k == L_COLON then return T_COLON;
  if k == L_LPAREN then return T_LPAREN;
  if k == L_RPAREN then return T_RPAREN;
  if k == L_LBRACE then return T_LBRACE;
  if k == L_RBRACE then return T_RBRACE;
  if k == L_SEMI then return T_SEMI;
  if k == L_COMMA then return T_COMMA;
  if k == L_AMP then return T_AMP;
  if k == L_LBRACK then return T_LBRACK;
  if k == L_RBRACK then return T_RBRACK;
  if k == L_DOT then return T_DOT;
  if k == L_CHAR then return T_CHAR;
  if k == L_NULL then return T_NULL;
  if k == L_CONST then return T_CONST;
  if k == L_TCHAR then return T_TCHAR;
  if k == L_FLOAT then return T_FLOAT;
  if k == L_TFLOAT then return T_FLOAT;
  if k == L_TDOUBLE then return T_TDOUBLE;
  if k == L_BITOR then return T_BITOR;
  if k == L_BITXOR then return T_BITXOR;
  if k == L_BITNOT then return T_BITNOT;
  if k == L_SHL then return T_SHL;
  if k == L_SHR then return T_SHR;
  if k == L_FN then return T_FN;
  if k == L_ARRAY then return T_ARRAY;
  if k == L_NAMESPACE then return T_NAMESPACE;
  if k == L_SCOPE then return T_SCOPE;
  return T_EOF;
}

func load_tokens_from_file(path: string): void {
  input_reset();
  basalt_include_reset_session();
  source_reset();
  sym_text_len = 0;
  sym_count = 1;
  ast_namespace_scope = 0;
  ast_const_count = 0;
  c_source_reset();
  ffi_header_count = 0;
  lexer_error = 0;
  include_ok = 1;
  source_import_error_kind = 0;
  let handle: int* = basalt_include_open_root(path);
  let root_id: int = source_file_intern(basalt_inc_realpath(path));
  if handle == 0 then {
    source_import_fail(2, 0, root_id, 1);
  } else {
    source_active_file = root_id;
    source_active_line = 1;
    include_expand_handle(handle);
    close_file(handle);
    basalt_include_close();
  }
  let k: int = lexer_next();
  while k != L_EOF {
    if debug_tokens == 1 then {
      runtime_write_string("token.kind=");
      runtime_write_int(map_token(k));
      runtime_write_char('\n');
      runtime_write_string("token.start=");
      runtime_write_int(tok_start);
      runtime_write_char('\n');
      runtime_write_string("token.length=");
      runtime_write_int(tok_length);
      runtime_write_char('\n');
      runtime_write_string("token.value=");
      runtime_write_int(tok_value);
      runtime_write_char('\n');
    }
    input_put(map_token(k), tok_value, tok_text, tok_start);
    k = lexer_next();
  }
  input_put(T_EOF, 0, 0, source_pos);
}

// Bootstrap type checker. Types are represented by (kind, named-id) pairs so
// recursive pointer types do not require eagerly laying out the pointed struct.
let tc_root: int = 0;
let tc_ok: int = 1;
let tc_error_code: int = 0;
