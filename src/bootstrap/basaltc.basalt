func emit_c_file(path: string): void {
  let out: int* = open_file(path, "w");
  emit_runtime(out);
  let hi: int = 0;
  while hi < ffi_header_count {
    write_string(out, "#include \"");
    emit_symbol(out, ffi_header_ids[hi]);
    write_string(out, "\"\n");
    hi = hi + 1;
  }
  let ci: int = 0;
  while ci < c_source_len { write_char(out, c_source[ci]); ci = ci + 1; }
  let i: int = 0;
  let last_epoch: int = (0 - 1);
  emit_pending_space = 0;
  while i < code_count {
    if code_epoch[i] != last_epoch then {
      if emit_line_directives == 1 then {
        emit_pending_space = 0;
        emit_source_line(out, code_pos[i]);
      }
      last_epoch = code_epoch[i];
    }
    emit_c_token(out, code_kind[i], code_value[i]);
    i = i + 1;
  }
  close_file(out);
}

extern func basalt_sys_run(executable: string, args: string*, arg_count: int, max_output: int): int;
extern func basalt_sys_run_status(): int;
extern func basalt_sys_stdout(): string;
extern func basalt_sys_stderr(): string;
extern func basalt_sys_truncated(): int;
extern func basalt_sys_spawn_error(): int;
extern func basalt_compile_argv(compiler: string, input_c: string, output_bin: string, all_args: string*, start: int, extra_count: int): int;

func cli_arg_eq(a: string, b: string): int {
  let i: int = 0;
  while a[i] != '\0' {
    if b[i] == '\0' then return 0;
    if a[i] != b[i] then return 0;
    i = i + 1;
  }
  if b[i] != '\0' then return 0;
  return 1;
}

func main(argc: int, argv: string*): void {
  let input_index: int = 0 - 1;
  let output_index: int = 0 - 1;
  let auto_compile: int = 0;
  let compiler: string = "cc";
  let binary_path: string = "";
  let has_binary_path: int = 0;
  let extra_start: int = 0;
  let extra_count: int = 0;
  let i: int = 1;
  while i < argc {
    if cli_arg_eq(argv[i], "--") == 1 then {
      extra_start = i + 1;
      extra_count = argc - i - 1;
      i = argc;
    } else if cli_arg_eq(argv[i], "--line") == 1 then {
      emit_line_directives = 1;
      i = i + 1;
    } else if cli_arg_eq(argv[i], "--no-line") == 1 then {
      emit_line_directives = 0;
      i = i + 1;
    } else if cli_arg_eq(argv[i], "--compile") == 1 then {
      auto_compile = 1;
      i = i + 1;
    } else if cli_arg_eq(argv[i], "--cc") == 1 then {
      if i + 1 >= argc then return 1;
      compiler = argv[i + 1];
      i = i + 2;
    } else if cli_arg_eq(argv[i], "-o") == 1 then {
      if i + 1 >= argc then return 1;
      binary_path = argv[i + 1];
      has_binary_path = 1;
      i = i + 2;
    } else if input_index < 0 then {
      input_index = i;
      i = i + 1;
    } else if output_index < 0 then {
      output_index = i;
      i = i + 1;
    } else {
      return 1;
    }
  }
  if input_index < 0 then return 1;
  let ok: int = pipeline_main(argv[input_index]);
  if ok != 0 then return ok;
  let c_path: string = "";
  let has_c_path: int = 0;
  if output_index >= 0 then { c_path = argv[output_index]; has_c_path = 1; }
  else if auto_compile == 1 then { c_path = argv[input_index] ++ ".c"; has_c_path = 1; }
  if has_c_path == 1 then {
    if pipeline_root > 0 then {
      gen_program(pipeline_root);
      emit_c_file(c_path);
    }
  }
  if auto_compile == 1 then {
    if has_binary_path == 0 then binary_path = argv[input_index] ++ ".out";
    return basalt_compile_argv(compiler, c_path, binary_path, argv, extra_start, extra_count);
  }
  return ok;
}
