let input_kind: int* = 0;
let input_value: int* = 0;
let input_text: int* = 0;
let input_source_pos: int* = 0;
let input_count: int = 0;
let input_pos: int = 0;
let debug_tokens: int = 0;
let for_step_context: int = 0;

func input_reset(): void {
  input_count = 0;
  input_pos = 0;
}

func input_put(kind: int, value: int, text: int, pos: int): void {
  ensure_input(input_count);
  input_kind[input_count] = kind;
  input_value[input_count] = value;
  input_text[input_count] = text;
  input_source_pos[input_count] = pos;
  input_count = input_count + 1;
}

func input_peek(): int {
  if input_pos < input_count then return input_kind[input_pos];
  else return T_EOF;
}

func input_payload(): int {
  if input_pos < input_count then return input_value[input_pos];
  else return 0;
}

func input_text_payload(): int {
  if input_pos < input_count then return input_text[input_pos];
  else return 0;
}

func input_take(kind: int): int {
  if input_peek() == kind then {
    input_pos = input_pos + 1;
    return 1;
  } else return 0;
}

let ast_generic_scope: int = 0;

func ast_generic_param(name: int): int {
  let p: int = ast_generic_scope;
  while p != 0 {
    if node_a[p] == name then return 1;
    p = node_next[p];
  }
  return 0;
}

func ast_generic_params(): int {
  let params: int = 0;
  if input_take(T_LT) == 0 then return 0;
  while 1 == 1 {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload(); input_pos = input_pos + 1;
    let p: int = ast_node(N_PARAM, name, 0, 0, 0, 0);
    if params == 0 then params = p; else params = ast_link(params, p);
    if input_take(T_COMMA) == 1 then { }
    else break;
  }
  if input_take(T_GT) == 0 then return (0 - 1);
  return params;
}

func ast_append_array_dimension(ty: int, size: int): int {
  if ty == 0 || node_kind[ty] != TY_ARRAY then return ast_node(TY_ARRAY, ty, 0, 0, size, 0);
  let child: int = ast_append_array_dimension(node_a[ty], size);
  return ast_node(TY_ARRAY, child, 0, 0, node_value[ty], 0);
}
func ensure_ast_consts(need: int): void {
  if need < ast_const_cap then return;
  let n: int = next_capacity(ast_const_cap, need);
  ast_const_name = grow_ints(ast_const_name, ast_const_cap, n);
  ast_const_value = grow_ints(ast_const_value, ast_const_cap, n);
  ast_const_cap = n;
}
func ast_const_add(name: int, value: int): void {
  ensure_ast_consts(ast_const_count);
  ast_const_name[ast_const_count] = name;
  ast_const_value[ast_const_count] = value;
  ast_const_count = ast_const_count + 1;
}
func ast_const_find(name: int): int {
  let i: int = ast_const_count - 1;
  while i >= 0 {
    if ast_const_name[i] == name then return i + 1;
    i = i - 1;
  }
  return 0;
}
func ast_const_add_checked(left: int, right: int): int {
  if right > 2147483647 - left then return 0 - 1;
  return left + right;
}
func ast_const_sub_checked(left: int, right: int): int {
  if right > left then return 0 - 1;
  return left - right;
}
func ast_const_mul_checked(left: int, right: int): int {
  if left != 0 && right > 2147483647 / left then return 0 - 1;
  return left * right;
}
func ast_const_eval(id: int): int {
  if id == 0 then return 0 - 1;
  if node_kind[id] == N_INT then {
    if node_value[id] < 0 then return 0 - 1;
    return node_value[id];
  }
  if node_kind[id] == N_VAR then {
    let found: int = ast_const_find(node_value[id]);
    if found == 0 && ast_namespace_scope != 0 then found = ast_const_find(sym_qualified(ast_namespace_scope, node_value[id]));
    if found != 0 then return ast_const_value[found - 1];
    return 0 - 1;
  }
  if node_kind[id] != N_BINOP then return 0 - 1;
  let left: int = ast_const_eval(node_a[id]);
  let right: int = ast_const_eval(node_b[id]);
  if left < 0 || right < 0 then return 0 - 1;
  if node_value[id] == OP_ADD then return ast_const_add_checked(left, right);
  if node_value[id] == OP_SUB then return ast_const_sub_checked(left, right);
  if node_value[id] == OP_MUL then return ast_const_mul_checked(left, right);
  if node_value[id] == OP_DIV then { if right == 0 then return 0 - 1; return left / right; }
  if node_value[id] == OP_MOD then { if right == 0 then return 0 - 1; return left % right; }
  return 0 - 1;
}
func ast_array_dimension_value(): int {
  if input_peek() == T_INT then {
    let raw_size: int = input_payload();
    input_pos = input_pos + 1;
    return raw_size;
  }
  if input_peek() != T_ID && input_peek() != T_ARRAY then return 0 - 1;
  let name: int = input_payload();
  input_pos = input_pos + 1;
  let qualified: int = 0;
  while input_take(T_SCOPE) == 1 {
    if input_peek() != T_ID && input_peek() != T_ARRAY then return 0 - 1;
    let rhs: int = input_payload();
    input_pos = input_pos + 1;
    name = sym_qualified(name, rhs);
    qualified = 1;
  }
  if ast_namespace_scope != 0 && qualified == 0 then name = sym_qualified(ast_namespace_scope, name);
  let found: int = ast_const_find(name);
  if found == 0 then return 0 - 1;
  return ast_const_value[found - 1];
}
func ast_type(): int {
  let base: int = 0;
  let named: int = 0;
  let ty: int = 0;
  if input_take(T_LPAREN) == 1 then {
    let first: int = ast_type();
    if first == 0 then return 0;
    if input_take(T_COMMA) == 1 then {
      let items: int = first;
      while 1 == 1 {
        let item: int = ast_type();
        if item == 0 then return 0;
        items = ast_link(items, item);
        if input_take(T_COMMA) == 0 then { break; }
      }
      if input_take(T_RPAREN) == 0 then return 0;
      ty = ast_node(TY_TUPLE, items, 0, 0, 0, 0);
    } else {
      if input_take(T_RPAREN) == 0 then return 0;
      ty = first;
    }
    while input_take(T_STAR) == 1 { ty = ast_node(TY_PTR, ty, 0, 0, 0, 0); }
    while input_take(T_LBRACK) == 1 {
      let size: int = ast_array_dimension_value();
      if size < 0 then return 0;
      if input_take(T_RBRACK) == 0 then return 0;
      ty = ast_append_array_dimension(ty, size);
    }
    return ty;
  }
  if input_take(T_CLOSURE) == 1 then {
    if input_take(T_LPAREN) == 0 then return 0;
    let args: int = 0;
    if input_peek() != T_RPAREN then {
      let at: int = ast_type();
      if at == 0 then return 0;
      args = at;
      while input_take(T_COMMA) == 1 {
        at = ast_type();
        if at == 0 then return 0;
        args = ast_link(args, at);
      }
    }
    if input_take(T_RPAREN) == 0 then return 0;
    if input_take(T_COLON) == 0 then return 0;
    let ret: int = ast_type();
    if ret == 0 then return 0;
    return ast_node(TY_CLOSURE, args, ret, 0, 0, 0);
  }
  if input_take(T_FN) == 1 then {
    if input_take(T_LPAREN) == 0 then return 0;
    let args: int = 0;
    if input_peek() != T_RPAREN then {
      let at: int = ast_type();
      if at == 0 then return 0;
      args = at;
      while input_take(T_COMMA) == 1 {
        at = ast_type();
        if at == 0 then return 0;
        args = ast_link(args, at);
      }
    }
    if input_take(T_RPAREN) == 0 then return 0;
    if input_take(T_COLON) == 0 then return 0;
    let ret: int = ast_type();
    if ret == 0 then return 0;
    return ast_node(TY_FUN, args, ret, 0, 0, 0);
  }
  if input_peek() == T_ARRAY && input_pos + 1 < input_count && input_kind[input_pos + 1] == T_SCOPE then {
    let ns: int = input_payload(); input_pos = input_pos + 2;
    if input_peek() != T_ID && input_peek() != T_ARRAY then return 0;
    let rhs: int = input_payload(); input_pos = input_pos + 1;
    let named_type: int = sym_qualified(ns, rhs);
    if input_take(T_LT) == 1 then {
      let args: int = 0;
      if input_peek() != T_GT then {
        let at: int = ast_type();
        if at == 0 then return 0;
        args = at;
        while input_take(T_COMMA) == 1 {
          at = ast_type();
          if at == 0 then return 0;
          args = ast_link(args, at);
        }
      }
      if input_take(T_GT) == 0 then return 0;
      ty = ast_node(TY_GENERIC, args, 0, 0, named_type, 0);
    } else ty = ast_node(TY_NAMED, 0, 0, 0, named_type, 0);
  } else {
    if input_take(T_TINT) == 1 then base = TY_INT;
    else if input_take(T_TBOOL) == 1 then base = TY_BOOL;
    else if input_take(T_TSTRING) == 1 then base = TY_STRING;
    else if input_take(T_TCHAR) == 1 then base = TY_CHAR;
    else if input_take(T_FLOAT) == 1 then base = TY_FLOAT;
    else if input_take(T_TDOUBLE) == 1 then base = TY_DOUBLE;
    else if input_take(T_TLONG) == 1 then { if input_take(T_TLONG) == 1 then base = TY_LLONG; else base = TY_LONG; }
    else if input_take(T_TU8) == 1 then base = TY_U8;
    else if input_take(T_TU16) == 1 then base = TY_U16;
    else if input_take(T_TU32) == 1 then base = TY_U32;
    else if input_take(T_TU64) == 1 then base = TY_U64;
    else if input_take(T_TI8) == 1 then base = TY_I8;
    else if input_take(T_TI16) == 1 then base = TY_I16;
    else if input_take(T_TI32) == 1 then base = TY_I32;
    else if input_take(T_TI64) == 1 then base = TY_I64;
    else if input_take(T_TUSIZE) == 1 then base = TY_USIZE;
    else if input_take(T_TVOID) == 1 then base = TY_VOID;
    else if input_peek() == T_ID then {
                named = input_payload();
          input_pos = input_pos + 1;
          if input_take(T_SCOPE) == 1 then {
            if input_peek() != T_ID then return 0;
            let rhs: int = input_payload(); input_pos = input_pos + 1;
            named = sym_qualified(named, rhs);
          } else named = ast_type_name(named);
          if input_peek() == T_LT then {

        let args: int = 0;
        input_pos = input_pos + 1;
        if input_peek() != T_GT then {
          let at: int = ast_type();
          if at == 0 then return 0;
          args = at;
          while input_take(T_COMMA) == 1 {
            at = ast_type();
            if at == 0 then return 0;
            args = ast_link(args, at);
          }
        }
        if input_take(T_GT) == 0 then return 0;
        ty = ast_node(TY_GENERIC, args, 0, 0, named, 0);
      } else if ast_generic_param(named) == 1 then ty = ast_node(TY_PARAM, 0, 0, 0, named, 0);
      else ty = ast_node(TY_NAMED, 0, 0, 0, named, 0);
    } else return 0;
    if ty == 0 then ty = ast_node(base, 0, 0, 0, named, 0);
  }
  while input_take(T_STAR) == 1 {
    ty = ast_node(TY_PTR, ty, 0, 0, 0, 0);
  }
  while input_take(T_LBRACK) == 1 {
    let size: int = ast_array_dimension_value();
    if size < 0 then return 0;
    if input_take(T_RBRACK) == 0 then return 0;
    ty = ast_append_array_dimension(ty, size);
  }
  return ty;
}

func ast_call_args(): int {
  let args: int = 0;
  if input_peek() != T_RPAREN then {
    let arg: int = ast_expr();
    if arg < 0 then return (0 - 1);
    args = arg;
    while input_take(T_COMMA) == 1 {
      arg = ast_expr();
      if arg < 0 then return (0 - 1);
      args = ast_link(args, arg);
    }
  }
  if input_take(T_RPAREN) == 0 then return (0 - 1);
  return args;
}

func ast_primary(): int {
  if input_take(T_FN) == 1 then {
    let captures: int = 0;
    if input_take(T_LBRACK) == 1 then {
      if input_peek() != T_RBRACK then {
        while 1 == 1 {
          let mode: int = 2;
          if input_take(T_MOVE) == 1 then mode = 1;
          else if input_take(T_BORROW) == 1 then mode = 2;
          else if input_take(T_BORROW_MUT) == 1 then mode = 3;
          if input_peek() != T_ID then return (0 - 1);
          let capture_name: int = input_payload(); input_pos = input_pos + 1;
          let capture: int = ast_node(N_PARAM, capture_name, 0, 0, 0, mode);
          if captures == 0 then captures = capture; else captures = ast_link(captures, capture);
          if input_take(T_COMMA) == 0 then break;
        }
      }
      if input_take(T_RBRACK) == 0 then return (0 - 1);
    }
    if input_take(T_LPAREN) == 0 then return (0 - 1);
    let params: int = ast_params();
    if params < 0 then return (0 - 1);
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ret_ty: int = ast_type();
    if ret_ty == 0 then return (0 - 1);
    let body: int = ast_stmt();
    if body < 0 then return (0 - 1);
    return ast_node(N_CLOSURE, captures, body, params, ret_ty, 0);
  }
  if input_peek() == T_CHAR then {
    let value: int = input_payload(); input_pos = input_pos + 1;
    return ast_node(N_CHAR, 0, 0, 0, value, 0);
  }
  if input_take(T_NULL) == 1 then return ast_node(N_NULL, 0, 0, 0, 0, 0);
  if input_peek() == T_FLOAT then { let value: int = input_payload(); input_pos = input_pos + 1; return ast_node(N_FLOAT, 0, 0, 0, value, 0); }
  if input_peek() == T_INT then {
    let value: int = input_payload();
    let raw: int = input_text_payload();
    input_pos = input_pos + 1;
    return ast_node(N_INT, 0, 0, 0, value, raw);
  }
  if input_peek() == T_STRING then {
    let value: int = input_payload();
    input_pos = input_pos + 1;
    return ast_node(N_STRING, 0, 0, 0, value, 0);
  }
  if input_take(T_TRUE) == 1 then return ast_node(N_BOOL, 0, 0, 0, 1, 0);
  if input_take(T_FALSE) == 1 then return ast_node(N_BOOL, 0, 0, 0, 0, 0);
  if input_peek() == T_ID || input_peek() == T_ARRAY then {
    let name: int = input_payload();
    input_pos = input_pos + 1;
    while input_take(T_SCOPE) == 1 {
      if input_peek() != T_ID && input_peek() != T_ARRAY then return (0 - 1);
      let rhs: int = input_payload(); input_pos = input_pos + 1;
      name = sym_qualified(name, rhs);
    }
    let explicit_args: int = 0;
    let explicit_valid: int = 0;
    let generic_probe: int = input_pos;
    if input_take(T_LT) == 1 then {
      if input_peek() != T_GT then {
        let type_arg: int = ast_type();
        if type_arg != 0 then {
          explicit_args = type_arg;
          while input_take(T_COMMA) == 1 {
            type_arg = ast_type();
            if type_arg == 0 then { explicit_args = 0; break; }
            explicit_args = ast_link(explicit_args, type_arg);
          }
          if explicit_args != 0 && input_take(T_GT) == 1 then explicit_valid = 1;
        }
      }
      if explicit_valid == 0 then { input_pos = generic_probe; explicit_args = 0; }
    }
    if explicit_valid == 1 then {
      if input_take(T_LPAREN) == 0 then { input_pos = generic_probe; explicit_valid = 0; explicit_args = 0; }
    }
    if explicit_valid == 0 && input_take(T_LPAREN) == 1 then { }
    if explicit_valid == 1 || input_kind[input_pos - 1] == T_LPAREN then {
      let args: int = ast_call_args();
      if args < 0 then return (0 - 1);
      return ast_node(N_CALL, args, explicit_args, 0, name, 0);
    }
    let base: int = ast_node(N_VAR, 0, 0, 0, name, 0);
    if input_take(T_DOT) == 1 then {
      if input_peek() != T_ID then return (0 - 1);
      let field: int = input_payload();
      input_pos = input_pos + 1;
      let field_expr: int = ast_node(N_FIELD_ACCESS, base, 0, 0, field, 0);
      if input_take(T_LPAREN) == 1 then {
        let args: int = ast_call_args();
        if args < 0 then return (0 - 1);
        return ast_node(N_INDIRECT_CALL, field_expr, args, 0, 0, 0);
      }
      return field_expr;
    }
    return base;
  }
  if input_take(T_LPAREN) == 1 then {
    let e: int = ast_expr();
    if e < 0 then return (0 - 1);
    if input_take(T_COMMA) == 1 then {
      let items: int = e;
      while 1 == 1 {
        let item: int = ast_expr();
        if item < 0 then return (0 - 1);
        items = ast_link(items, item);
        if input_take(T_COMMA) == 0 then { break; }
      }
      if input_take(T_RPAREN) == 0 then return (0 - 1);
      return ast_node(N_TUPLE, items, 0, 0, 0, 0);
    }
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_LPAREN) == 1 then {
      let args: int = ast_call_args();
      if args < 0 then return (0 - 1);
      return ast_node(N_INDIRECT_CALL, e, args, 0, 0, 0);
    }
    return e;
  }
  return (0 - 1);
}

func ast_unary(): int {
  if input_take(T_MINUS) == 1 then {
    let e: int = ast_unary();
    if e < 0 then return (0 - 1);
    let zero: int = ast_node(N_INT, 0, 0, 0, 0, 0);
    return ast_node(N_BINOP, zero, e, 0, OP_SUB, 0);
  }
  if input_take(T_BITNOT) == 1 then { let e: int = ast_unary(); if e < 0 then return (0 - 1); let allbits: int = ast_node(N_INT, 0, 0, 0, (0 - 1), 0); return ast_node(N_BINOP, e, allbits, 0, OP_BITXOR, 0); }
  if input_take(T_NOT) == 1 then {
    let e: int = ast_unary();
    if e < 0 then return (0 - 1);
    return ast_node(N_UNARY, e, 0, 0, OP_NOT, 0);
  }
  if input_take(T_MOVE) == 1 then {
    let e: int = ast_unary();
    if e < 0 then return (0 - 1);
    return ast_node(N_MOVE, e, 0, 0, 0, 0);
  }
  if input_take(T_STAR) == 1 then {
    let e: int = ast_unary();
    if e < 0 then return (0 - 1);
    return ast_node(N_DEREF, e, 0, 0, 0, 0);
  }
  if input_take(T_AMP) == 1 then {
    let mutable: int = 0;
    if input_take(T_MUT) == 1 then mutable = 1;
    let e: int = ast_unary();
    if e < 0 then return (0 - 1);
    return ast_node(N_ADDRESS, e, 0, 0, mutable, 0);
  }
  return ast_primary();
}

func ast_precedence(kind: int): int {
  if kind == T_OR_OR then return 1;
  if kind == T_AND_AND then return 2;
  if kind == T_EQEQ then return 3;
  if kind == T_NEQ then return 3;
  if kind == T_LT then return 3;
  if kind == T_GT then return 3;
  if kind == T_LE then return 3;
  if kind == T_GE then return 3;
  if kind == T_CONCAT then return 4;
  if kind == T_BITOR then return 5;
  if kind == T_BITXOR then return 6;
  if kind == T_AMP then return 7;
  if kind == T_SHL then return 8;
  if kind == T_SHR then return 8;
  if kind == T_PLUS then return 9;
  if kind == T_MINUS then return 9;
  if kind == T_STAR then return 10;
  if kind == T_DIVIDE then return 10;
  if kind == T_MOD then return 10;
  return 0;
}

func ast_operator(kind: int): int {
  if kind == T_PLUS then return OP_ADD;
  if kind == T_MINUS then return OP_SUB;
  if kind == T_STAR then return OP_MUL;
  if kind == T_DIVIDE then return OP_DIV;
  if kind == T_MOD then return OP_MOD;
  if kind == T_EQEQ then return OP_EQ;
  if kind == T_NEQ then return OP_NEQ;
  if kind == T_LT then return OP_LT;
  if kind == T_GT then return OP_GT;
  if kind == T_LE then return OP_LE;
  if kind == T_GE then return OP_GE;
  if kind == T_AND_AND then return OP_AND;
  if kind == T_OR_OR then return OP_OR;
  if kind == T_CONCAT then return OP_CONCAT;
  if kind == T_AMP then return OP_BITAND;
  if kind == T_BITOR then return OP_BITOR;
  if kind == T_BITXOR then return OP_BITXOR;
  if kind == T_SHL then return OP_SHL;
  if kind == T_SHR then return OP_SHR;
  return OP_GT;
}

func ast_compound_operator(kind: int): int {
  if kind == T_PLUS_EQ then return OP_ADD;
  if kind == T_MINUS_EQ then return OP_SUB;
  if kind == T_STAR_EQ then return OP_MUL;
  if kind == T_DIV_EQ then return OP_DIV;
  if kind == T_MOD_EQ then return OP_MOD;
  if kind == T_AMP_EQ then return OP_BITAND;
  if kind == T_BITOR_EQ then return OP_BITOR;
  if kind == T_BITXOR_EQ then return OP_BITXOR;
  if kind == T_SHL_EQ then return OP_SHL;
  if kind == T_SHR_EQ then return OP_SHR;
  return 0;
}

func ast_take_compound_operator(): int {
  let kind: int = input_peek();
  let op: int = ast_compound_operator(kind);
  if op != 0 then input_pos = input_pos + 1;
  return op;
}

func ast_compound_assign(left: int, op: int, right: int): int {
  return ast_node(N_COMPOUND_ASSIGN, left, right, 0, op, 0);
}

func ast_expr_prec(min_prec: int): int {
  let left: int = ast_unary();
  if left < 0 then return (0 - 1);
  while 1 == 1 {
    if input_take(T_LBRACK) == 1 then {
      let index: int = ast_expr();
      if index < 0 then return (0 - 1);
      if input_take(T_RBRACK) == 0 then return (0 - 1);
      left = ast_node(N_INDEX, left, index, 0, 0, 0);
    } else if input_take(T_DOT) == 1 then {
      if input_peek() != T_ID then return (0 - 1);
      let field: int = input_payload();
      input_pos = input_pos + 1;
      left = ast_node(N_FIELD_ACCESS, left, 0, 0, field, 0);
    } else {
      let p: int = ast_precedence(input_peek());
      if p < min_prec then return left;
      let op_token: int = input_peek();
      input_pos = input_pos + 1;
      let right: int = ast_expr_prec(p + 1);
      if right < 0 then return (0 - 1);
      left = ast_node(N_BINOP, left, right, 0, ast_operator(op_token), 0);
    }
  }
  return left;
}

func ast_expr(): int {
  return ast_expr_prec(1);
}

func clone_for_step(step: int): int {
  return ast_node(node_kind[step], node_a[step], node_b[step], node_c[step], node_value[step], node_aux[step]);
}

func lower_for_stmt(id: int, step: int): int {
  if node_kind[id] == N_CONTINUE then {
    let s: int = clone_for_step(step);
    let c: int = ast_node(N_CONTINUE, 0, 0, 0, 0, 0);
    return ast_node(N_BLOCK, ast_link(s, c), 0, 0, 0, 0);
  }
  if node_kind[id] == N_IF then {
    let yes: int = lower_for_stmt(node_b[id], step);
    let no: int = lower_for_stmt(node_c[id], step);
    return ast_node(N_IF, node_a[id], yes, no, node_value[id], node_aux[id]);
  }
  if node_kind[id] == N_BLOCK then {
    let item: int = node_a[id];
    let out: int = 0;
    while item != 0 {
      let x: int = lower_for_stmt(item, step);
      if out == 0 then out = x; else out = ast_link(out, x);
      item = node_next[item];
    }
    return ast_node(N_BLOCK, out, 0, 0, 0, 0);
  }
  return id;
}

func ast_alignment(): int {
  if input_take(T_ALIGNAS) == 0 then return 0;
  if input_take(T_LPAREN) == 0 then return (0 - 1);
  if input_peek() != T_INT then return (0 - 1);
  let alignment: int = input_payload();
  input_pos = input_pos + 1;
  if alignment < 1 then return (0 - 1);
  let power: int = 1;
  while power < alignment {
    if power > 1073741824 then return (0 - 1);
    power = power * 2;
  }
  if power != alignment then return (0 - 1);
  if input_take(T_RPAREN) == 0 then return (0 - 1);
  return alignment;
}

func ast_stmt(): int {
  if input_take(T_DEFER) == 1 then {
    let cleanup: int = ast_expr();
    if cleanup < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_DEFER, cleanup, 0, 0, 0, 0);
  }
  if input_take(T_MATCH) == 1 then {
    let subject: int = ast_expr();
    if subject < 0 then return (0 - 1);
    if input_take(T_LBRACE) == 0 then return (0 - 1);
    let arms: int = 0;
    while input_peek() != T_RBRACE {
      if input_peek() == T_EOF || input_peek() != T_ID then return (0 - 1);
      let variant: int = input_payload(); input_pos = input_pos + 1;
      let is_default: int = ast_is_match_default(variant);
      if is_default == 1 then variant = 0;
      let bindings: int = 0;
      if input_take(T_LPAREN) == 1 then {
        if is_default == 1 then return (0 - 1);
        if input_peek() != T_ID then return (0 - 1);
        let binding_name: int = input_payload(); input_pos = input_pos + 1;
        bindings = ast_node(N_VAR, 0, 0, 0, binding_name, 0);
        if input_take(T_COMMA) == 1 then {
          if input_peek() != T_ID then return (0 - 1);
          let second_binding_name: int = input_payload(); input_pos = input_pos + 1;
          let second_binding: int = ast_node(N_VAR, 0, 0, 0, second_binding_name, 0);
          bindings = ast_link(bindings, second_binding);
        }
        if input_take(T_RPAREN) == 0 then return (0 - 1);
      }
      if input_take(T_FATARROW) == 0 then return (0 - 1);
      let body: int = ast_stmt();
      if body < 0 then return (0 - 1);
      let arm: int = ast_node(N_MATCH_ARM, bindings, body, 0, variant, 0);
      if arms == 0 then arms = arm; else arms = ast_link(arms, arm);
    }
    if input_take(T_RBRACE) == 0 then return (0 - 1);
    return ast_node(N_MATCH, subject, arms, 0, 0, 0);
  }
  if input_take(T_BREAK) == 1 then {
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_BREAK, 0, 0, 0, 0, 0);
  }
  if input_take(T_CONTINUE) == 1 then {
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_CONTINUE, 0, 0, 0, 0, 0);
  }
  if input_take(T_LET) == 1 then {
    if input_take(T_LPAREN) == 1 then {
      let bindings: int = 0;
      let binding_count: int = 0;
      if input_peek() != T_ID then return (0 - 1);
      while 1 == 1 {
        let binding_name: int = input_payload(); input_pos = input_pos + 1;
        let binding: int = ast_node(N_VAR, 0, 0, 0, binding_name, 0);
        if bindings == 0 then bindings = binding; else bindings = ast_link(bindings, binding);
        binding_count = binding_count + 1;
        if input_take(T_COMMA) == 0 then break;
        if input_peek() != T_ID then return (0 - 1);
      }
      if binding_count < 2 then return (0 - 1);
      if input_take(T_RPAREN) == 0 then return (0 - 1);
      if input_take(T_COLON) == 0 then return (0 - 1);
      let tuple_ty: int = ast_type();
      if tuple_ty == 0 then return (0 - 1);
      if input_take(T_EQUAL) == 0 then return (0 - 1);
      let tuple_value: int = ast_expr();
      if tuple_value < 0 then return (0 - 1);
      if input_take(T_SEMI) == 0 then return (0 - 1);
      return ast_node(N_TUPLE_BIND, bindings, tuple_ty, tuple_value, 0, 0);
    }
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload();
    input_pos = input_pos + 1;
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ty: int = ast_type();
    if ty == 0 then return (0 - 1);
    let alignment: int = ast_alignment();
    if alignment < 0 then return (0 - 1);
    if input_take(T_EQUAL) == 0 then return (0 - 1);
    let value: int = ast_expr();
    if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_LET, name, ty, value, 0, alignment);
  }
  if input_take(T_PRINT) == 1 then {
    let value: int = ast_expr();
    if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_PRINT, value, 0, 0, 0, 0);
  }
  if input_take(T_PRINTLN) == 1 then {
    let value: int = ast_expr();
    if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_PRINTLN, value, 0, 0, 0, 0);
  }
  if input_take(T_IF) == 1 then {
    let cond: int = ast_expr();
    if cond < 0 then return (0 - 1);
    if input_take(T_THEN) == 0 then return (0 - 1);
    let yes: int = ast_stmt();
    if yes < 0 then return (0 - 1);
    let no: int = 0;
    if input_take(T_ELSE) == 1 then {
      no = ast_stmt();
      if no < 0 then return (0 - 1);
    } else {
      no = ast_node(N_BLOCK, 0, 0, 0, 0, 0);
    }
    return ast_node(N_IF, cond, yes, no, 0, 0);
  }
  if input_take(T_FOR) == 1 then {
    if input_take(T_LPAREN) == 0 then return (0 - 1);
    let init: int = 0;
    if input_peek() != T_SEMI then {
      if input_take(T_LET) == 1 then {
        if input_peek() != T_ID then return (0 - 1);
        let n: int = input_payload(); input_pos = input_pos + 1;
        if input_take(T_COLON) == 0 then return (0 - 1);
        let t: int = ast_type();
        if t == 0 then return (0 - 1);
        let alignment: int = ast_alignment();
        if alignment < 0 then return (0 - 1);
        if input_take(T_EQUAL) == 0 then return (0 - 1);
        let v: int = ast_expr();
        init = ast_node(N_LET, n, t, v, 0, alignment);
      } else {
        let l: int = ast_expr();
        if l < 0 then return (0 - 1);
        if input_take(T_EQUAL) == 1 then {
          let r: int = ast_expr();
          init = ast_node(N_ASSIGN, l, r, 0, 0, 0);
        } else {
          let cop: int = ast_take_compound_operator();
          if cop == 0 then return (0 - 1);
          let r: int = ast_expr();
          init = ast_compound_assign(l, cop, r);
        }
      }
    }
    if input_take(T_SEMI) == 0 then return (0 - 1);
    let cond: int = ast_expr();
    if input_take(T_SEMI) == 0 then return (0 - 1);
    let step: int = 0;
    if input_peek() != T_RPAREN then {
      let l: int = ast_expr();
      if l < 0 then return (0 - 1);
        if input_take(T_EQUAL) == 1 then {
          let r: int = ast_expr();
          step = ast_node(N_ASSIGN, l, r, 0, 0, 0);
        } else {
          let cop: int = ast_take_compound_operator();
          if cop != 0 then {
            let r: int = ast_expr();
            step = ast_compound_assign(l, cop, r);
          } else step = ast_node(N_EXPR, l, 0, 0, 0, 0);
        }
    } else step = ast_node(N_BLOCK, 0, 0, 0, 0, 0);
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_LBRACE) == 0 then return (0 - 1);
    for_step_context = step;
    let items: int = 0;
    while input_peek() != T_RBRACE {
      if input_peek() == T_EOF then return (0 - 1);
      let x: int = ast_stmt();
      if x < 0 then return (0 - 1);
      if items == 0 then items = x; else items = ast_link(items, x);
    }
    if input_take(T_RBRACE) == 0 then return (0 - 1);
    for_step_context = 0;
    let body: int = ast_node(N_BLOCK, items, 0, 0, 0, 0);
    return ast_node(N_FOR, init, cond, body, step, 0);
  }
  if input_take(T_WHILE) == 1 then {
    let cond: int = ast_expr();
    if cond < 0 then return (0 - 1);
    if input_take(T_LBRACE) == 0 then return (0 - 1);
    let items: int = 0;
    while input_peek() != T_RBRACE {
      if input_peek() == T_EOF then return (0 - 1);
      let item: int = ast_stmt();
      if item < 0 then return (0 - 1);
      if items == 0 then items = item; else items = ast_link(items, item);
    }
    if input_take(T_RBRACE) == 0 then return (0 - 1);
    let body: int = ast_node(N_BLOCK, items, 0, 0, 0, 0);
    return ast_node(N_WHILE, cond, body, 0, 0, 0);
  }
  if input_take(T_LBRACE) == 1 then {
    let items: int = 0;
    while input_peek() != T_RBRACE {
      if input_peek() == T_EOF then return (0 - 1);
      let item: int = ast_stmt();
      if item < 0 then return (0 - 1);
      if items == 0 then items = item; else items = ast_link(items, item);
    }
    if input_take(T_RBRACE) == 0 then return (0 - 1);
    return ast_node(N_BLOCK, items, 0, 0, 0, 0);
  }
  if input_take(T_RETURN) == 1 then {
    let value: int = 0;
    if input_peek() != T_SEMI then {
      value = ast_expr();
      if value < 0 then return (0 - 1);
    }
    if input_take(T_SEMI) == 0 then return (0 - 1);
    let return_stmt: int = ast_node(N_RETURN, value, 0, 0, 0, 0);
    if value != 0 then node_pos[return_stmt] = node_pos[value];
    return return_stmt;
  }
  let left: int = ast_expr();
  if left < 0 then return (0 - 1);
  if input_take(T_EQUAL) == 1 then {
    let right: int = ast_expr();
    if right < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_ASSIGN, left, right, 0, 0, 0);
  }
  let compound_op: int = ast_take_compound_operator();
  if compound_op != 0 then {
    let right_compound: int = ast_expr();
    if right_compound < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_compound_assign(left, compound_op, right_compound);
  }
  if input_take(T_SEMI) == 0 then return (0 - 1);
  return ast_node(N_EXPR, left, 0, 0, 0, 0);
}

func ast_params(): int {
  let params: int = 0;
  if input_peek() == T_RPAREN then return 0;
  while 1 == 1 {
    let mode: int = 0;
    if input_take(T_MOVE) == 1 then mode = 1;
    else if input_take(T_BORROW) == 1 then mode = 2;
    else if input_take(T_BORROW_MUT) == 1 then mode = 3;
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload();
    input_pos = input_pos + 1;
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ty: int = ast_type();
    if ty == 0 then return (0 - 1);
    let param: int = ast_node(N_PARAM, name, ty, 0, 0, mode);
    if params == 0 then params = param; else params = ast_link(params, param);
    if input_take(T_COMMA) == 0 then return params;
  }
}

func ast_struct_decl(): int {
  if input_peek() != T_ID then return (0 - 1);
  let name: int = input_payload(); input_pos = input_pos + 1;
  name = ast_decl_name(name);
  let params: int = 0;
  let old_scope: int = ast_generic_scope;
  if input_peek() == T_LT then {
    params = ast_generic_params();
    if params < 0 then return (0 - 1);
    ast_generic_scope = params;
  }
  if input_take(T_LBRACE) == 0 then return (0 - 1);
  let fields: int = 0;
  while input_peek() != T_RBRACE {
    if input_peek() == T_EOF then return (0 - 1);
    if input_peek() != T_ID then return (0 - 1);
    let field_name: int = input_payload(); input_pos = input_pos + 1;
    if input_take(T_COLON) == 0 then return (0 - 1);
    let field_type: int = ast_type();
    if field_type == 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    let field: int = ast_node(N_FIELD, field_name, field_type, 0, 0, 0);
    if fields == 0 then fields = field; else fields = ast_link(fields, field);
  }
  if input_take(T_RBRACE) == 0 then return (0 - 1);
  if input_take(T_SEMI) == 1 then { }
  ast_generic_scope = old_scope;
  if params == 0 then return ast_node(N_STRUCT, fields, 0, 0, name, 0);
  return ast_node(N_GENERIC_STRUCT, fields, 0, params, name, 0);
}

func ast_enum_decl(): int {
  if input_peek() != T_ID then return (0 - 1);
  let name: int = input_payload(); input_pos = input_pos + 1;
  name = ast_decl_name(name);
  if input_take(T_LBRACE) == 0 then return (0 - 1);
  let values: int = 0;
  let ordinal: int = 0;
  while input_peek() != T_RBRACE {
    if input_peek() == T_EOF then return (0 - 1);
    if input_peek() != T_ID then return (0 - 1);
    let member: int = input_payload(); input_pos = input_pos + 1;
    let payload: int = 0;
    if input_take(T_LBRACE) == 1 then {
      while input_peek() != T_RBRACE {
        if input_peek() == T_EOF || input_peek() != T_ID then return (0 - 1);
        let field_name: int = input_payload(); input_pos = input_pos + 1;
        if input_take(T_COLON) == 0 then return (0 - 1);
        let field_type: int = ast_type();
        if field_type == 0 || input_take(T_SEMI) == 0 then return (0 - 1);
        let field: int = ast_node(N_FIELD, field_name, field_type, 0, 0, 0);
        if payload == 0 then payload = field; else payload = ast_link(payload, field);
      }
      if input_take(T_RBRACE) == 0 then return (0 - 1);
    }
    let item: int = ast_node(N_FIELD, member, payload, 0, ordinal, 0);
    if values == 0 then values = item; else values = ast_link(values, item);
    ordinal = ordinal + 1;
    if input_take(T_COMMA) == 0 then { }
  }
  if input_take(T_RBRACE) == 0 then return (0 - 1);
  if input_take(T_SEMI) == 1 then { }
  return ast_node(N_ENUM, values, 0, 0, name, 0);
}

func ast_namespace_decl(): int {
  if input_peek() != T_ID && input_peek() != T_ARRAY then return (0 - 1);
  let raw: int = input_payload(); input_pos = input_pos + 1;
  let ns: int = raw;
  if ast_namespace_scope != 0 then ns = sym_qualified(ast_namespace_scope, raw);
  if input_take(T_LBRACE) == 0 then return (0 - 1);
  let old_ns: int = ast_namespace_scope;
  ast_namespace_scope = ns;
  let items: int = 0;
  while input_peek() != T_RBRACE {
    if input_peek() == T_EOF then { ast_namespace_scope = old_ns; return (0 - 1); }
    let item: int = ast_decl();
    if item < 0 then { ast_namespace_scope = old_ns; return (0 - 1); }
    if items == 0 then items = item; else items = ast_link(items, item);
  }
  if input_take(T_RBRACE) == 0 then { ast_namespace_scope = old_ns; return (0 - 1); }
  if input_take(T_SEMI) == 1 then { }
  ast_namespace_scope = old_ns;
  return ast_node(N_LIST, items, 0, 0, 0, 0);
}

func ast_decl(): int {
  if input_take(T_NAMESPACE) == 1 then return ast_namespace_decl();
  if input_take(T_EXTERN) == 1 then {
    let header_id: int = 0;
    if input_peek() == T_STRING then {
      header_id = input_payload();
      input_pos = input_pos + 1;
    }
    if input_take(T_FUNC) == 0 then return (0 - 1);
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload(); input_pos = input_pos + 1;
    name = ast_decl_name(name);
    if input_take(T_LPAREN) == 0 then return (0 - 1);
    let params: int = ast_params();
    if params < 0 then return (0 - 1);
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ret_ty: int = ast_type();
    if ret_ty == 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_EXTERN, header_id, ret_ty, params, name, node_kind[ret_ty]);
  }
  if input_take(T_CONST) == 1 then {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload(); input_pos = input_pos + 1;
    name = ast_decl_name(name);
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ty: int = ast_type(); if ty == 0 then return (0 - 1);
    let alignment: int = ast_alignment();
    if alignment < 0 then return (0 - 1);
    if input_take(T_EQUAL) == 0 then return (0 - 1);
    let value: int = ast_expr(); if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    let const_value: int = ast_const_eval(value);
    if node_kind[ty] == TY_INT && const_value >= 0 then ast_const_add(name, const_value);
    return ast_node(N_CONST, name, ty, value, 0, alignment);
  }
  if input_take(T_STRUCT) == 1 then return ast_struct_decl();
  if input_take(T_ENUM) == 1 then return ast_enum_decl();
  if input_take(T_LET) == 1 then {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload();
    input_pos = input_pos + 1;
    name = ast_decl_name(name);
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ty: int = ast_type();
    if ty == 0 then return (0 - 1);
    let alignment: int = ast_alignment();
    if alignment < 0 then return (0 - 1);
    if input_take(T_EQUAL) == 0 then return (0 - 1);
    let value: int = ast_expr();
    if value < 0 then return (0 - 1);
    if input_take(T_SEMI) == 0 then return (0 - 1);
    return ast_node(N_GLOBAL, name, ty, value, 0, alignment);
  }
  if input_take(T_FUNC) == 1 then {
    if input_peek() != T_ID then return (0 - 1);
    let name: int = input_payload();
    input_pos = input_pos + 1;
    name = ast_decl_name(name);
    let generic_params: int = 0;
    let old_scope: int = ast_generic_scope;
    if input_peek() == T_LT then {
      generic_params = ast_generic_params();
      if generic_params < 0 then return (0 - 1);
      ast_generic_scope = generic_params;
    }
    if input_take(T_LPAREN) == 0 then return (0 - 1);
    let params: int = ast_params();
    if params < 0 then return (0 - 1);
    if input_take(T_RPAREN) == 0 then return (0 - 1);
    if input_take(T_COLON) == 0 then return (0 - 1);
    let ret_ty: int = ast_type();
    if ret_ty == 0 then return (0 - 1);
    let body: int = ast_stmt();
    if body < 0 then return (0 - 1);
    ast_generic_scope = old_scope;
    if generic_params == 0 then return ast_node(N_FUNC, body, ret_ty, params, name, node_kind[ret_ty]);
    return ast_node(N_GENERIC_FUNC, body, ret_ty, params, name, generic_params);
  }
  return (0 - 1);
}

func ast_flatten_decl_list(item: int): int {
  let head: int = 0;
  let tail: int = 0;
  let p: int = item;
  while p != 0 {
    let next: int = node_next[p];
    node_next[p] = 0;
    let part: int = p;
    if node_kind[p] == N_LIST then part = ast_flatten_decl_list(node_a[p]);
    if part != 0 then {
      if head == 0 then { head = part; tail = part; }
      else { node_next[tail] = part; }
      while node_next[tail] != 0 { tail = node_next[tail]; }
    }
    p = next;
  }
  return head;
}

func ast_program(): int {
  let items: int = 0;
  while input_peek() != T_EOF {
    let item: int = ast_decl();
    if item < 0 then return (0 - 1);
    let flat: int = 0;
    if node_kind[item] == N_LIST then flat = ast_flatten_decl_list(node_a[item]);
    else flat = item;
    if flat != 0 then {
      if items == 0 then items = flat;
      else {
        let tail: int = items;
        while node_next[tail] != 0 { tail = node_next[tail]; }
        node_next[tail] = flat;
      }
    }
  }
  return ast_node(N_PROGRAM, items, 0, 0, 0, 0);
}

