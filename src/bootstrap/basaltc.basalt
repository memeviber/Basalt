  code_emit(C_PUNCT, 17); code_emit(C_IDENT, gen_closure_name(0, "env")); code_emit(C_PUNCT, 11); code_emit(C_IDENT, gen_closure_env_local_name(serial));
  code_emit(C_PUNCT, 7); code_emit(C_PUNCT, 17); code_emit(C_IDENT, gen_closure_name(0, "fn")); code_emit(C_PUNCT, 11); code_emit(C_IDENT, gen_closure_invoke_name(serial));
  code_emit(C_PUNCT, 25); code_emit(C_PUNCT, 12); code_emit(C_PUNCT, 14); code_emit(C_NEWLINE, 0);
}
func gen_closure_emit_invoke(serial: int, closure_id: int): void {
  let sig_invoke: int = gen_closure_signature(closure_id);
  let ret_invoke: int = node_b[sig_invoke];
  gen_type(node_kind[ret_invoke], ret_invoke, node_value[ret_invoke]); code_emit(C_IDENT, gen_closure_invoke_name(serial)); code_emit(C_PUNCT, 6);
  code_emit(C_KW, 4); code_emit(C_PUNCT, 1); code_emit(C_IDENT, gen_closure_env_param_name(serial));
  let param_invoke: int = node_c[closure_id];
  if param_invoke != 0 then code_emit(C_PUNCT, 7);
  while param_invoke != 0 { gen_decl(node_b[param_invoke], node_a[param_invoke]); if node_next[param_invoke] != 0 then code_emit(C_PUNCT, 7); param_invoke = node_next[param_invoke]; }
  code_emit(C_PUNCT, 8); code_emit(C_PUNCT, 13);
  code_emit(C_KW, 12); code_emit(C_IDENT, gen_closure_env_name(serial)); code_emit(C_PUNCT, 1); code_emit(C_IDENT, gen_closure_env_local_name(serial)); code_emit(C_PUNCT, 11); code_emit(C_PUNCT, 4); code_emit(C_KW, 12); code_emit(C_IDENT, gen_closure_env_name(serial)); code_emit(C_PUNCT, 1); code_emit(C_PUNCT, 5); code_emit(C_IDENT, gen_closure_env_param_name(serial)); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0);
  let cap_invoke: int = node_a[closure_id];
  if cap_invoke == 0 then {
    code_emit(C_PUNCT, 4); code_emit(C_KW, 4); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 4); code_emit(C_IDENT, gen_closure_env_local_name(serial)); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0);
  }
  while cap_invoke != 0 {
    if node_aux[cap_invoke] == 1 then {
      gen_type(node_kind[node_b[cap_invoke]], node_b[cap_invoke], node_value[node_b[cap_invoke]]); code_emit(C_IDENT, sym_c_symbol(node_a[cap_invoke])); code_emit(C_PUNCT, 11); code_emit(C_IDENT, gen_closure_env_local_name(serial)); code_emit(C_PUNCT, 27); code_emit(C_IDENT, sym_c_symbol(node_a[cap_invoke])); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0);
    }
    cap_invoke = node_next[cap_invoke];
  }
  let old_active_closure_emit: int = gen_active_closure;
  let old_active_function_emit: int = gen_active_function;
  gen_active_closure = closure_id; gen_active_function = closure_id;
  gen_stmt(node_b[closure_id]);
  code_emit(C_PUNCT, 14);
  gen_active_function = old_active_function_emit; gen_active_closure = old_active_closure_emit;
}
func gen_closure_emit_all(): void {
  let closure_i: int = 0;
  while closure_i < gen_closure_count { gen_closure_emit_value(gen_closure_node[closure_i]); closure_i = closure_i + 1; }
  closure_i = 0;
  while closure_i < gen_closure_count { gen_closure_emit_env(gen_closure_serial[closure_i], gen_closure_node[closure_i]); closure_i = closure_i + 1; }
  closure_i = 0;
  while closure_i < gen_closure_count { gen_closure_emit_invoke_prototype(gen_closure_serial[closure_i], gen_closure_node[closure_i]); closure_i = closure_i + 1; }
  closure_i = 0;
  while closure_i < gen_closure_count {
    let helper_seen: int = 0;
    let helper_scan: int = 0;
    while helper_scan < closure_i {
      if gen_closure_value_type_name[helper_scan] == gen_closure_value_type_name[closure_i] then helper_seen = 1;
      helper_scan = helper_scan + 1;
    }
    if helper_seen == 0 then gen_closure_emit_call_helper(gen_closure_sig[closure_i]);
    closure_i = closure_i + 1;
  }
  closure_i = 0;
  while closure_i < gen_closure_count { gen_closure_emit_factory(gen_closure_serial[closure_i], gen_closure_node[closure_i]); closure_i = closure_i + 1; }
  closure_i = 0;
  while closure_i < gen_closure_count { gen_closure_emit_invoke(gen_closure_serial[closure_i], gen_closure_node[closure_i]); closure_i = closure_i + 1; }
}

func gen_program(id: int): void {
  let gen_saved_node_count: int = node_count;
  gen_source_pos = 0;
  gen_source_epoch = 0;
  gen_match_serial = 0;
  gen_closure_count = 0;
  gen_closure_serial_next = 0;
  gen_tuple_count = 0;
  ffi_header_count = 0;
  code_reset(); gen_spec_count = 0; gen_name_override = 0; emit_defer_count = 0; emit_scope_depth = 0; emit_loop_depth = 0;
  let item: int = node_a[id];
  while item != 0 {
    if node_kind[item] == N_EXTERN then {
      if node_a[item] != 0 then ffi_header_register(node_a[item]);
    }
    if node_kind[item] == N_GLOBAL || node_kind[item] == N_CONST then gen_collect_stmt(item);
    else if node_kind[item] == N_STRUCT then {
      let sf: int = node_a[item];
      while sf != 0 { gen_collect_type(node_b[sf]); sf = node_next[sf]; }
    }
    else if node_kind[item] == N_FUNC then {
      gen_collect_type(node_b[item]);
      let pp: int = node_c[item]; while pp != 0 { gen_collect_type(node_b[pp]); pp = node_next[pp]; }
      gen_collect_stmt(node_a[item]);
    }
    item = node_next[item];
  }
  let tuple_i: int = 0;
  while tuple_i < gen_tuple_count {
    gen_tuple_decl(gen_tuple_type[tuple_i], gen_tuple_name[tuple_i]);
    tuple_i = tuple_i + 1;
  }
  // Rescan each discovered generic function instance until nested calls reach a fixed point.
  let scan_si: int = 0;
  while scan_si < gen_spec_count {
    if gen_spec_kind[scan_si] == 2 then {
      let scan_decl: int = gen_spec_decl[scan_si];
      let old_active_scan: int = gen_active_function;
      gen_bind_decl(scan_decl, gen_spec_type[scan_si]);
      gen_active_function = scan_decl;
      gen_collect_stmt(node_a[scan_decl]);
      gen_active_function = old_active_scan;
      gen_bind_clear();
    }
    scan_si = scan_si + 1;
  }
  // Forward declarations must follow the generic fixed-point scan because
  // nested generic calls can discover additional concrete struct instances.
  item = node_a[id];
  while item != 0 {
    if node_kind[item] == N_STRUCT then {
      code_emit(C_KW, 14); code_emit(C_KW, 12); code_emit(C_IDENT, sym_c_symbol(node_value[item])); code_emit(C_PUNCT, 22); code_emit(C_IDENT, sym_c_symbol(node_value[item])); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0);
    }
    item = node_next[item];
  }
  let si: int = 0;
  while si < gen_spec_count { if gen_spec_kind[si] == 1 then { code_emit(C_KW, 14); code_emit(C_KW, 12); code_emit(C_IDENT, gen_spec_name[si]); code_emit(C_PUNCT, 22); code_emit(C_IDENT, gen_spec_name[si]); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0); } si = si + 1; }
  gen_closure_emit_all();
  // Definitions for ordinary and specialized structs in dependency order.
  ensure_gen_struct_state(node_count + 1);
  ensure_gen_spec_state(gen_spec_count);
  let reset_struct: int = 0;
  while reset_struct < gen_struct_state_cap { gen_struct_state[reset_struct] = 0; reset_struct = reset_struct + 1; }
  let reset_spec: int = 0;
  while reset_spec < gen_spec_count { gen_spec_state[reset_spec] = 0; reset_spec = reset_spec + 1; }
  item = node_a[id];
  while item != 0 { if node_kind[item] == N_STRUCT then gen_emit_complete_struct(item); else if node_kind[item] == N_ENUM then gen_enum_decl(item); item = node_next[item]; }
  si = 0; while si < gen_spec_count { if gen_spec_kind[si] == 1 then gen_emit_complete_spec(si); si = si + 1; }
  // Prototypes for ordinary functions, externs and all generic specializations.
  item = node_a[id];
  while item != 0 { if node_kind[item] == N_FUNC || node_kind[item] == N_EXTERN then gen_prototype(item); item = node_next[item]; }
  si = 0; while si < gen_spec_count { if gen_spec_kind[si] == 2 then { gen_bind_decl(gen_spec_decl[si], gen_spec_type[si]); gen_function_signature_parts(node_b[gen_spec_decl[si]], gen_spec_name[si], node_c[gen_spec_decl[si]], 0); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0); gen_bind_clear(); } si = si + 1; }
  item = node_a[id]; while item != 0 { if node_kind[item] == N_GLOBAL || node_kind[item] == N_CONST then gen_stmt(item); item = node_next[item]; }
  si = 0; while si < gen_spec_count { if gen_spec_kind[si] == 2 then gen_function_specialized(gen_spec_decl[si], gen_spec_type[si], gen_spec_name[si]); si = si + 1; }
  item = node_a[id]; while item != 0 { if node_kind[item] == N_FUNC then gen_function(item); item = node_next[item]; }
  node_count = gen_saved_node_count;
}

// Regression: build `int main() { print (2 + 3); return 0; }`, generate the
// token IR twice, and compare every emitted token. Expected output is 1.
func build_regression_ast(): int {
  node_count = 1;
  payload_count = 1;
  let two: int = ast_node(N_INT, 0, 0, 0, 2, 0);
  let three: int = ast_node(N_INT, 0, 0, 0, 3, 0);
  let sum: int = ast_node(N_BINOP, two, three, 0, OP_ADD, 0);
  let print_stmt: int = ast_node(N_PRINT, sum, 0, 0, 0, 0);
  let zero: int = ast_node(N_INT, 0, 0, 0, 0, 0);
  let ret: int = ast_node(N_RETURN, zero, 0, 0, 0, 0);
  let body_items: int = ast_link(print_stmt, ret);
  let body: int = ast_node(N_BLOCK, body_items, 0, 0, 0, 0);
  let main_fn: int = ast_node(N_FUNC, body, 0, 0, 1, TY_INT);
  return ast_node(N_PROGRAM, main_fn, 0, 0, 0, 0);
}

func generator_regression_main(): void {
  let program: int = build_regression_ast();
  gen_program(program);
  let first_count: int = code_count;
  ensure_snapshot(first_count);
  let i: int = 0;
  while i < first_count {
    snapshot_kind[i] = code_kind[i];
    snapshot_value[i] = code_value[i];
    i = i + 1;
  }
  gen_program(program);
  let same: int = 1;
  i = 0;
  if code_count != first_count then same = 0;
  while i < first_count {
    if code_kind[i] != snapshot_kind[i] then same = 0;
    if code_value[i] != snapshot_value[i] then same = 0;
    i = i + 1;
  }
  if same == 1 then { runtime_write_string("generator_regression: PASS"); runtime_write_char('\n'); } else { runtime_write_string("generator_regression: FAIL"); runtime_write_char('\n'); }
}


