let OP_LE: int = 30;
let OP_GE: int = 31;
let TY_INT: int = 1;
let TY_BOOL: int = 2;
let TY_STRING: int = 3;
let TY_VOID: int = 4;
let TY_PTR: int = 5;
let TY_ARRAY: int = 6;
let TY_NAMED: int = 7;
let TY_CHAR: int = 8;
let TY_FLOAT: int = 9;
let TY_DOUBLE: int = 10;
let TY_FUN: int = 11;
let TY_DYN_ARRAY: int = 13;
let TY_PARAM: int = 14;
let TY_GENERIC: int = 15;
let TY_LONG: int = 16;
let TY_LLONG: int = 17;
let TY_VARIANT: int = 18;
let TY_U8: int = 19;
let TY_U16: int = 20;
let TY_U32: int = 21;
let TY_U64: int = 22;
let TY_I8: int = 23;
let TY_I16: int = 24;
let TY_I32: int = 25;
let TY_I64: int = 26;
let TY_USIZE: int = 27;
let TY_TUPLE: int = 28;
let TY_CLOSURE: int = 29;

let node_kind: int* = 0;
let node_a: int* = 0;
let node_b: int* = 0;
let node_c: int* = 0;
let node_next: int* = 0;
let node_value: int* = 0;
let node_aux: int* = 0;
let node_pos: int* = 0;
let node_scope: int* = 0;
let node_type: int* = 0;
let ast_parse_mode: int = 0;
let node_count: int = 1;
let ast_namespace_scope: int = 0;
let ast_const_name: int* = 0;
let ast_const_value: int* = 0;
let ast_const_count: int = 0;
let ast_const_cap: int = 0;
let sym_tag_name: int = 0;


let node_cap: int = 0;
let payload_cap: int = 0;
let current_source_pos: int = 0;
let code_cap: int = 0;
let pipeline_root: int = 0;
let input_cap: int = 0;
let source_cap: int = 0;
let c_source_cap: int = 0;
let sym_cap: int = 0;
let source_file_at: int* = 0;
let source_line_at: int* = 0;
let source_file_name_start: int* = 0;
let source_file_name_len: int* = 0;
let source_file_name_text: int* = 0;
let source_file_count: int = 1;
let source_file_cap: int = 0;
let source_file_name_text_len: int = 0;
let source_file_name_text_cap: int = 0;
let source_active_file: int = 0;
let source_active_line: int = 1;
let source_dep_from: int* = 0;
let source_dep_to: int* = 0;
let source_dep_cap: int = 0;
let source_dep_count: int = 0;
let source_import_error_kind: int = 0;
let source_import_error_file: int = 0;
let source_import_error_target: int = 0;
let source_import_error_line: int = 1;
let tc_diag_ascii: string = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
let gen_source_pos: int = 0;
let gen_source_epoch: int = 0;
let emit_pending_space: int = 0;
// Source mapping is enabled by default; the CLI can disable it with --no-line.
let emit_line_directives: int = 1;
let ffi_header_ids: int* = 0;
let ffi_header_count: int = 0;
let ffi_header_cap: int = 0;

func next_capacity(old: int, need: int): int {
  let n: int = old;
  if n < 16 then n = 16;
  while n < (need + 1) { n = n * 2; }
  return n;
}

func ensure_node(need: int): void {
  if need < node_cap then return;
  let n: int = next_capacity(node_cap, need);
  node_kind = grow_ints(node_kind, node_cap, n);
  node_a = grow_ints(node_a, node_cap, n);
  node_b = grow_ints(node_b, node_cap, n);
  node_c = grow_ints(node_c, node_cap, n);
  node_next = grow_ints(node_next, node_cap, n);
  node_value = grow_ints(node_value, node_cap, n);
  node_aux = grow_ints(node_aux, node_cap, n);
  node_pos = grow_ints(node_pos, node_cap, n);
  node_scope = grow_ints(node_scope, node_cap, n);
  node_type = grow_ints(node_type, node_cap, n);
  node_cap = n;
}

func ensure_payload(need: int): void {
  if need < payload_cap then return;
  let n: int = next_capacity(payload_cap, need);
  payload_int = grow_ints(payload_int, payload_cap, n);
  payload_name = grow_ints(payload_name, payload_cap, n);
  payload_string = grow_ints(payload_string, payload_cap, n);
  payload_cap = n;
}

func ensure_code(need: int): void {
  if need < code_cap then return;
  let n: int = next_capacity(code_cap, need);
  code_kind = grow_ints(code_kind, code_cap, n);
  code_value = grow_ints(code_value, code_cap, n);
  code_pos = grow_ints(code_pos, code_cap, n);
  code_epoch = grow_ints(code_epoch, code_cap, n);
  code_cap = n;
}

func ensure_input(need: int): void {
  if need < input_cap then return;
  let n: int = next_capacity(input_cap, need);
  input_kind = grow_ints(input_kind, input_cap, n);
  input_value = grow_ints(input_value, input_cap, n);
  input_text = grow_ints(input_text, input_cap, n);
  input_source_pos = grow_ints(input_source_pos, input_cap, n);
  input_cap = n;
}

func ensure_source(need: int): void {
  if need < source_cap then return;
  let n: int = next_capacity(source_cap, need);
  source = grow_ints(source, source_cap, n);
  source_file_at = grow_ints(source_file_at, source_cap, n);
  source_line_at = grow_ints(source_line_at, source_cap, n);
  source_cap = n;
}

func ensure_sym(need: int): void {
  if need < sym_cap then return;
  let n: int = next_capacity(sym_cap, need);
  sym_start = grow_ints(sym_start, sym_cap, n);
  sym_len = grow_ints(sym_len, sym_cap, n);
  sym_hash = grow_ints(sym_hash, sym_cap, n);
  sym_kind = grow_ints(sym_kind, sym_cap, n);
  sym_type = grow_ints(sym_type, sym_cap, n);
  sym_elem_kind = grow_ints(sym_elem_kind, sym_cap, n);
  sym_elem_name = grow_ints(sym_elem_name, sym_cap, n);
  sym_scope = grow_ints(sym_scope, sym_cap, n);
  sym_cap = n;
}

func ensure_ffi_headers(need: int): void {
  if need < ffi_header_cap then return;
  let n: int = next_capacity(ffi_header_cap, need);
  ffi_header_ids = grow_ints(ffi_header_ids, ffi_header_cap, n);
  ffi_header_cap = n;
}
func ffi_header_char_ok(c: int): int {
  if c > 47 then { if c < 58 then return 1; }
  if c > 64 then { if c < 91 then return 1; }
  if c > 96 then { if c < 123 then return 1; }
  if c == 46 then return 1;
  if c == 47 then return 1;
  if c == 95 then return 1;
  if c == 45 then return 1;
  return 0;
}
func ffi_header_valid(id: int): int {
  if id == 0 then return 1;
  if sym_len[id] == 0 then return 0;
  let i: int = 0;
  while i < sym_len[id] {
    if ffi_header_char_ok(source[sym_start[id] + i]) == 0 then return 0;
    i = i + 1;
  }
  return 1;
}
func ffi_header_seen(id: int): int {
  let i: int = 0;
  while i < ffi_header_count {
    if ffi_header_ids[i] == id then return 1;
    i = i + 1;
  }
  return 0;
}
func ffi_header_register(id: int): void {
  if id == 0 then return;
  if ffi_header_seen(id) == 1 then return;
  ensure_ffi_headers(ffi_header_count);
  ffi_header_ids[ffi_header_count] = id;
  ffi_header_count = ffi_header_count + 1;
}

func ast_node(kind: int, a: int, b: int, c: int, value: int, aux: int): int {
  let id: int = node_count;
  let parse_pos: int = current_source_pos;
  if ast_parse_mode == 1 && input_pos > 0 && input_pos < input_count + 1 then parse_pos = input_source_pos[input_pos - 1];
  ensure_node(id);
  node_kind[id] = kind;
  node_a[id] = a;
  node_b[id] = b;
  node_c[id] = c;
  node_next[id] = 0;
  node_value[id] = value;
  node_aux[id] = aux;
  node_pos[id] = parse_pos;
  node_scope[id] = ast_namespace_scope;
  node_type[id] = 0;
  node_count = node_count + 1;
  return id;
}

func ast_link(head: int, item: int): int {
  if head == 0 then return item;
  let p: int = head;
  while p != 0 {
    if p == item then {
      let copy: int = ast_node(node_kind[item], node_a[item], node_b[item], node_c[item], node_value[item], node_aux[item]);
      node_pos[copy] = node_pos[item];
      node_scope[copy] = node_scope[item];
      item = copy;
      break;
    }
    p = node_next[p];
  }
  p = head;
  while node_next[p] != 0 {
    p = node_next[p];
  }
  node_next[p] = item;
  return head;
}

// Payload IDs are deliberately independent from node IDs. The lexer/parser
// stores an identifier table index or string table index in node_value.
let payload_int: int* = 0;
let payload_name: int* = 0;
let payload_string: int* = 0;
let payload_count: int = 1;

func payload_make_int(value: int): int {
  let id: int = payload_count;
  ensure_payload(id);
  payload_int[id] = value;
  payload_count = payload_count + 1;
  return id;
}

func payload_make_name(name_id: int): int {
  let id: int = payload_count;
  ensure_payload(id);
  payload_name[id] = name_id;
  payload_count = payload_count + 1;
  return id;
}

func payload_make_string(string_id: int): int {
  let id: int = payload_count;
  ensure_payload(id);
  payload_string[id] = string_id;
  payload_count = payload_count + 1;
  return id;
}

// C-token IR. This is the stable boundary between AST traversal and the
// eventual text/file runtime. An emitter consumer can serialize these tokens
// to C without changing the AST or generator.
let C_KW: int = 1;
let C_IDENT: int = 2;
let C_INT: int = 3;
let C_STRING: int = 4;
let C_OP: int = 5;
let C_PUNCT: int = 6;
let C_NEWLINE: int = 7;
let C_RAW: int = 8;
let C_RAW_U64: int = 9;
let code_kind: int* = 0;
let code_value: int* = 0;
let code_pos: int* = 0;
let code_epoch: int* = 0;
let code_count: int = 0;
let emit_for_step: int = 0;
let emit_defer_expr: int* = 0;
let emit_defer_scope_start: int* = 0;
let emit_scope_start: int* = 0;
let emit_defer_count: int = 0;
let emit_defer_cap: int = 0;
let emit_scope_depth: int = 0;
let emit_scope_cap: int = 0;
let emit_loop_base: int* = 0;
let emit_loop_depth: int = 0;
let emit_loop_cap: int = 0;
// v3 regression snapshots are growable as well; no fixed 65536-token limit.
let snapshot_kind: int* = 0;
let snapshot_value: int* = 0;
let snapshot_cap: int = 0;

func ensure_snapshot(need: int): void {
  if need < snapshot_cap then return;
  let n: int = next_capacity(snapshot_cap, need);
  snapshot_kind = grow_ints(snapshot_kind, snapshot_cap, n);
  snapshot_value = grow_ints(snapshot_value, snapshot_cap, n);
  snapshot_cap = n;
}

// Snapshot buffers are global runtime-owned allocations. The generated
// runtime tracker releases them from its atexit cleanup, just like the other
// compiler arenas; local consuming-style free is intentionally not used here.
let gen_bind_name: int* = 0;
let gen_bind_type: int* = 0;
let gen_bind_count: int = 0;
let gen_bind_cap: int = 0;
let gen_active_function: int = 0;
let gen_active_closure: int = 0;
let gen_match_serial: int = 0;
let gen_tuple_type: int* = 0;
let gen_tuple_name: int* = 0;
let gen_tuple_count: int = 0;
let gen_tuple_cap: int = 0;
let gen_closure_node: int* = 0;
let gen_closure_serial: int* = 0;
let gen_closure_sig: int* = 0;
let gen_closure_value_type_name: int* = 0;
let gen_closure_count: int = 0;
let gen_closure_cap: int = 0;
let gen_closure_serial_next: int = 0;
let gen_mangle_start: int = 0;
let gen_mangle_len: int = 0;

func gen_bind_clear(): void { gen_bind_count = 0; }
func ensure_gen_bind(need: int): void {
  if need < gen_bind_cap then return;
  let n: int = next_capacity(gen_bind_cap, need);
  gen_bind_name = grow_ints(gen_bind_name, gen_bind_cap, n);
  gen_bind_type = grow_ints(gen_bind_type, gen_bind_cap, n);
  gen_bind_cap = n;
}
func gen_bind_find(name: int): int {
  let i: int = 0;
  while i < gen_bind_count { if gen_bind_name[i] == name then return gen_bind_type[i]; i = i + 1; }
  return 0;
}
func gen_bind_add(name: int, ty: int): void {
  let i: int = 0;
  while i < gen_bind_count { if gen_bind_name[i] == name then { gen_bind_type[i] = ty; return; } i = i + 1; }
  ensure_gen_bind(gen_bind_count); gen_bind_name[gen_bind_count] = name; gen_bind_type[gen_bind_count] = ty; gen_bind_count = gen_bind_count + 1;
}
func ensure_gen_tuple(need: int): void {
  if need < gen_tuple_cap then return;
  let n: int = next_capacity(gen_tuple_cap, need);
  gen_tuple_type = grow_ints(gen_tuple_type, gen_tuple_cap, n);
  gen_tuple_name = grow_ints(gen_tuple_name, gen_tuple_cap, n);
  gen_tuple_cap = n;
}
func ensure_gen_closure(need: int): void {
  if need < gen_closure_cap then return;
  let n: int = next_capacity(gen_closure_cap, need);
  gen_closure_node = grow_ints(gen_closure_node, gen_closure_cap, n);
  gen_closure_serial = grow_ints(gen_closure_serial, gen_closure_cap, n);
  gen_closure_sig = grow_ints(gen_closure_sig, gen_closure_cap, n);
  gen_closure_value_type_name = grow_ints(gen_closure_value_type_name, gen_closure_cap, n);
  gen_closure_cap = n;
}
func gen_closure_signature(id: int): int {
  let args: int = 0;
  let p: int = node_c[id];
  while p != 0 {
    let src_ty: int = node_b[p];
    let copy_ty: int = ast_node(node_kind[src_ty], node_a[src_ty], node_b[src_ty], node_c[src_ty], node_value[src_ty], node_aux[src_ty]);
    if args == 0 then args = copy_ty; else args = ast_link(args, copy_ty);
    p = node_next[p];
  }
  return ast_node(TY_CLOSURE, args, node_value[id], 0, 0, 0);
}
func gen_closure_name(serial: int, prefix: string): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0;
  gen_append_text(prefix); gen_append_uint(serial);
  return gen_mangle_intern(L_ID);
}
func gen_closure_env_name(serial: int): int { return gen_closure_name(serial, "__basalt_env_"); }
func gen_closure_invoke_name(serial: int): int { return gen_closure_name(serial, "__basalt_invoke_"); }
func gen_closure_factory_name(serial: int): int { return gen_closure_name(serial, "__basalt_make_"); }
func gen_closure_value_name(serial: int): int { return gen_closure_name(serial, "__basalt_closure_"); }
func gen_closure_register(id: int): void {
  if id == 0 then return;
  let i: int = 0;
  while i < gen_closure_count { if gen_closure_node[i] == id then return; i = i + 1; }
  ensure_gen_closure(gen_closure_count);
  let serial: int = gen_closure_serial_next;
  gen_closure_serial_next = gen_closure_serial_next + 1;
  gen_closure_node[gen_closure_count] = id;
  gen_closure_serial[gen_closure_count] = serial;
  gen_closure_sig[gen_closure_count] = gen_closure_signature(id);
  gen_closure_value_type_name[gen_closure_count] = gen_mangled_type_symbol(gen_closure_sig[gen_closure_count]);
  node_aux[id] = serial + 1;
  gen_closure_count = gen_closure_count + 1;
}
func gen_append_char(c: int): void { let pos: int = source_len + sym_text_len + gen_mangle_len; ensure_source(pos); source[pos] = c; gen_mangle_len = gen_mangle_len + 1; }
func gen_append_char_text(c: char): void { let pos: int = source_len + sym_text_len + gen_mangle_len; ensure_source(pos); source[pos] = c; gen_mangle_len = gen_mangle_len + 1; }
func gen_append_text(text: string): void { let i: int = 0; while text[i] != '\0' { gen_append_char_text(text[i]); i = i + 1; } }
func gen_append_symbol(id: int): void { let i: int = 0; while i < sym_len[id] { gen_append_char(source[sym_start[id] + i]); i = i + 1; } }
func gen_append_c_symbol(id: int): void {
  let i: int = 0;
  while i < sym_len[id] {
    let c: int = source[sym_start[id] + i];
    if c == 58 && i + 1 < sym_len[id] && source[sym_start[id] + i + 1] == 58 then { gen_append_char(95); gen_append_char(95); i = i + 2; }
    else { gen_append_char(c); i = i + 1; }
  }
}
func gen_mangle_intern(kind: int): int {
  let h: int = span_hash(gen_mangle_start, gen_mangle_len);
  let old: int = sym_lookup(gen_mangle_start, gen_mangle_len, h);
  if old != 0 then return old;
  let id: int = sym_intern(gen_mangle_start, gen_mangle_len, kind, 0);
  sym_text_len = sym_text_len + gen_mangle_len;
  return id;
}
func sym_c_symbol(id: int): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0; gen_append_c_symbol(id);
  return gen_mangle_intern(L_ID);
}
func gen_append_uint(value: int): void {
  if value > 9 then gen_append_uint(value / 10);
  gen_append_char(48 + (value % 10));
}
func gen_tuple_field_name(index: int): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0;
  gen_append_text("item"); gen_append_uint(index);
  return gen_mangle_intern(L_ID);
}
func gen_mangle_type(ty: int): void {
  if ty == 0 then { gen_append_text("void"); return; }
  if node_kind[ty] == TY_PARAM then { let b: int = gen_bind_find(node_value[ty]); if b != 0 then { gen_mangle_type(b); return; } gen_append_c_symbol(node_value[ty]); return; }
  if node_kind[ty] == TY_INT then gen_append_text("int");
  else if node_kind[ty] == TY_BOOL then gen_append_text("bool");
  else if node_kind[ty] == TY_STRING then gen_append_text("char_ptr");
  else if node_kind[ty] == TY_CHAR then gen_append_text("char");
  else if node_kind[ty] == TY_FLOAT then gen_append_text("float");
  else if node_kind[ty] == TY_DOUBLE then gen_append_text("double");
  else if node_kind[ty] == TY_U8 then gen_append_text("u8");
  else if node_kind[ty] == TY_U16 then gen_append_text("u16");
  else if node_kind[ty] == TY_U32 then gen_append_text("u32");
  else if node_kind[ty] == TY_U64 then gen_append_text("u64");
  else if node_kind[ty] == TY_I8 then gen_append_text("i8");
  else if node_kind[ty] == TY_I16 then gen_append_text("i16");
  else if node_kind[ty] == TY_I32 then gen_append_text("i32");
  else if node_kind[ty] == TY_I64 then gen_append_text("i64");
  else if node_kind[ty] == TY_USIZE then gen_append_text("usize");
  else if node_kind[ty] == TY_VOID then gen_append_text("void");
  else if node_kind[ty] == TY_NAMED then gen_append_c_symbol(node_value[ty]);
  else if node_kind[ty] == TY_PTR then { gen_append_text("ptr_"); gen_mangle_type(node_a[ty]); }
  else if node_kind[ty] == TY_ARRAY || node_kind[ty] == TY_DYN_ARRAY then { gen_append_text("array_"); gen_mangle_type(node_a[ty]);   } else if node_kind[ty] == TY_GENERIC then {
    gen_append_c_symbol(node_value[ty]); gen_append_text("__");
    let a: int = node_a[ty];
    while a != 0 { gen_mangle_type(a); if node_next[a] != 0 then gen_append_text("__"); a = node_next[a]; }
  } else if node_kind[ty] == TY_TUPLE then {
    gen_append_text("tuple");
    let t: int = node_a[ty];
    while t != 0 { gen_append_text("__"); gen_mangle_type(t); t = node_next[t]; }
  } else if node_kind[ty] == TY_CLOSURE then {
    gen_append_text("closure");
    let a: int = node_a[ty];
    while a != 0 { gen_append_text("__"); gen_mangle_type(a); a = node_next[a]; }
    gen_append_text("__ret__"); gen_mangle_type(node_b[ty]);
  } else gen_append_text("int");
}
func gen_mangled_type_symbol(ty: int): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0; gen_mangle_type(ty);
  return gen_mangle_intern(0);
}
func gen_add_tuple_type(ty: int): void {
  if ty == 0 || node_kind[ty] != TY_TUPLE then return;
  let name: int = gen_mangled_type_symbol(ty);
  let i: int = 0;
  while i < gen_tuple_count {
    if gen_tuple_name[i] == name then return;
    i = i + 1;
  }
  let item: int = node_a[ty];
  while item != 0 { gen_collect_type(item); item = node_next[item]; }
  ensure_gen_tuple(gen_tuple_count);
  gen_tuple_type[gen_tuple_count] = ty;
  gen_tuple_name[gen_tuple_count] = name;
  gen_tuple_count = gen_tuple_count + 1;
}
func gen_mangled_function_symbol(base: int, args: int): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0; gen_append_c_symbol(base); gen_append_text("__");
  let a: int = args; while a != 0 { gen_mangle_type(a); if node_next[a] != 0 then gen_append_text("__"); a = node_next[a]; }
  return gen_mangle_intern(0);
}

func code_emit(kind: int, value: int): void {
  ensure_code(code_count);
  code_kind[code_count] = kind;
  code_value[code_count] = value;
  code_pos[code_count] = gen_source_pos;
  code_epoch[code_count] = gen_source_epoch;
  code_count = code_count + 1;
}

func code_reset(): void {
  code_count = 0;
}
func ensure_emit_defer(need: int): void {
  if need < emit_defer_cap then return;
  let n: int = next_capacity(emit_defer_cap, need);
  emit_defer_expr = grow_ints(emit_defer_expr, emit_defer_cap, n);
  emit_defer_scope_start = grow_ints(emit_defer_scope_start, emit_defer_cap, n);
  emit_defer_cap = n;
}
func ensure_emit_scope(need: int): void {
  if need < emit_scope_cap then return;
  let n: int = next_capacity(emit_scope_cap, need);
  emit_scope_start = grow_ints(emit_scope_start, emit_scope_cap, n);
  emit_scope_cap = n;
}
func ensure_emit_loop(need: int): void {
  if need < emit_loop_cap then return;
  let n: int = next_capacity(emit_loop_cap, need);
  emit_loop_base = grow_ints(emit_loop_base, emit_loop_cap, n);
  emit_loop_cap = n;
}
func gen_defer_push(expr: int): void {
  ensure_emit_defer(emit_defer_count);
  emit_defer_expr[emit_defer_count] = expr;
  emit_defer_count = emit_defer_count + 1;
}
func gen_emit_defer_from(base: int): void {
  let i: int = emit_defer_count - 1;
  while i + 1 > base { gen_expr(emit_defer_expr[i]); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0); i = i - 1; }
}
func gen_emit_all_defers(): void { gen_emit_defer_from(0); }

let gen_spec_kind: int* = 0;
let gen_spec_decl: int* = 0;
let gen_spec_type: int* = 0;
let gen_spec_name: int* = 0;
let gen_spec_count: int = 0;
let gen_spec_cap: int = 0;
let gen_name_override: int = 0;
let gen_debug: int = 0;
let gen_fun_chain_type: int* = 0;
let gen_fun_chain_count: int = 0;
let gen_fun_chain_cap: int = 0;

func ensure_gen_specs(need: int): void {
  if need < gen_spec_cap then return;
  let n: int = next_capacity(gen_spec_cap, need);
  gen_spec_kind = grow_ints(gen_spec_kind, gen_spec_cap, n);
  gen_spec_decl = grow_ints(gen_spec_decl, gen_spec_cap, n);
  gen_spec_type = grow_ints(gen_spec_type, gen_spec_cap, n);
  gen_spec_name = grow_ints(gen_spec_name, gen_spec_cap, n);
  gen_spec_cap = n;
}
let gen_struct_state: int* = 0;
let gen_struct_state_cap: int = 0;
let gen_spec_state: int* = 0;
let gen_spec_state_cap: int = 0;

func ensure_gen_struct_state(need: int): void {
  if need < gen_struct_state_cap then return;
  let n: int = next_capacity(gen_struct_state_cap, need);
  gen_struct_state = grow_ints(gen_struct_state, gen_struct_state_cap, n);
  gen_struct_state_cap = n;
}
func ensure_gen_spec_state(need: int): void {
  if need < gen_spec_state_cap then return;
  let n: int = next_capacity(gen_spec_state_cap, need);
  gen_spec_state = grow_ints(gen_spec_state, gen_spec_state_cap, n);
  gen_spec_state_cap = n;
}
func gen_find_spec_index(decl: int, name: int): int {
  let i: int = 0;
  while i < gen_spec_count {
    if gen_spec_kind[i] == 1 then {
      if gen_spec_decl[i] == decl then {
        if gen_spec_name[i] == name then return i;
      }
    }
    i = i + 1;
  }
  return (0 - 1);
}

func gen_substitute_type(ty: int): int {
  if ty == 0 then return 0;
  if node_kind[ty] == TY_PARAM then { let b: int = gen_bind_find(node_value[ty]); if b != 0 && b != ty then return gen_substitute_type(b); return ast_node(TY_PARAM, node_a[ty], node_b[ty], node_c[ty], node_value[ty], node_aux[ty]); }
  if node_kind[ty] == TY_PTR then return ast_node(TY_PTR, gen_substitute_type(node_a[ty]), 0, 0, 0, 0);
  if node_kind[ty] == TY_ARRAY then return ast_node(TY_ARRAY, gen_substitute_type(node_a[ty]), 0, 0, node_value[ty], 0);
  if node_kind[ty] == TY_DYN_ARRAY then return ast_node(TY_DYN_ARRAY, gen_substitute_type(node_a[ty]), 0, 0, 0, 0);
  if node_kind[ty] == TY_GENERIC then {
    let generic_name: int = node_value[ty];
    let generic_decl: int = tc_find_struct_ctx(generic_name, node_scope[ty]);
    if generic_decl != 0 then generic_name = node_value[generic_decl];
    let args: int = 0; let p: int = node_a[ty];
    while p != 0 { let q: int = gen_substitute_type(p); if args == 0 then args = q; else args = ast_link(args, q); p = node_next[p]; }
    let result_generic: int = ast_node(TY_GENERIC, args, 0, 0, generic_name, 0);
    node_scope[result_generic] = node_scope[ty];
    return result_generic;
  }
  if node_kind[ty] == TY_FUN || node_kind[ty] == TY_CLOSURE then {
    let args2: int = 0; let p2: int = node_a[ty];
    while p2 != 0 { let q2: int = gen_substitute_type(p2); if args2 == 0 then args2 = q2; else args2 = ast_link(args2, q2); p2 = node_next[p2]; }
    return ast_node(node_kind[ty], args2, gen_substitute_type(node_b[ty]), 0, 0, 0);
  }
  return ast_node(node_kind[ty], node_a[ty], node_b[ty], node_c[ty], node_value[ty], node_aux[ty]);
}
func gen_active_closure_capture(name: int): int {
  if gen_active_closure == 0 then return 0;
  let cap_probe: int = node_a[gen_active_closure];
  while cap_probe != 0 {
    if node_a[cap_probe] == name then return cap_probe;
    cap_probe = node_next[cap_probe];
  }
  return 0;
}
func gen_closure_env_param_name(serial: int): int { return gen_closure_name(serial, "__basalt_env_arg_"); }
func gen_closure_env_local_name(serial: int): int { return gen_closure_name(serial, "__basalt_env_ptr_"); }
func gen_closure_active_env_name(): int {
  if gen_active_closure == 0 then return gen_closure_env_local_name(0);
  return gen_closure_env_local_name(node_aux[gen_active_closure] - 1);
}
func gen_closure_arg_name(index: int): int {
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0;
  gen_append_text("__basalt_arg_"); gen_append_uint(index);
  return gen_mangle_intern(L_ID);
}
func gen_closure_call_name(sig: int): int {
  let sig_name: int = gen_mangled_type_symbol(sig);
  gen_mangle_start = source_len + sym_text_len; gen_mangle_len = 0;
  gen_append_text("__basalt_call_");
  gen_append_symbol(sig_name);
  return gen_mangle_intern(L_ID);
}
func gen_active_param_type(name: int): int {
  if gen_active_function == 0 then return 0;
  let p: int = node_c[gen_active_function];
  while p != 0 {
    if node_a[p] == name then return node_b[p];
    p = node_next[p];
  }
  return 0;
}

// Generic bodies are collected before a concrete specialization is emitted.
// Their local N_VAR nodes therefore cannot rely on type-checker side metadata,
// which is shared by repeated specializations. Recover the declaration type
// from the active function body and substitute the current generic bindings.
func gen_local_decl_type(id: int, name: int): int {
  if id == 0 then return 0;
  let k: int = node_kind[id];
  if k == N_LET || k == N_CONST then {
    if node_a[id] == name then return node_b[id];
    return gen_local_decl_type(node_next[id], name);
  }
  if k == N_BLOCK then {
    let item: int = node_a[id];
    while item != 0 {
      let found: int = gen_local_decl_type(item, name);
      if found != 0 then return found;
      item = node_next[item];
    }
    return 0;
  }
  if k == N_IF then {
    let found_if: int = gen_local_decl_type(node_b[id], name);
    if found_if != 0 then return found_if;
    return gen_local_decl_type(node_c[id], name);
  }
  if k == N_WHILE then return gen_local_decl_type(node_b[id], name);
  if k == N_FOR then {
    let found_for: int = gen_local_decl_type(node_a[id], name);
    if found_for != 0 then return found_for;
    found_for = gen_local_decl_type(node_c[id], name);
    if found_for != 0 then return found_for;
    return gen_local_decl_type(node_value[id], name);
  }
  if k == N_MATCH then {
    let arm: int = node_b[id];
    while arm != 0 {
      let found_arm: int = gen_local_decl_type(node_b[arm], name);
      if found_arm != 0 then return found_arm;
      arm = node_next[arm];
    }
  }
  return gen_local_decl_type(node_next[id], name);
}
func gen_active_local_decl_type(name: int): int {
  if gen_active_function == 0 then return 0;
  return gen_local_decl_type(node_a[gen_active_function], name);
}

func gen_spec_exists(kind: int, decl: int, name: int): int {
  let i: int = 0;
  while i < gen_spec_count { if gen_spec_kind[i] == kind && gen_spec_decl[i] == decl && gen_spec_name[i] == name then return 1; i = i + 1; }
  return 0;
}
func gen_collect_struct_fields(decl: int, inst: int): void {
  let saved_count: int = gen_bind_count;
  ensure_gen_bind(saved_count + saved_count);
  let save_i: int = 0;
  while save_i < saved_count {
    gen_bind_name[saved_count + save_i] = gen_bind_name[save_i];
    gen_bind_type[saved_count + save_i] = gen_bind_type[save_i];
    save_i = save_i + 1;
  }
  gen_bind_decl(decl, inst);
  let field: int = node_a[decl];
  while field != 0 {
    let field_type: int = gen_substitute_type(node_b[field]);
    gen_collect_type(field_type);
    field = node_next[field];
  }
  gen_bind_clear();
  let restore_i: int = 0;
  while restore_i < saved_count {
    gen_bind_name[restore_i] = gen_bind_name[saved_count + restore_i];
    gen_bind_type[restore_i] = gen_bind_type[saved_count + restore_i];
    restore_i = restore_i + 1;
  }
  gen_bind_count = saved_count;
}

func gen_add_struct_spec(ty: int): void {
  let q: int = gen_substitute_type(ty);
  if q == 0 || node_kind[q] != TY_GENERIC then return;
  let decl: int = tc_find_struct(node_value[q]); if decl == 0 then return;
  let name: int = gen_mangled_type_symbol(q);
  if gen_spec_exists(1, decl, name) == 1 then return;
  let slot: int = gen_spec_count;
  ensure_gen_specs(gen_spec_count);
  gen_spec_kind[slot] = 1; gen_spec_decl[slot] = decl; gen_spec_type[slot] = q; gen_spec_name[slot] = name; gen_spec_count = gen_spec_count + 1;
  let a: int = node_a[q]; while a != 0 { gen_collect_type(a); a = node_next[a]; }
  gen_collect_struct_fields(decl, q);
  let last: int = gen_spec_count - 1;
  while slot < last {
    gen_spec_kind[slot] = gen_spec_kind[slot + 1]; gen_spec_decl[slot] = gen_spec_decl[slot + 1]; gen_spec_type[slot] = gen_spec_type[slot + 1]; gen_spec_name[slot] = gen_spec_name[slot + 1];
    slot = slot + 1;
  }
  gen_spec_kind[last] = 1; gen_spec_decl[last] = decl; gen_spec_type[last] = q; gen_spec_name[last] = name;
}
func gen_type_has_param(ty: int): int {
  if ty == 0 then return 0;
  if node_kind[ty] == TY_PARAM then return 1;
  if node_kind[ty] == TY_PTR || node_kind[ty] == TY_ARRAY || node_kind[ty] == TY_DYN_ARRAY then return gen_type_has_param(node_a[ty]);
  if node_kind[ty] == TY_GENERIC then {
    let a: int = node_a[ty];
    while a != 0 { if gen_type_has_param(a) == 1 then return 1; a = node_next[a]; }
  }
  return 0;
}

func gen_add_fun_spec(decl: int, args: int): void {
  let saved_count: int = gen_bind_count;
  ensure_gen_bind(saved_count + saved_count);
  let save_i: int = 0;
  while save_i < saved_count {
    gen_bind_name[saved_count + save_i] = gen_bind_name[save_i];
    gen_bind_type[saved_count + save_i] = gen_bind_type[save_i];
    save_i = save_i + 1;
  }
  let actual: int = 0; let p: int = args;
  while p != 0 { let q: int = gen_substitute_type(p); if actual == 0 then actual = q; else actual = ast_link(actual, q); p = node_next[p]; }
  gen_bind_decl(decl, actual);
  let typeargs: int = 0; let tp: int = node_aux[decl];
  while tp != 0 {
    let bt: int = gen_bind_find(node_a[tp]);
    if bt == 0 then bt = ast_node(TY_PARAM, 0, 0, 0, node_a[tp], 0);
    let cq: int = gen_substitute_type(bt);
    if typeargs == 0 then typeargs = cq; else typeargs = ast_link(typeargs, cq);
    tp = node_next[tp];
  }
  gen_bind_clear();
  let restore_i: int = 0;
  while restore_i < saved_count {
    gen_bind_name[restore_i] = gen_bind_name[saved_count + restore_i];
    gen_bind_type[restore_i] = gen_bind_type[saved_count + restore_i];
    restore_i = restore_i + 1;
  }
  gen_bind_count = saved_count;
  let name: int = gen_mangled_function_symbol(node_value[decl], typeargs);
  if gen_spec_exists(2, decl, name) == 1 then return;
  ensure_gen_specs(gen_spec_count); gen_spec_kind[gen_spec_count] = 2; gen_spec_decl[gen_spec_count] = decl; gen_spec_type[gen_spec_count] = actual; gen_spec_name[gen_spec_count] = name; gen_spec_count = gen_spec_count + 1;
  let a: int = actual; while a != 0 { gen_collect_type(a); a = node_next[a]; }
}
func gen_collect_type(ty: int): void {
  if ty == 0 then { return; }
  if node_kind[ty] == TY_GENERIC then { gen_add_struct_spec(ty); }
  else if node_kind[ty] == TY_TUPLE then { gen_add_tuple_type(ty); }
  else if node_kind[ty] == TY_CLOSURE then {
    let ca: int = node_a[ty];
    while ca != 0 { gen_collect_type(ca); ca = node_next[ca]; }
    gen_collect_type(node_b[ty]);
  }
  else if (node_kind[ty] == TY_PTR || node_kind[ty] == TY_ARRAY || node_kind[ty] == TY_DYN_ARRAY) then { gen_collect_type(node_a[ty]); }
}
func gen_collect_expr(id: int): void {
  if id == 0 then return;
  let k: int = node_kind[id];
  if k == N_CLOSURE then {
    let cp: int = node_c[id];
    while cp != 0 { gen_collect_type(node_b[cp]); cp = node_next[cp]; }
    gen_collect_type(node_value[id]);
    gen_closure_register(id);
    gen_collect_stmt(node_b[id]);
    return;
  }
  if k == N_VARIANT then { let aa: int = node_a[id]; while aa != 0 { gen_collect_expr(aa); aa = node_next[aa]; } return; }
  if k == N_CALL then {
    let f: int = tc_find_function_ctx(node_value[id], node_scope[id]);
    if f != 0 && node_kind[f] == N_GENERIC_FUNC then {
      let aa: int = node_a[id]; let actual: int = node_b[id];
      if actual != 0 then {
        let explicit: int = actual;
        while explicit != 0 { gen_collect_type(explicit); explicit = node_next[explicit]; }
      } else {
        while aa != 0 { let q: int = tc_emit_arg_type(aa); if q == 0 then { tc_expr(aa); q = tc_result_type; if q == 0 then q = tc_type_node_from_summary(tc_kind, tc_name, tc_elem_kind, tc_elem_name); } if q != 0 then q = gen_substitute_type(q); if actual == 0 then actual = q; else actual = ast_link(actual, q); gen_collect_type(q); aa = node_next[aa]; }
      }
      let unresolved: int = 0;
      let check_actual: int = actual;
      while check_actual != 0 { if gen_type_has_param(check_actual) == 1 then unresolved = 1; check_actual = node_next[check_actual]; }
      if unresolved == 0 then gen_add_fun_spec(f, actual);
    }
    let aar: int = node_a[id]; while aar != 0 { gen_collect_expr(aar); aar = node_next[aar]; }
    return;
  }
  if k == N_INDIRECT_CALL then { gen_collect_expr(node_a[id]); let aa: int = node_b[id]; while aa != 0 { gen_collect_expr(aa); aa = node_next[aa]; } return; }
  if k == N_MOVE then { gen_collect_expr(node_a[id]); return; }
  if k == N_BINOP then { gen_collect_expr(node_a[id]); gen_collect_expr(node_b[id]); return; }
  if k == N_TUPLE then { let item: int = node_a[id]; while item != 0 { gen_collect_expr(item); item = node_next[item]; } return; }
  if k == N_FIELD_ACCESS || k == N_INDEX || k == N_DEREF || k == N_ADDRESS then { gen_collect_expr(node_a[id]); gen_collect_expr(node_b[id]); return; }
}
func gen_collect_stmt(id: int): void {
  if id == 0 then return;
  let k: int = node_kind[id];
  if k == N_DEFER then { gen_collect_expr(node_a[id]); return; }
  if k == N_TUPLE_BIND then { gen_collect_type(node_b[id]); gen_collect_expr(node_c[id]); return; }
  if k == N_TUPLE then { gen_collect_expr(node_a[id]); return; }
  if k == N_MATCH then { gen_collect_expr(node_a[id]); let ma: int = node_b[id]; while ma != 0 { gen_collect_stmt(node_b[ma]); ma = node_next[ma]; } return; }
  if k == N_LET || k == N_CONST then { gen_collect_type(node_b[id]); gen_collect_expr(node_c[id]); return; }
  if k == N_GLOBAL then { gen_collect_type(node_b[id]); gen_collect_expr(node_c[id]); return; }
  if k == N_ASSIGN || k == N_COMPOUND_ASSIGN then { gen_collect_expr(node_a[id]); gen_collect_expr(node_b[id]); return; }
  if k == N_PRINT || k == N_PRINTLN || k == N_EXPR || k == N_RETURN then { gen_collect_expr(node_a[id]); return; }
  if k == N_BLOCK then { let x: int = node_a[id]; while x != 0 { gen_collect_stmt(x); x = node_next[x]; } return; }
  if k == N_IF then { gen_collect_expr(node_a[id]); gen_collect_stmt(node_b[id]); gen_collect_stmt(node_c[id]); return; }
  if k == N_WHILE then { gen_collect_expr(node_a[id]); gen_collect_stmt(node_b[id]); return; }
  if k == N_FOR then { gen_collect_stmt(node_a[id]); gen_collect_expr(node_b[id]); gen_collect_stmt(node_c[id]); gen_collect_stmt(node_value[id]); return; }
}
func gen_alignment(alignment: int): void {
  if alignment > 0 then {
    code_emit(C_IDENT, -1020);
    code_emit(C_PUNCT, 4);
    code_emit(C_INT, alignment);
    code_emit(C_PUNCT, 5);
  }
}

func gen_primitive_type(kind: int): void {
  if kind == TY_INT then code_emit(C_KW, 1);
  else if kind == TY_BOOL then code_emit(C_KW, 2);
  else if kind == TY_STRING then code_emit(C_KW, 3);
  else if kind == TY_CHAR then code_emit(C_KW, 17);
  else if kind == TY_FLOAT then code_emit(C_KW, 18);
  else if kind == TY_DOUBLE then code_emit(C_KW, 15);
  else if kind == TY_LONG then code_emit(C_KW, 19);
  else if kind == TY_LLONG then code_emit(C_KW, 20);
  else if kind == TY_U8 then code_emit(C_KW, 21);
  else if kind == TY_U16 then code_emit(C_KW, 22);
  else if kind == TY_U32 then code_emit(C_KW, 23);
  else if kind == TY_U64 then code_emit(C_KW, 24);
  else if kind == TY_I8 then code_emit(C_KW, 25);
  else if kind == TY_I16 then code_emit(C_KW, 26);
  else if kind == TY_I32 then code_emit(C_KW, 27);
  else if kind == TY_I64 then code_emit(C_KW, 28);
  else if kind == TY_USIZE then code_emit(C_KW, 29);
  else if kind == TY_VOID then code_emit(C_KW, 4);
}

func gen_type(kind: int, child: int, size: int): void {
  if kind == TY_PTR then {
    gen_type(node_kind[node_a[child]], node_a[child], 0);
    code_emit(C_PUNCT, 1);
  } else if kind == TY_ARRAY then {
    gen_type(node_kind[child], node_a[child], node_value[child]);
    code_emit(C_PUNCT, 2);
    code_emit(C_INT, size);
    code_emit(C_PUNCT, 3);
  } else if kind == TY_DYN_ARRAY then {
    code_emit(C_IDENT, -1003);
    code_emit(C_PUNCT, 18);
  } else if kind == TY_NAMED then {
    code_emit(C_IDENT, sym_c_symbol(node_value[child]));
    code_emit(C_PUNCT, 18);
  } else if kind == TY_GENERIC then {
    code_emit(C_IDENT, gen_mangled_type_symbol(child));
    code_emit(C_PUNCT, 18);
  } else if kind == TY_TUPLE then {
    code_emit(C_KW, 12);
    code_emit(C_IDENT, gen_mangled_type_symbol(child));
    code_emit(C_PUNCT, 18);
  } else if kind == TY_CLOSURE then {
    code_emit(C_KW, 12);
    code_emit(C_IDENT, gen_mangled_type_symbol(child));
    code_emit(C_PUNCT, 18);
  } else if kind == TY_PARAM then {
    let b: int = gen_bind_find(node_value[child]);
    if b != 0 && b != child then gen_type(node_kind[b], b, node_value[b]);
    else code_emit(C_IDENT, sym_c_symbol(node_value[child]));
    code_emit(C_PUNCT, 18);
  } else gen_primitive_type(kind);
}

func gen_scalar_kind(arg: int): int {
  if arg != 0 then {
    let typed: int = tc_emit_arg_type(arg);
    if typed != 0 then {
      let resolved: int = gen_substitute_type(typed);
      if resolved != 0 && node_kind[resolved] != TY_PARAM then return node_kind[resolved];
    }
    if node_kind[arg] == N_INT then return TY_INT;
    if node_kind[arg] == N_BOOL then return TY_BOOL;
    if node_kind[arg] == N_CHAR then return TY_CHAR;
    if node_kind[arg] == N_FLOAT then return TY_DOUBLE;
    if node_kind[arg] == N_STRING then return TY_STRING;
    if node_kind[arg] == N_VAR then return sym_type[node_value[arg]];
  }
  return gen_expr_kind(arg);
}

func gen_scalar_name(arg: int): int {
  if arg != 0 then {
    let typed: int = tc_emit_arg_type(arg);
    if typed != 0 then {
      let resolved: int = gen_substitute_type(typed);
      if resolved != 0 && node_kind[resolved] == TY_NAMED then return node_value[resolved];
    }
    if node_kind[arg] == N_VAR then return sym_elem_name[node_value[arg]];
  }
  return 0;
}

func gen_array_elem_kind(arg: int): int {
  if arg != 0 && node_kind[arg] == N_VAR then {
    let name: int = node_value[arg];
    let formal_type: int = gen_active_param_type(name);
    if formal_type != 0 then {
      let resolved_type: int = gen_substitute_type(formal_type);
      if resolved_type != 0 && node_kind[resolved_type] == TY_DYN_ARRAY && node_a[resolved_type] != 0 then return node_kind[node_a[resolved_type]];
    }
    let kind: int = sym_elem_kind[name];
    let elem_name: int = sym_elem_name[name];
    let param_name: int = elem_name;
    if kind == TY_PARAM && elem_name != 0 && node_kind[elem_name] == TY_PARAM then param_name = node_value[elem_name];
    if kind == TY_PARAM then {
      let bound: int = gen_bind_find(param_name);
      if bound != 0 then {
        let resolved: int = gen_substitute_type(bound);
        if resolved != 0 then return node_kind[resolved];
      }
    }
    return kind;
  }
  return TY_INT;
}

func gen_array_elem_name(arg: int): int {
  if arg != 0 && node_kind[arg] == N_VAR then {
    let name: int = node_value[arg];
    let formal_type: int = gen_active_param_type(name);
    if formal_type != 0 then {
      let resolved_type: int = gen_substitute_type(formal_type);
      if resolved_type != 0 && node_kind[resolved_type] == TY_DYN_ARRAY && node_a[resolved_type] != 0 && node_kind[node_a[resolved_type]] == TY_NAMED then return node_value[node_a[resolved_type]];
    }
    let kind: int = sym_elem_kind[name];
    let elem_name: int = sym_elem_name[name];
    let param_name: int = elem_name;
    if kind == TY_PARAM && elem_name != 0 && node_kind[elem_name] == TY_PARAM then param_name = node_value[elem_name];
    if kind == TY_PARAM then {
      let bound: int = gen_bind_find(param_name);
      if bound != 0 then {
        let resolved: int = gen_substitute_type(bound);
        if resolved != 0 && node_kind[resolved] == TY_NAMED then return node_value[resolved];
      }
      return 0;
    }
    return elem_name;
  }
  return 0;
}

func gen_array_elem_type(kind: int, name: int): void {
  if kind == TY_STRING then { code_emit(C_KW, 17); code_emit(C_PUNCT, 1); }
  else if kind == TY_NAMED then code_emit(C_IDENT, sym_c_symbol(name));
  else if kind == TY_PTR then { code_emit(C_KW, 1); code_emit(C_PUNCT, 1); }
  else if kind == TY_PARAM then code_emit(C_KW, 1);
  else gen_primitive_type(kind);
}

func gen_array_sizeof(kind: int, name: int): void {
  code_emit(C_IDENT, -1011);
  code_emit(C_PUNCT, 4);
  gen_array_elem_type(kind, name);
  code_emit(C_PUNCT, 5);
}

func gen_array_value_ptr(kind: int, name: int, value: int): void {
  code_emit(C_PUNCT, 10);
  code_emit(C_PUNCT, 4);
  gen_array_elem_type(kind, name);
  if kind == TY_NAMED then {
    code_emit(C_PUNCT, 2);
    code_emit(C_PUNCT, 3);
  }
  code_emit(C_PUNCT, 5);
  code_emit(C_PUNCT, 24);
  if kind == TY_FLOAT then {
    code_emit(C_PUNCT, 4);
    code_emit(C_KW, 18);
    code_emit(C_PUNCT, 5);
  }
  gen_expr(value);
  code_emit(C_PUNCT, 25);
}

func gen_array_sizeof_node(ty: int): void {
  code_emit(C_IDENT, -1011);
  code_emit(C_PUNCT, 4);
  if ty != 0 && node_kind[ty] == TY_GENERIC then code_emit(C_IDENT, gen_mangled_type_symbol(ty));
  else if ty != 0 && node_kind[ty] == TY_PTR then gen_type(node_kind[ty], ty, 0);
  else if ty != 0 then gen_array_elem_type(node_kind[ty], node_value[ty]);
  else gen_array_elem_type(TY_INT, 0);
  code_emit(C_PUNCT, 5);
}

func gen_memory_sizeof(arg: int): void {
  let ty: int = tc_emit_arg_type(arg);
  if ty != 0 then ty = gen_substitute_type(ty);
  if ty != 0 && node_kind[ty] == TY_PTR && node_a[ty] != 0 then {
    let elem: int = gen_substitute_type(node_a[ty]);
    gen_array_sizeof_node(elem);
  } else if ty != 0 then gen_array_sizeof_node(ty);
  else gen_array_sizeof_node(0);
}

func gen_memory_builtin(id: int): void {
  let call_name: int = node_value[id];
  let btag: int = bi_tag(call_name);
  let a: int = node_a[id];
  if btag == BI_TC_MEM_ALLOC || btag == BI_TC_MEM_ALLOC_ALIGNED then {
    let alignment_arg: int = 0;
    let witness: int = node_next[a];
    if btag == BI_TC_MEM_ALLOC_ALIGNED then { alignment_arg = witness; witness = node_next[witness]; }
    let elem_kind: int = gen_scalar_kind(witness);
    let elem_name: int = gen_scalar_name(witness);
    let gen_witness_ty: int = 0;
    let complex_witness_ty: int = 0;
    if elem_kind == TY_GENERIC then {
      let wty: int = tc_emit_arg_type(witness);
      if wty != 0 then gen_witness_ty = gen_substitute_type(wty);
    } else if elem_kind == TY_PTR then {
      let pointer_witness_ty: int = tc_emit_arg_type(witness);
      if pointer_witness_ty != 0 then complex_witness_ty = gen_substitute_type(pointer_witness_ty);
    }
    code_emit(C_PUNCT, 6);
    code_emit(C_PUNCT, 6);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 6);
    gen_expr(witness);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 7);
    code_emit(C_PUNCT, 6);
    if gen_witness_ty != 0 then code_emit(C_IDENT, gen_mangled_type_symbol(gen_witness_ty));
    else if complex_witness_ty != 0 then gen_type(node_kind[complex_witness_ty], complex_witness_ty, 0);
    else gen_array_elem_type(elem_kind, elem_name);
    code_emit(C_PUNCT, 1);
    code_emit(C_PUNCT, 8);
    if btag == BI_TC_MEM_ALLOC_ALIGNED then code_emit(C_IDENT, -1019);
    else code_emit(C_IDENT, -1016);
    code_emit(C_PUNCT, 6);
    gen_expr(a);
    code_emit(C_PUNCT, 7);
    if btag == BI_TC_MEM_ALLOC_ALIGNED then { gen_expr(alignment_arg); code_emit(C_PUNCT, 7); }
    if gen_witness_ty != 0 then {
      code_emit(C_IDENT, -1011);
      code_emit(C_PUNCT, 4);
      code_emit(C_IDENT, gen_mangled_type_symbol(gen_witness_ty));
      code_emit(C_PUNCT, 5);
    } else if complex_witness_ty != 0 then { code_emit(C_IDENT, -1011); code_emit(C_PUNCT, 4); gen_type(node_kind[complex_witness_ty], complex_witness_ty, 0); code_emit(C_PUNCT, 5); }
    else gen_array_sizeof(elem_kind, elem_name);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 8);
  } else if btag == BI_TC_MEM_RESIZE then {
    let old_count: int = node_next[a];
    let new_count: int = node_next[old_count];
    let zero: int = node_next[new_count];
    let ptr_ty: int = tc_emit_arg_type(a);
    if ptr_ty != 0 then ptr_ty = gen_substitute_type(ptr_ty);
    if ptr_ty == 0 then ptr_ty = ast_node(TY_PTR, ast_node(TY_INT, 0, 0, 0, 0, 0), 0, 0, 0, 0);
    code_emit(C_PUNCT, 6);
    code_emit(C_PUNCT, 6);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 6);
    gen_expr(zero);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 7);
    code_emit(C_PUNCT, 6);
    gen_type(node_kind[ptr_ty], ptr_ty, 0);
    code_emit(C_PUNCT, 8);
    code_emit(C_IDENT, -1017);
    code_emit(C_PUNCT, 6);
    code_emit(C_PUNCT, 6);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 1);
    code_emit(C_PUNCT, 8);
    gen_expr(a);
    code_emit(C_PUNCT, 7);
    gen_expr(old_count);
    code_emit(C_PUNCT, 7);
    gen_expr(new_count);
    code_emit(C_PUNCT, 7);
    gen_memory_sizeof(a);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 8);
  } else if btag == BI_TC_MEM_FREE then {
    code_emit(C_IDENT, -1018);
    code_emit(C_PUNCT, 6);
    code_emit(C_PUNCT, 6);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 1);
    code_emit(C_PUNCT, 8);
    gen_expr(a);
    code_emit(C_PUNCT, 8);
  } else {
    code_emit(C_IDENT, sym_c_symbol(call_name));
    code_emit(C_PUNCT, 6);
    let arg: int = a;
    while arg != 0 { gen_expr(arg); if node_next[arg] != 0 then code_emit(C_PUNCT, 7); arg = node_next[arg]; }
    code_emit(C_PUNCT, 8);
  }
}

func gen_call_name(id: int): int {
  let f: int = tc_find_function_ctx(node_value[id], node_scope[id]);
  if f == 0 then return sym_c_symbol(node_value[id]);
  if node_kind[f] != N_GENERIC_FUNC then return sym_c_symbol(node_value[f]);
  let actual: int = node_b[id]; let a: int = node_a[id];
  if actual == 0 then {
    while a != 0 {
      let q: int = 0;
        q = tc_emit_arg_type(a);
      if q == 0 then { tc_expr(a); q = tc_result_type; if q == 0 then q = tc_type_node_from_summary(tc_kind, tc_name, tc_elem_kind, tc_elem_name); }
      if q != 0 then q = gen_substitute_type(q);
      if actual == 0 then actual = q; else actual = ast_link(actual, q);
      a = node_next[a];
    }
  }
  let saved_count: int = gen_bind_count;
  ensure_gen_bind(saved_count + saved_count);
  let save_i: int = 0;
  while save_i < saved_count {
    gen_bind_name[saved_count + save_i] = gen_bind_name[save_i];
    gen_bind_type[saved_count + save_i] = gen_bind_type[save_i];
    save_i = save_i + 1;
  }
  gen_bind_decl(f, actual);
  let typeargs: int = 0; let tp: int = node_aux[f];
  while tp != 0 {
    let bt: int = gen_bind_find(node_a[tp]);
    if bt == 0 then bt = ast_node(TY_PARAM, 0, 0, 0, node_a[tp], 0);
    let cq: int = gen_substitute_type(bt);
    if typeargs == 0 then typeargs = cq; else typeargs = ast_link(typeargs, cq);
    tp = node_next[tp];
  }
  gen_bind_clear();
  let restore_i: int = 0;
  while restore_i < saved_count {
    gen_bind_name[restore_i] = gen_bind_name[saved_count + restore_i];
    gen_bind_type[restore_i] = gen_bind_type[saved_count + restore_i];
    restore_i = restore_i + 1;
  }
  gen_bind_count = saved_count;
  return gen_mangled_function_symbol(node_value[f], typeargs);
}

func gen_variant_expr(id: int): void {
  tc_find_enum_variant(node_value[id]);
  let enum_name: int = tc_variant_enum;
  if enum_name == 0 && node_aux[id] != 0 && node_kind[node_aux[id]] == TY_NAMED then enum_name = node_value[node_aux[id]];
  let member: int = tc_variant_member;
  if member == 0 then { code_emit(C_INT, 0); return; }
  let enum_decl: int = tc_find_enum(enum_name);
  let tagged: int = 0;
  if enum_decl != 0 then {
    let probe: int = node_a[enum_decl];
    while probe != 0 {
      if node_b[probe] != 0 then tagged = 1;
      probe = node_next[probe];
    }
  }
  if tagged == 0 then { code_emit(C_IDENT, sym_c_symbol(sym_qualified(enum_name, node_a[member]))); return; }
  code_emit(C_PUNCT, 4);
  code_emit(C_IDENT, sym_c_symbol(enum_name));
  code_emit(C_PUNCT, 5);
  code_emit(C_PUNCT, 24);
  code_emit(C_PUNCT, 17);
  code_emit(C_IDENT, sym_tag_id());
  code_emit(C_PUNCT, 11);
  code_emit(C_IDENT, sym_c_symbol(sym_qualified(enum_name, node_a[member])));
  let payload: int = node_b[member];
  if payload != 0 then {
    code_emit(C_PUNCT, 7);
    code_emit(C_PUNCT, 17);
    code_emit(C_IDENT, sym_c_symbol(node_a[member]));
    code_emit(C_PUNCT, 11);
    code_emit(C_PUNCT, 24);
    let arg: int = node_a[id];
    let field: int = payload;
    while field != 0 && arg != 0 {
      code_emit(C_PUNCT, 17);
      code_emit(C_IDENT, sym_c_symbol(node_a[field]));
      code_emit(C_PUNCT, 11);
      gen_expr(arg);
      if node_next[field] != 0 && node_next[arg] != 0 then code_emit(C_PUNCT, 7);
      field = node_next[field];
      arg = node_next[arg];
    }
    code_emit(C_PUNCT, 25);
  }
  code_emit(C_PUNCT, 25);
}

func gen_expr(id: int): void {
  let k: int = node_kind[id];
  if k == N_INT then {
    if node_aux[id] != 0 then {
      if node_value[id] < 0 then code_emit(C_RAW_U64, node_aux[id]); else code_emit(C_RAW, node_aux[id]);
    } else code_emit(C_INT, node_value[id]);
  }
  else if k == N_BOOL then code_emit(C_INT, node_value[id]);
  else if k == N_FLOAT then {
    code_emit(C_IDENT, node_value[id]);
    if node_aux[id] == TY_FLOAT then code_emit(C_IDENT, -1021);
  }
  else if k == N_STRING then code_emit(C_STRING, node_value[id]);
  else if k == N_CHAR then code_emit(C_INT, node_value[id]);
  else if k == N_VARIANT then gen_variant_expr(id);
  else if k == N_TUPLE then {
    let tuple_ty: int = node_aux[id];
    if tuple_ty == 0 then { tc_expr(id); tuple_ty = tc_result_type; }
    if tuple_ty == 0 then { code_emit(C_PUNCT, 24); code_emit(C_PUNCT, 25); }
    else {
      code_emit(C_PUNCT, 4);
      code_emit(C_KW, 12);
      code_emit(C_IDENT, gen_mangled_type_symbol(tuple_ty));
      code_emit(C_PUNCT, 5);
      code_emit(C_PUNCT, 24);
      let item: int = node_a[id];
      let index: int = 0;
      while item != 0 {
        code_emit(C_PUNCT, 17);
        code_emit(C_IDENT, gen_tuple_field_name(index));
        code_emit(C_PUNCT, 11);
        gen_expr(item);
        if node_next[item] != 0 then code_emit(C_PUNCT, 7);
        item = node_next[item];
        index = index + 1;
      }
      code_emit(C_PUNCT, 25);
    }
  }
  else if k == N_NULL then { code_emit(C_INT, 0); }
  else if k == N_MOVE then { gen_expr(node_a[id]); }
  else if k == N_CLOSURE then {
    let closure_serial_expr: int = node_aux[id] - 1;
    code_emit(C_IDENT, gen_closure_factory_name(closure_serial_expr)); code_emit(C_PUNCT, 6);
    let closure_cap_expr: int = node_a[id];
    while closure_cap_expr != 0 {
      let capture_var_expr: int = ast_node(N_VAR, 0, 0, 0, node_a[closure_cap_expr], 0);
      if node_aux[closure_cap_expr] == 2 || node_aux[closure_cap_expr] == 3 then code_emit(C_PUNCT, 10);
      gen_expr(capture_var_expr);
      if node_next[closure_cap_expr] != 0 then code_emit(C_PUNCT, 7);
      closure_cap_expr = node_next[closure_cap_expr];
    }
    code_emit(C_PUNCT, 8);
  }
  else if k == N_UNARY then { code_emit(C_OP, OP_NOT); code_emit(C_PUNCT, 4); gen_expr(node_a[id]); code_emit(C_PUNCT, 5); }
  else if k == N_VAR then {
    let active_capture: int = gen_active_closure_capture(node_value[id]);
    if active_capture != 0 && node_aux[active_capture] != 1 then {
      code_emit(C_PUNCT, 4);
      code_emit(C_PUNCT, 9);
      code_emit(C_IDENT, gen_closure_active_env_name());
      code_emit(C_PUNCT, 27);
      code_emit(C_IDENT, sym_c_symbol(node_a[active_capture]));
      code_emit(C_PUNCT, 5);
    } else if node_aux[id] != 0 && node_kind[node_aux[id]] == TY_NAMED then {
      let enum_name: int = node_value[node_aux[id]];
      let enum_decl: int = tc_find_enum(enum_name);
      let member: int = tc_match_variant_member(enum_decl, node_value[id]);
      if member != 0 then {
        let tagged: int = 0;
        let probe: int = node_a[enum_decl];
        while probe != 0 { if node_b[probe] != 0 then tagged = 1; probe = node_next[probe]; }
        if tagged == 0 then code_emit(C_IDENT, sym_c_symbol(sym_qualified(enum_name, node_a[member])));
        else {
          code_emit(C_PUNCT, 4);
          code_emit(C_IDENT, sym_c_symbol(enum_name));
          code_emit(C_PUNCT, 5);
          code_emit(C_PUNCT, 24);
          code_emit(C_PUNCT, 17);
          code_emit(C_IDENT, sym_tag_id());
          code_emit(C_PUNCT, 11);
          code_emit(C_IDENT, sym_c_symbol(sym_qualified(enum_name, node_a[member])));
          code_emit(C_PUNCT, 25);
        }
      } else code_emit(C_IDENT, sym_c_symbol(node_value[id]));
    } else code_emit(C_IDENT, sym_c_symbol(node_value[id]));
  }
  else if k == N_BINOP then {
    if node_c[id] == TY_FLOAT then { code_emit(C_PUNCT, 4); code_emit(C_KW, 18); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 4); }
    if node_value[id] == OP_CONCAT then { code_emit(C_IDENT, -1002); code_emit(C_PUNCT, 6); gen_expr(node_a[id]); code_emit(C_PUNCT, 7); gen_expr(node_b[id]); code_emit(C_PUNCT, 8); }
    else if node_value[id] == OP_SUB && gen_expr_kind(node_a[id]) == TY_PTR && gen_expr_kind(node_b[id]) == TY_PTR then { code_emit(C_PUNCT, 4); code_emit(C_KW, 1); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 4); gen_expr(node_a[id]); code_emit(C_OP, node_value[id]); gen_expr(node_b[id]); code_emit(C_PUNCT, 5); }
    else { code_emit(C_PUNCT, 4); gen_expr(node_a[id]); code_emit(C_OP, node_value[id]); gen_expr(node_b[id]); code_emit(C_PUNCT, 5); }
    if node_c[id] == TY_FLOAT then code_emit(C_PUNCT, 5);
  } else if k == N_CALL then {
    let call_name: int = node_value[id];
    let btag: int = bi_tag(call_name);
    if btag == BI_TC_MEM_ALLOC || btag == BI_TC_MEM_ALLOC_ALIGNED || btag == BI_TC_MEM_RESIZE || btag == BI_TC_MEM_FREE then gen_memory_builtin(id);
    else { code_emit(C_IDENT, gen_call_name(id)); code_emit(C_PUNCT, 6); let arg: int = node_a[id]; while arg != 0 { gen_expr(arg); if node_next[arg] != 0 then code_emit(C_PUNCT, 7); arg = node_next[arg]; } code_emit(C_PUNCT, 8); }
  } else if k == N_INDIRECT_CALL then {
    let callee_type_expr: int = tc_emit_arg_type(node_a[id]);
    if callee_type_expr != 0 && node_kind[callee_type_expr] == TY_CLOSURE then {
      code_emit(C_IDENT, gen_closure_call_name(callee_type_expr)); code_emit(C_PUNCT, 6); gen_expr(node_a[id]);
      let closure_arg_emit: int = node_b[id];
      if closure_arg_emit != 0 then code_emit(C_PUNCT, 7);
      while closure_arg_emit != 0 { gen_expr(closure_arg_emit); if node_next[closure_arg_emit] != 0 then code_emit(C_PUNCT, 7); closure_arg_emit = node_next[closure_arg_emit]; }
      code_emit(C_PUNCT, 8);
    } else {
      code_emit(C_PUNCT, 4); gen_expr(node_a[id]); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 6);
      let arg: int = node_b[id]; while arg != 0 { gen_expr(arg); if node_next[arg] != 0 then code_emit(C_PUNCT, 7); arg = node_next[arg]; }
      code_emit(C_PUNCT, 8);
    }
  } else if k == N_DEREF then { code_emit(C_PUNCT, 9); gen_expr(node_a[id]); }
  else if k == N_ADDRESS then { code_emit(C_PUNCT, 10); gen_expr(node_a[id]); }
  else if k == N_INDEX then {
    gen_expr(node_a[id]); code_emit(C_PUNCT, 2); gen_expr(node_b[id]); code_emit(C_PUNCT, 3);
  }
  else if k == N_FIELD_ACCESS then {
    gen_expr(node_a[id]);
    if gen_expr_kind(node_a[id]) == TY_PTR then code_emit(C_PUNCT, 27); else code_emit(C_PUNCT, 17);
    code_emit(C_IDENT, node_value[id]);
  }
}

func gen_expr_condition_inner(id: int): void {
  if node_kind[id] != N_BINOP then { gen_expr(id); return; }
  if node_value[id] == OP_CONCAT then { code_emit(C_IDENT, -1002); code_emit(C_PUNCT, 6); gen_expr(node_a[id]); code_emit(C_PUNCT, 7); gen_expr(node_b[id]); code_emit(C_PUNCT, 8); return; }
  if node_value[id] == OP_SUB && gen_expr_kind(node_a[id]) == TY_PTR && gen_expr_kind(node_b[id]) == TY_PTR then { code_emit(C_PUNCT, 4); code_emit(C_KW, 1); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 4); gen_expr(node_a[id]); code_emit(C_OP, node_value[id]); gen_expr(node_b[id]); code_emit(C_PUNCT, 5); return; }
  gen_expr(node_a[id]); code_emit(C_OP, node_value[id]); gen_expr(node_b[id]);
}

func gen_expr_kind(id: int): int {
  let k: int = node_kind[id];
  if k == N_INT || k == N_BOOL then return TY_INT;
  if k == N_CLOSURE then return TY_CLOSURE;
  if k == N_MOVE then return gen_expr_kind(node_a[id]);
  if k == N_TUPLE then return TY_TUPLE;
  if k == N_VARIANT then { if node_aux[id] != 0 then return node_kind[node_aux[id]]; return TY_NAMED; }
  if k == N_CHAR then return TY_CHAR;
  if k == N_FLOAT then { if node_aux[id] == TY_FLOAT then return TY_FLOAT; return TY_DOUBLE; }
  if k == N_STRING then return TY_STRING;
  if k == N_NULL then return TY_PTR;
  if k == N_UNARY then return TY_BOOL;
  if k == N_VAR then {
    let stable_type: int = node_type[id];
    if stable_type != 0 && node_kind[stable_type] != TY_PARAM then return node_kind[stable_type];
    let formal_type: int = gen_active_param_type(node_value[id]);
    if formal_type != 0 then {
      let resolved_type: int = gen_substitute_type(formal_type);
      if resolved_type != 0 then return node_kind[resolved_type];
    }
    let vt: int = sym_type[node_value[id]];
    if vt > 99 then {
      tc_elem_kind = sym_elem_kind[node_value[id]];
      tc_elem_name = sym_elem_name[node_value[id]];
      return vt - 100;
    }
    return vt;
  }
  if k == N_INDEX then {
    let bt: int = gen_expr_kind(node_a[id]);
    if bt == TY_STRING then return TY_CHAR;
    let index_type: int = tc_emit_arg_type(node_a[id]);
    if index_type != 0 && (node_kind[index_type] == TY_PTR || node_kind[index_type] == TY_ARRAY || node_kind[index_type] == TY_DYN_ARRAY) then {
      let index_elem: int = node_a[index_type];
      if index_elem != 0 then return node_kind[index_elem];
    }
    if bt == TY_PTR then return TY_INT;
    return TY_INT;
  }
  if k == N_DEREF then {
    let deref_type: int = tc_emit_arg_type(node_a[id]);
    if deref_type != 0 && node_kind[deref_type] == TY_PTR && node_a[deref_type] != 0 then return node_kind[node_a[deref_type]];
    return TY_INT;
  }
  if k == N_ADDRESS then return TY_PTR;
  if k == N_FIELD_ACCESS then { let field_ty: int = tc_emit_field_type(id); if field_ty != 0 then return node_kind[field_ty]; return TY_INT; }
  if k == N_CALL || k == N_INDIRECT_CALL then return tc_expr_kind_for_emit(id);
  if k == N_BINOP then {
    if node_value[id] == OP_CONCAT then return TY_STRING;
    if node_value[id] == OP_EQ || node_value[id] == OP_NEQ || node_value[id] == OP_LT || node_value[id] == OP_GT || node_value[id] == OP_LE || node_value[id] == OP_GE || node_value[id] == OP_AND || node_value[id] == OP_OR then return TY_BOOL;
    if node_value[id] == OP_SUB && gen_expr_kind(node_a[id]) == TY_PTR && gen_expr_kind(node_b[id]) == TY_PTR then return TY_INT;
    let ak: int = gen_expr_kind(node_a[id]); let bk: int = gen_expr_kind(node_b[id]);
    if node_value[id] == OP_BITAND || node_value[id] == OP_BITOR || node_value[id] == OP_BITXOR || node_value[id] == OP_SHL || node_value[id] == OP_SHR then { if ak == TY_LLONG || bk == TY_LLONG then return TY_LLONG; if ak == TY_LONG || bk == TY_LONG then return TY_LONG; return TY_INT; }
    if ak == TY_DOUBLE || bk == TY_DOUBLE then return TY_DOUBLE;
    if ak == TY_FLOAT || bk == TY_FLOAT then return TY_FLOAT;
    if ak == TY_LLONG || bk == TY_LLONG then return TY_LLONG;
    if ak == TY_LONG || bk == TY_LONG then return TY_LONG;
    if ak == TY_PTR then return TY_PTR;
    return TY_INT;
  }
  return TY_INT;
}

func gen_initializer(ty: int, expr: int): void {
  let st: int = gen_substitute_type(ty);
  if (node_kind[st] == TY_NAMED || node_kind[st] == TY_GENERIC || node_kind[st] == TY_ARRAY) && node_kind[expr] == N_INT && node_value[expr] == 0 then code_emit(C_PUNCT, 19);
  else if node_kind[st] == TY_FLOAT && gen_expr_kind(expr) != TY_FLOAT then {
    code_emit(C_PUNCT, 4); code_emit(C_KW, 18); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 4); gen_expr(expr); code_emit(C_PUNCT, 5);
  } else gen_expr(expr);
}

func gen_assignment(lhs: int, rhs: int): void {
  gen_expr(lhs);
  code_emit(C_PUNCT, 11);
  if gen_expr_kind(lhs) == TY_FLOAT && gen_expr_kind(rhs) != TY_FLOAT then {
    code_emit(C_PUNCT, 4); code_emit(C_KW, 18); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 4); gen_expr(rhs); code_emit(C_PUNCT, 5);
  } else gen_expr(rhs);
}

func compound_c_operator(op: int): int {
  if op == OP_ADD then return 19;
  if op == OP_SUB then return 20;
  if op == OP_MUL then return 21;
  if op == OP_DIV then return 22;
  if op == OP_MOD then return 23;
  if op == OP_BITAND then return 24;
  if op == OP_BITOR then return 25;
  if op == OP_BITXOR then return 26;
  if op == OP_SHL then return 27;
  if op == OP_SHR then return 28;
  return 19;
}

func gen_compound_assignment(lhs: int, op: int, rhs: int): void {
  gen_expr(lhs);
  code_emit(C_OP, compound_c_operator(op));
  if gen_expr_kind(lhs) == TY_FLOAT && gen_expr_kind(rhs) != TY_FLOAT then {
    code_emit(C_PUNCT, 4); code_emit(C_KW, 18); code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 4); gen_expr(rhs); code_emit(C_PUNCT, 5);
  } else gen_expr(rhs);
}

func gen_for_clause(id: int): void {
  if id == 0 then return;
  if node_kind[id] == N_LET then {
    let for_type: int = gen_substitute_type(node_b[id]);
    gen_type(node_kind[for_type], for_type, node_value[for_type]);
    code_emit(C_IDENT, node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_initializer(for_type, node_c[id]);
  } else if node_kind[id] == N_ASSIGN then {
    gen_assignment(node_a[id], node_b[id]);
  } else if node_kind[id] == N_COMPOUND_ASSIGN then {
    gen_compound_assignment(node_a[id], node_value[id], node_b[id]);
  } else if node_kind[id] == N_EXPR then gen_expr(node_a[id]);
}

func ensure_gen_fun_chain(need: int): void {
  if need < gen_fun_chain_cap then return;
  let n: int = next_capacity(gen_fun_chain_cap, need);
  gen_fun_chain_type = grow_ints(gen_fun_chain_type, gen_fun_chain_cap, n);
  gen_fun_chain_cap = n;
}
func gen_fun_decl(ty: int, name: int): void {
  gen_fun_chain_count = 0;
  let current: int = gen_substitute_type(ty);
  while current != 0 && node_kind[current] == TY_FUN {
    ensure_gen_fun_chain(gen_fun_chain_count);
    gen_fun_chain_type[gen_fun_chain_count] = current;
    gen_fun_chain_count = gen_fun_chain_count + 1;
    current = gen_substitute_type(node_b[current]);
  }
  gen_type(node_kind[current], current, node_value[current]);
  let prefix: int = 0;
  while prefix < gen_fun_chain_count { code_emit(C_PUNCT, 4); code_emit(C_PUNCT, 9); prefix = prefix + 1; }
  code_emit(C_IDENT, sym_c_symbol(name));
  let suffix: int = 0;
  while suffix < gen_fun_chain_count {
    code_emit(C_PUNCT, 5); code_emit(C_PUNCT, 6); gen_function_type_params(node_a[gen_fun_chain_type[suffix]]); code_emit(C_PUNCT, 8);
    suffix = suffix + 1;
  }
}

func gen_const_decl(ty: int, name: int): void {
  if node_kind[ty] == TY_PTR then {
    let pointee: int = node_a[ty];
    gen_type(node_kind[pointee], pointee, node_value[pointee]);
    code_emit(C_PUNCT, 1);
    code_emit(C_KW, 16);
    code_emit(C_IDENT, sym_c_symbol(name));
  } else {
    code_emit(C_KW, 16);
    gen_decl(ty, name);
  }
}

func gen_array_base_type(ty: int): void {
  if node_kind[ty] == TY_ARRAY then gen_array_base_type(node_a[ty]);
  else gen_type(node_kind[ty], ty, node_value[ty]);
}
func gen_array_suffixes(ty: int): void {
  if node_kind[ty] == TY_ARRAY then {
    code_emit(C_PUNCT, 2); code_emit(C_INT, node_value[ty]); code_emit(C_PUNCT, 3);
    gen_array_suffixes(node_a[ty]);
  }
}
func gen_decl(ty: int, name: int): void {
  if node_kind[ty] == TY_FUN then gen_fun_decl(ty, name);
  else if node_kind[ty] == TY_ARRAY then {
    let array_base: int = ty;
    while node_kind[array_base] == TY_ARRAY { array_base = node_a[array_base]; }
    if node_kind[array_base] == TY_FUN then {
      let function_return: int = gen_substitute_type(node_b[array_base]);
      gen_type(node_kind[function_return], function_return, node_value[function_return]);
      code_emit(C_PUNCT, 4); code_emit(C_PUNCT, 9); code_emit(C_IDENT, sym_c_symbol(name)); gen_array_suffixes(ty); code_emit(C_PUNCT, 5);
      code_emit(C_PUNCT, 6); gen_function_type_params(node_a[array_base]); code_emit(C_PUNCT, 8);
    } else {
      gen_array_base_type(ty);
      code_emit(C_IDENT, sym_c_symbol(name));
      gen_array_suffixes(ty);
    }
  } else {
    gen_type(node_kind[ty], ty, node_value[ty]);
    code_emit(C_IDENT, sym_c_symbol(name));
  }
}

func gen_stmt(id: int): void {
  gen_source_pos = node_pos[id];
  gen_source_epoch = gen_source_epoch + 1;
  let k: int = node_kind[id];
  if k == N_GLOBAL then {
    gen_alignment(node_aux[id]);
    gen_decl(node_b[id], node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_initializer(node_b[id], node_c[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_CONST then {
    gen_alignment(node_aux[id]);
    gen_const_decl(node_b[id], node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_initializer(node_b[id], node_c[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_LET then {
    let local_type: int = gen_substitute_type(node_b[id]);
    gen_alignment(node_aux[id]);
    gen_decl(local_type, node_a[id]);
    code_emit(C_PUNCT, 11);
    gen_initializer(local_type, node_c[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_ASSIGN then {
    gen_assignment(node_a[id], node_b[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_COMPOUND_ASSIGN then {
    gen_compound_assignment(node_a[id], node_value[id], node_b[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_PRINT || k == N_PRINTLN then {
    code_emit(C_IDENT, -1001);
    let pk: int = gen_expr_kind(node_a[id]);
    let add_newline: int = 0;
    if k == N_PRINTLN then add_newline = 1;
    if pk == TY_STRING then { if add_newline == 1 then code_emit(C_PUNCT, 16); else code_emit(C_PUNCT, 32); }
    else if pk == TY_CHAR then { if add_newline == 1 then code_emit(C_PUNCT, 20); else code_emit(C_PUNCT, 33); }
    else if pk == TY_FLOAT || pk == TY_DOUBLE then { if add_newline == 1 then code_emit(C_PUNCT, 21); else code_emit(C_PUNCT, 34); }
    else if pk == TY_LONG then { if add_newline == 1 then code_emit(C_PUNCT, 28); else code_emit(C_PUNCT, 35); }
    else if pk == TY_LLONG then { if add_newline == 1 then code_emit(C_PUNCT, 29); else code_emit(C_PUNCT, 36); }
    else if pk == TY_PTR then {
      if add_newline == 1 then code_emit(C_PUNCT, 26); else code_emit(C_PUNCT, 37);
      code_emit(C_PUNCT, 4);
      code_emit(C_KW, 4);
      code_emit(C_PUNCT, 1);
      code_emit(C_PUNCT, 5);
    }
    else { if add_newline == 1 then code_emit(C_PUNCT, 15); else code_emit(C_PUNCT, 38); }
    gen_expr(node_a[id]);
    code_emit(C_PUNCT, 8);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_DEFER then {
    gen_defer_push(node_a[id]);
  } else if k == N_TUPLE_BIND then {
    let binding: int = node_a[id];
    let index: int = 0;
    let tuple_ty: int = node_b[id];
    let rhs_temp: int = gen_match_temp_symbol();
    gen_type(node_kind[tuple_ty], tuple_ty, 0);
    code_emit(C_IDENT, rhs_temp);
    code_emit(C_PUNCT, 11);
    gen_expr(node_c[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
    while binding != 0 {
      let elem_ty: int = node_a[tuple_ty];
      let i: int = 0;
      while i < index && elem_ty != 0 { elem_ty = node_next[elem_ty]; i = i + 1; }
      if elem_ty != 0 then gen_type(node_kind[elem_ty], elem_ty, 0);
      else code_emit(C_KW, 1);
      code_emit(C_IDENT, sym_c_symbol(node_value[binding]));
      code_emit(C_PUNCT, 11);
      code_emit(C_IDENT, rhs_temp);
      code_emit(C_PUNCT, 17);
      code_emit(C_IDENT, gen_tuple_field_name(index));
      code_emit(C_PUNCT, 12);
      code_emit(C_NEWLINE, 0);
      binding = node_next[binding];
      index = index + 1;
    }
  } else if k == N_MATCH then {
    gen_match_stmt(id);
  } else if k == N_EXPR then {
    code_emit(C_PUNCT, 4);
    code_emit(C_KW, 4);
    code_emit(C_PUNCT, 5);
    code_emit(C_PUNCT, 4);
    gen_expr(node_a[id]);
    code_emit(C_PUNCT, 5);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
  } else if k == N_RETURN then {
    if emit_defer_count > 0 then code_emit(C_PUNCT, 13);
    gen_emit_all_defers();
    code_emit(C_KW, 5);
    if node_a[id] != 0 then gen_expr(node_a[id]);
    code_emit(C_PUNCT, 12);
    code_emit(C_NEWLINE, 0);
    if emit_defer_count > 0 then code_emit(C_PUNCT, 14);
  } else if k == N_BREAK then {
    if emit_loop_depth > 0 then {
      code_emit(C_PUNCT, 13);
      gen_emit_defer_from(emit_loop_base[emit_loop_depth - 1]);
      code_emit(C_KW, 9);
      code_emit(C_PUNCT, 12);
      code_emit(C_NEWLINE, 0);
      code_emit(C_PUNCT, 14);
    } else {
      code_emit(C_KW, 9);
      code_emit(C_PUNCT, 12);
      code_emit(C_NEWLINE, 0);
    }
  } else if k == N_CONTINUE then {
    if emit_loop_depth > 0 then {
      code_emit(C_PUNCT, 13);
      gen_emit_defer_from(emit_loop_base[emit_loop_depth - 1]);
      code_emit(C_KW, 10);
      code_emit(C_PUNCT, 12);
      code_emit(C_NEWLINE, 0);
      code_emit(C_PUNCT, 14);
    } else {
      code_emit(C_KW, 10);
      code_emit(C_PUNCT, 12);
      code_emit(C_NEWLINE, 0);
    }
  } else if k == N_BLOCK then {
    code_emit(C_PUNCT, 13);
    ensure_emit_scope(emit_scope_depth);
    emit_scope_start[emit_scope_depth] = emit_defer_count;
    emit_scope_depth = emit_scope_depth + 1;
    let item: int = node_a[id];
    while item != 0 {
      gen_stmt(item);
      item = node_next[item];
    }
    emit_scope_depth = emit_scope_depth - 1;
    gen_emit_defer_from(emit_scope_start[emit_scope_depth]);
    emit_defer_count = emit_scope_start[emit_scope_depth];
    code_emit(C_PUNCT, 14);
  } else if k == N_IF then {
    code_emit(C_KW, 6);
    code_emit(C_PUNCT, 6);
    gen_expr_condition_inner(node_a[id]);
    code_emit(C_PUNCT, 8);
    gen_stmt(node_b[id]);
    code_emit(C_KW, 7);
    gen_stmt(node_c[id]);
  } else if k == N_FOR then {
    code_emit(C_KW, 11);
    code_emit(C_PUNCT, 4);
    gen_for_clause(node_a[id]);
    code_emit(C_PUNCT, 12);
    gen_expr_condition_inner(node_b[id]);
    code_emit(C_PUNCT, 12);
    gen_for_clause(node_value[id]);
    code_emit(C_PUNCT, 5);
    ensure_emit_loop(emit_loop_depth);
    emit_loop_base[emit_loop_depth] = emit_defer_count;
    emit_loop_depth = emit_loop_depth + 1;
    let old_step: int = emit_for_step;
    emit_for_step = node_value[id];
    gen_stmt(node_c[id]);
    emit_for_step = old_step;
    emit_loop_depth = emit_loop_depth - 1;
  } else if k == N_WHILE then {
    code_emit(C_KW, 8);
    code_emit(C_PUNCT, 4);
    gen_expr_condition_inner(node_a[id]);
    code_emit(C_PUNCT, 5);
    ensure_emit_loop(emit_loop_depth);
    emit_loop_base[emit_loop_depth] = emit_defer_count;
    emit_loop_depth = emit_loop_depth + 1;
    let old_step: int = emit_for_step;
    emit_for_step = node_aux[id];
    gen_stmt(node_b[id]);
    emit_for_step = old_step;
    emit_loop_depth = emit_loop_depth - 1;
  }
}

func gen_generic_base_equal(formal: int, actual: int): int {
  if formal == 0 || actual == 0 then return 0;
  if node_value[formal] == node_value[actual] then return 1;
  let formal_decl: int = tc_find_struct_ctx(node_value[formal], node_scope[formal]);
  let actual_decl: int = tc_find_struct_ctx(node_value[actual], node_scope[actual]);
  if formal_decl != 0 && actual_decl != 0 && formal_decl == actual_decl then return 1;
  return 0;
}

func gen_unify_formal(formal: int, actual: int): void {
  if formal == 0 || actual == 0 then return;
  if node_kind[formal] == TY_PARAM then {
    if node_kind[actual] == TY_PARAM && node_value[formal] == node_value[actual] then return;
    if gen_bind_find(node_value[formal]) == 0 then gen_bind_add(node_value[formal], actual);
    return;
  }
  if node_kind[formal] == TY_GENERIC && node_kind[actual] == TY_GENERIC then {
    if gen_generic_base_equal(formal, actual) == 0 then return;
    let fp: int = node_a[formal]; let ap: int = node_a[actual];
    while fp != 0 && ap != 0 { gen_unify_formal(fp, ap); fp = node_next[fp]; ap = node_next[ap]; }
    return;
  }
  if node_kind[formal] == TY_PTR && node_kind[actual] == TY_PTR then { gen_unify_formal(node_a[formal], node_a[actual]); return; }
  if node_kind[formal] == TY_ARRAY && node_kind[actual] == TY_ARRAY then { gen_unify_formal(node_a[formal], node_a[actual]); return; }
  if node_kind[formal] == TY_DYN_ARRAY && node_kind[actual] == TY_DYN_ARRAY then { gen_unify_formal(node_a[formal], node_a[actual]); return; }
  if (node_kind[formal] == TY_FUN || node_kind[formal] == TY_CLOSURE) && (node_kind[actual] == TY_FUN || node_kind[actual] == TY_CLOSURE) then {
    let fp_fun: int = node_a[formal]; let ap_fun: int = node_a[actual];
    while fp_fun != 0 && ap_fun != 0 { gen_unify_formal(fp_fun, ap_fun); fp_fun = node_next[fp_fun]; ap_fun = node_next[ap_fun]; }
    gen_unify_formal(node_b[formal], node_b[actual]);
    return;
  }
}

func gen_bind_decl(decl: int, inst: int): void {
  gen_bind_clear();
  if node_kind[decl] == N_GENERIC_FUNC then {
    let p: int = node_c[decl]; let a: int = inst;
    while p != 0 && a != 0 { gen_unify_formal(node_b[p], a); p = node_next[p]; a = node_next[a]; }
    return;
  }
  let p: int = node_c[decl];
  let a: int = node_a[inst];
  while p != 0 && a != 0 { gen_bind_add(node_a[p], a); p = node_next[p]; a = node_next[a]; }
}
func gen_struct_decl_specialized(decl: int, inst: int, cname: int): void {
  gen_bind_decl(decl, inst);
  code_emit(C_KW, 12); code_emit(C_IDENT, cname); code_emit(C_PUNCT, 13);
  let f: int = node_a[decl];
  while f != 0 { let ft: int = gen_substitute_type(node_b[f]); gen_decl(ft, node_a[f]); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0); f = node_next[f]; }
  code_emit(C_PUNCT, 14); code_emit(C_PUNCT, 12); code_emit(C_NEWLINE, 0);
}
func gen_function_params(params: int, is_extern: int): void {
  let p: int = params;
  if p == 0 then code_emit(C_KW, 4);
  else {
    while p != 0 {
      if is_extern == 1 then gen_extern_param(gen_substitute_type(node_b[p]), node_a[p]);
      else gen_decl(gen_substitute_type(node_b[p]), node_a[p]);
      if node_next[p] != 0 then code_emit(C_PUNCT, 7);
      p = node_next[p];
    }
  }
}
func gen_function_type_params(types: int): void {
  let p: int = types;
  if p == 0 then code_emit(C_KW, 4);
