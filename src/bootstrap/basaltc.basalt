  write_string(out, "#if defined(_WIN32)\nstatic BASALT_UNUSED void basalt_sys_drain(int fd,char*buf,size_t cap,size_t*len,int*truncated,int*open_flag){(void)fd;(void)buf;(void)cap;(void)len;(void)truncated;(void)open_flag;}\n#else\nstatic BASALT_UNUSED void basalt_sys_drain(int fd,char*buf,size_t cap,size_t*len,int*truncated,int*open_flag){char chunk[4096];ssize_t n;while((n=read(fd,chunk,sizeof(chunk)))>0){size_t take=0;if(*len<cap){take=(size_t)n;if(take>cap-*len)take=cap-*len;if(take)memcpy(buf+*len,chunk,take);*len+=take;}if((size_t)n>take)*truncated=1;}if(n==0||(n<0&&errno!=EAGAIN&&errno!=EWOULDBLOCK)){close(fd);*open_flag=0;}}\n#endif\n");
