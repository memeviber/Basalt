func ensure_tc_vars(need: int): void {
  if need < tc_var_cap then return;
  let n: int = next_capacity(tc_var_cap, need);
  tc_var_name = grow_ints(tc_var_name, tc_var_cap, n);
  tc_var_kind = grow_ints(tc_var_kind, tc_var_cap, n);
  tc_var_named = grow_ints(tc_var_named, tc_var_cap, n);
  tc_var_elem_kind = grow_ints(tc_var_elem_kind, tc_var_cap, n);
  tc_var_elem_name = grow_ints(tc_var_elem_name, tc_var_cap, n);
  tc_var_type = grow_ints(tc_var_type, tc_var_cap, n);
  tc_var_fun_target = grow_ints(tc_var_fun_target, tc_var_cap, n);
  tc_var_owned = grow_ints(tc_var_owned, tc_var_cap, n);
  tc_var_moved = grow_ints(tc_var_moved, tc_var_cap, n);
  tc_var_borrow_count = grow_ints(tc_var_borrow_count, tc_var_cap, n);
  tc_var_borrow_mut = grow_ints(tc_var_borrow_mut, tc_var_cap, n);
  tc_var_borrow_source = grow_ints(tc_var_borrow_source, tc_var_cap, n);
  tc_var_borrow_mode = grow_ints(tc_var_borrow_mode, tc_var_cap, n);
  tc_var_borrow_parent = grow_ints(tc_var_borrow_parent, tc_var_cap, n);
  tc_var_borrow_param = grow_ints(tc_var_borrow_param, tc_var_cap, n);
  tc_var_param = grow_ints(tc_var_param, tc_var_cap, n);
  tc_var_param_pos = grow_ints(tc_var_param_pos, tc_var_cap, n);
  tc_var_mode = grow_ints(tc_var_mode, tc_var_cap, n);
  tc_var_const = grow_ints(tc_var_const, tc_var_cap, n);
  tc_var_closure_caps = grow_ints(tc_var_closure_caps, tc_var_cap, n);
  tc_var_closure_moved = grow_ints(tc_var_closure_moved, tc_var_cap, n);
  tc_var_ffi_borrowed = grow_ints(tc_var_ffi_borrowed, tc_var_cap, n);
  tc_var_cap = n;
}

func ensure_tc_fun_meta(need: int): void {
  if need < tc_fun_meta_cap then return;
  let n: int = next_capacity(tc_fun_meta_cap, need);
  tc_fun_return_param = grow_ints(tc_fun_return_param, tc_fun_meta_cap, n);
  tc_fun_return_mut = grow_ints(tc_fun_return_mut, tc_fun_meta_cap, n);
  tc_fun_meta_cap = n;
}

func ensure_tc_flow_frames(need: int): void {
  if need < tc_flow_frame_cap then return;
  let n: int = next_capacity(tc_flow_frame_cap, need);
  tc_flow_frame_base = grow_ints(tc_flow_frame_base, tc_flow_frame_cap, n);
  tc_flow_frame_yes = grow_ints(tc_flow_frame_yes, tc_flow_frame_cap, n);
  tc_flow_frame_count = grow_ints(tc_flow_frame_count, tc_flow_frame_cap, n);
  tc_flow_frame_has_yes = grow_ints(tc_flow_frame_has_yes, tc_flow_frame_cap, n);
  tc_flow_frame_field_base = grow_ints(tc_flow_frame_field_base, tc_flow_frame_cap, n);
  tc_flow_frame_field_yes = grow_ints(tc_flow_frame_field_yes, tc_flow_frame_cap, n);
  tc_flow_frame_field_count = grow_ints(tc_flow_frame_field_count, tc_flow_frame_cap, n);
  tc_flow_frame_field_yes_count = grow_ints(tc_flow_frame_field_yes_count, tc_flow_frame_cap, n);
  tc_flow_frame_cap = n;
}

func ensure_tc_flow_log(need: int): void {
  if need < tc_flow_log_cap then return;
  let n: int = next_capacity(tc_flow_log_cap, need);
  tc_flow_log_owned = grow_ints(tc_flow_log_owned, tc_flow_log_cap, n);
  tc_flow_log_moved = grow_ints(tc_flow_log_moved, tc_flow_log_cap, n);
  tc_flow_log_borrow_count = grow_ints(tc_flow_log_borrow_count, tc_flow_log_cap, n);
  tc_flow_log_borrow_mut = grow_ints(tc_flow_log_borrow_mut, tc_flow_log_cap, n);
  tc_flow_log_source = grow_ints(tc_flow_log_source, tc_flow_log_cap, n);
  tc_flow_log_mode = grow_ints(tc_flow_log_mode, tc_flow_log_cap, n);
  tc_flow_log_parent = grow_ints(tc_flow_log_parent, tc_flow_log_cap, n);
  tc_flow_log_borrow_param = grow_ints(tc_flow_log_borrow_param, tc_flow_log_cap, n);
  tc_flow_log_ffi = grow_ints(tc_flow_log_ffi, tc_flow_log_cap, n);
  tc_flow_log_closure_moved = grow_ints(tc_flow_log_closure_moved, tc_flow_log_cap, n);
  tc_flow_log_fun_target = grow_ints(tc_flow_log_fun_target, tc_flow_log_cap, n);
  tc_flow_log_field_root = grow_ints(tc_flow_log_field_root, tc_flow_log_cap, n);
  tc_flow_log_field_name = grow_ints(tc_flow_log_field_name, tc_flow_log_cap, n);
  tc_flow_log_field_fun = grow_ints(tc_flow_log_field_fun, tc_flow_log_cap, n);
  tc_flow_log_cap = n;
}

func tc_flow_append_current(count: int): void {
  ensure_tc_flow_log(tc_flow_log_count + count);
  let i: int = 0;
  while i < count {
    let slot: int = tc_flow_log_count + i;
    tc_flow_log_owned[slot] = tc_var_owned[i]; tc_flow_log_moved[slot] = tc_var_moved[i];
    tc_flow_log_borrow_count[slot] = tc_var_borrow_count[i]; tc_flow_log_borrow_mut[slot] = tc_var_borrow_mut[i];
    tc_flow_log_source[slot] = tc_var_borrow_source[i]; tc_flow_log_mode[slot] = tc_var_borrow_mode[i]; tc_flow_log_parent[slot] = tc_var_borrow_parent[i];
    tc_flow_log_borrow_param[slot] = tc_var_borrow_param[i]; tc_flow_log_ffi[slot] = tc_var_ffi_borrowed[i];
    tc_flow_log_closure_moved[slot] = tc_var_closure_moved[i];
    tc_flow_log_fun_target[slot] = tc_var_fun_target[i];
    i = i + 1;
  }
  tc_flow_log_count = tc_flow_log_count + count;
}

func tc_flow_append_fields(): void {
  ensure_tc_flow_log(tc_flow_field_log_count + tc_field_target_count);
  let i: int = 0;
  while i < tc_field_target_count {
    let slot: int = tc_flow_field_log_count + i;
    tc_flow_log_field_root[slot] = tc_field_target_root[i];
    tc_flow_log_field_name[slot] = tc_field_target_name[i];
    tc_flow_log_field_fun[slot] = tc_field_target_fun[i];
    i = i + 1;
  }
  tc_flow_field_log_count = tc_flow_field_log_count + tc_field_target_count;
}
func tc_flow_field_log_find(start: int, count: int, root: int, name: int): int {
  let i: int = 0;
  while i < count {
    let slot: int = start + i;
    if tc_flow_log_field_root[slot] == root && tc_flow_log_field_name[slot] == name then return slot;
    i = i + 1;
  }
  return 0 - 1;
}
func tc_flow_restore_fields(frame: int): void {
  let start: int = tc_flow_frame_field_base[frame];
  let count: int = tc_flow_frame_field_count[frame];
  let i: int = 0;
  tc_field_target_count = 0;
  ensure_tc_field_targets(count);
  while i < count {
    let slot: int = start + i;
    tc_field_target_root[i] = tc_flow_log_field_root[slot];
    tc_field_target_name[i] = tc_flow_log_field_name[slot];
    tc_field_target_fun[i] = tc_flow_log_field_fun[slot];
    i = i + 1;
  }
  tc_field_target_count = count;
}
func tc_flow_save_base(): void {
  ensure_tc_flow_frames(tc_flow_depth);
  tc_flow_frame_base[tc_flow_depth] = tc_flow_log_count;
  tc_flow_frame_count[tc_flow_depth] = tc_var_count;
  tc_flow_frame_yes[tc_flow_depth] = 0 - 1;
  tc_flow_frame_field_base[tc_flow_depth] = tc_flow_field_log_count;
  tc_flow_frame_field_count[tc_flow_depth] = tc_field_target_count;
  tc_flow_frame_field_yes[tc_flow_depth] = 0 - 1;
  tc_flow_frame_field_yes_count[tc_flow_depth] = 0;
  tc_flow_frame_has_yes[tc_flow_depth] = 0;
  tc_flow_append_current(tc_var_count);
  tc_flow_append_fields();
  tc_flow_depth = tc_flow_depth + 1;
}

func tc_flow_save_yes(): void {
  let frame: int = tc_flow_depth - 1;
  if frame < 0 then return;
  tc_flow_frame_yes[frame] = tc_flow_log_count;
  tc_flow_frame_field_yes[frame] = tc_flow_field_log_count;
  tc_flow_frame_field_yes_count[frame] = tc_field_target_count;
  tc_flow_append_current(tc_flow_frame_count[frame]);
  tc_flow_append_fields();
  tc_var_count = tc_flow_frame_count[frame];
  tc_flow_restore_fields(frame);
  tc_flow_frame_has_yes[frame] = 1;
}

func tc_flow_restore_base(): void {
  let frame: int = tc_flow_depth - 1;
  if frame < 0 then return;
  let start: int = tc_flow_frame_base[frame];
  let count: int = tc_flow_frame_count[frame];
  let i: int = 0;
  while i < count {
    let slot: int = start + i;
    tc_var_owned[i] = tc_flow_log_owned[slot]; tc_var_moved[i] = tc_flow_log_moved[slot];
    tc_var_borrow_count[i] = tc_flow_log_borrow_count[slot]; tc_var_borrow_mut[i] = tc_flow_log_borrow_mut[slot];
    tc_var_borrow_source[i] = tc_flow_log_source[slot]; tc_var_borrow_mode[i] = tc_flow_log_mode[slot]; tc_var_borrow_parent[i] = tc_flow_log_parent[slot];
    tc_var_borrow_param[i] = tc_flow_log_borrow_param[slot]; tc_var_ffi_borrowed[i] = tc_flow_log_ffi[slot];
    tc_var_closure_moved[i] = tc_flow_log_closure_moved[slot];
    tc_var_fun_target[i] = tc_flow_log_fun_target[slot];
    i = i + 1;
  }
  tc_var_count = count;
  tc_flow_restore_fields(frame);
}

func tc_flow_merge_yes(): void {
  let frame: int = tc_flow_depth - 1;
  if frame < 0 then return;
  if tc_flow_frame_has_yes[frame] == 0 then { tc_flow_save_yes(); return; }
  let base: int = tc_flow_frame_base[frame];
  let yes: int = tc_flow_frame_yes[frame];
  let count: int = tc_flow_frame_count[frame];
  let i: int = 0;
  while i < count {
    let slot: int = yes + i;
    if tc_flow_log_moved[slot] == 1 || tc_var_moved[i] == 1 then tc_var_moved[i] = 1;
    if tc_flow_log_owned[slot] == 1 && tc_var_owned[i] == 1 && tc_var_moved[i] == 0 then tc_var_owned[i] = 1; else tc_var_owned[i] = 0;
    if tc_flow_log_borrow_count[slot] > tc_var_borrow_count[i] then tc_var_borrow_count[i] = tc_flow_log_borrow_count[slot];
    if tc_flow_log_borrow_mut[slot] > tc_var_borrow_mut[i] then tc_var_borrow_mut[i] = tc_flow_log_borrow_mut[slot];
    if tc_flow_log_source[slot] == tc_var_borrow_source[i] then { } else tc_var_borrow_source[i] = 0 - 1;
    if tc_flow_log_mode[slot] == tc_var_borrow_mode[i] then { } else tc_var_borrow_mode[i] = 0;
    if tc_flow_log_parent[slot] == tc_var_borrow_parent[i] then { } else tc_var_borrow_parent[i] = 0 - 1;
    if tc_flow_log_borrow_param[slot] == tc_var_borrow_param[i] then { } else tc_var_borrow_param[i] = 0;
    if tc_flow_log_ffi[slot] == 1 || tc_var_ffi_borrowed[i] == 1 then tc_var_ffi_borrowed[i] = 1;
    if tc_flow_log_closure_moved[slot] == 1 || tc_var_closure_moved[i] == 1 then tc_var_closure_moved[i] = 1;
    if tc_flow_log_fun_target[slot] == tc_var_fun_target[i] then { } else tc_var_fun_target[i] = 0;
    i = i + 1;
  }
  let field_yes_start: int = tc_flow_frame_field_yes[frame];
  let field_yes_count: int = tc_flow_frame_field_yes_count[frame];
  let fi: int = 0;
  while fi < tc_field_target_count {
    let yi: int = tc_flow_field_log_find(field_yes_start, field_yes_count, tc_field_target_root[fi], tc_field_target_name[fi]);
    if yi < 0 then tc_field_target_fun[fi] = 0;
    else if tc_flow_log_field_fun[yi] != tc_field_target_fun[fi] then tc_field_target_fun[fi] = 0;
    fi = fi + 1;
  }
  fi = 0;
  while fi < field_yes_count {
    let yslot: int = field_yes_start + fi;
    if tc_flow_log_field_root[yslot] >= 0 && tc_flow_log_field_root[yslot] < count && tc_field_target_get(tc_flow_log_field_root[yslot], tc_flow_log_field_name[yslot]) == 0 then tc_field_target_set(tc_flow_log_field_root[yslot], tc_flow_log_field_name[yslot], 0);
    fi = fi + 1;
  }
  tc_var_count = count;
  if base < 0 then tc_var_count = 0;
}

func tc_flow_end(): void {
  let frame: int = tc_flow_depth - 1;
  if frame < 0 then return;
  tc_flow_log_count = tc_flow_frame_base[frame];
  tc_flow_field_log_count = tc_flow_frame_field_base[frame];
  tc_flow_depth = frame;
}

func ensure_tc_scopes(need: int): void {
  if need < tc_scope_cap then return;
  let n: int = next_capacity(tc_scope_cap, need);
  tc_scope_start = grow_ints(tc_scope_start, tc_scope_cap, n);
  tc_scope_cap = n;
}

func tc_enter_scope(): void {
  ensure_tc_scopes(tc_scope_count);
  tc_scope_start[tc_scope_count] = tc_var_count;
  tc_scope_count = tc_scope_count + 1;
}

func tc_leave_scope(): void {
  let begin: int = 0;
  let i: int = 0;
  let source_index: int = 0;
  if tc_scope_count == 0 then return;
  tc_scope_count = tc_scope_count - 1;
  begin = tc_scope_start[tc_scope_count];
  i = begin;
  while i < tc_var_count {
    source_index = tc_var_borrow_source[i];
    if source_index < 0 then { } else if source_index < begin then {
      if tc_var_borrow_mode[i] == 3 then {
        if tc_var_borrow_mut[source_index] > 0 then tc_var_borrow_mut[source_index] = tc_var_borrow_mut[source_index] - 1;
      } else if tc_var_borrow_mode[i] == 2 then {
        if tc_var_borrow_count[source_index] > 0 then tc_var_borrow_count[source_index] = tc_var_borrow_count[source_index] - 1;
      }
    }
    let closure_cap: int = tc_var_closure_caps[i];
    while closure_cap != 0 {
      let closure_source: int = node_c[closure_cap];
      if closure_source >= 0 then {
        if closure_source < begin then {
          if node_aux[closure_cap] == 3 then {
            if tc_var_borrow_mut[closure_source] > 0 then tc_var_borrow_mut[closure_source] = tc_var_borrow_mut[closure_source] - 1;
          } else {
            if tc_var_borrow_count[closure_source] > 0 then tc_var_borrow_count[closure_source] = tc_var_borrow_count[closure_source] - 1;
          }
        }
      }
      closure_cap = node_next[closure_cap];
    }
    i = i + 1;
  }
  let field_read: int = 0;
  let field_write: int = 0;
  while field_read < tc_field_target_count {
    if tc_field_target_root[field_read] < begin then {
      tc_field_target_root[field_write] = tc_field_target_root[field_read];
      tc_field_target_name[field_write] = tc_field_target_name[field_read];
      tc_field_target_fun[field_write] = tc_field_target_fun[field_read];
      field_write = field_write + 1;
    }
    field_read = field_read + 1;
  }
  tc_field_target_count = field_write;
  tc_var_count = begin;
}

func ensure_tc_path(need: int): void {
  if need < tc_path_cap then return;
  let n: int = next_capacity(tc_path_cap, need);
  tc_path_name = grow_ints(tc_path_name, tc_path_cap, n);
  tc_path_cap = n;
}

func tc_fail(code: int): void {
  if tc_ok == 1 then {
    tc_ok = 0;
    tc_error_code = code;
    if tc_error_pos < 0 then tc_error_pos = current_source_pos;
  }
}

func tc_fail_types(code: int, expected_kind: int, found_kind: int): void {
  if tc_ok == 1 then {
    tc_error_expected_kind = expected_kind;
    tc_error_found_kind = found_kind;
  }
  tc_fail(code);
}

func ensure_tc_bindings(need: int): void {
  if need < tc_bind_cap then return;
  let n: int = next_capacity(tc_bind_cap, need);
  tc_bind_name = grow_ints(tc_bind_name, tc_bind_cap, n);
  tc_bind_type = grow_ints(tc_bind_type, tc_bind_cap, n);
  tc_bind_cap = n;
}

func tc_bind_clear(): void { tc_bind_count = 0; }

func tc_bind_push(): void {
  ensure_tc_bindings(tc_bind_count);
  let need: int = tc_bind_stack_count + tc_bind_count;
  if need >= tc_bind_stack_cap then {
    let n: int = next_capacity(tc_bind_stack_cap, need);
    tc_bind_stack_name = grow_ints(tc_bind_stack_name, tc_bind_stack_cap, n);
    tc_bind_stack_type = grow_ints(tc_bind_stack_type, tc_bind_stack_cap, n);
    tc_bind_stack_cap = n;
  }
  if tc_bind_frame_depth >= tc_bind_frame_cap then {
    let nframe: int = next_capacity(tc_bind_frame_cap, tc_bind_frame_depth);
    tc_bind_frame_base = grow_ints(tc_bind_frame_base, tc_bind_frame_cap, nframe);
    tc_bind_frame_size = grow_ints(tc_bind_frame_size, tc_bind_frame_cap, nframe);
    tc_bind_frame_cap = nframe;
  }
  tc_bind_frame_base[tc_bind_frame_depth] = tc_bind_stack_count;
  tc_bind_frame_size[tc_bind_frame_depth] = tc_bind_count;
  let i: int = 0;
  while i < tc_bind_count { tc_bind_stack_name[tc_bind_stack_count + i] = tc_bind_name[i]; tc_bind_stack_type[tc_bind_stack_count + i] = tc_bind_type[i]; i = i + 1; }
  tc_bind_stack_count = tc_bind_stack_count + tc_bind_count;
  tc_bind_frame_depth = tc_bind_frame_depth + 1;
}

func tc_bind_pop(): void {
  if tc_bind_frame_depth < 1 then { tc_bind_count = 0; return; }
  tc_bind_frame_depth = tc_bind_frame_depth - 1;
  let base: int = tc_bind_frame_base[tc_bind_frame_depth];
  let size: int = tc_bind_frame_size[tc_bind_frame_depth];
  ensure_tc_bindings(size);
  let i: int = 0;
  while i < size { tc_bind_name[i] = tc_bind_stack_name[base + i]; tc_bind_type[i] = tc_bind_stack_type[base + i]; i = i + 1; }
  tc_bind_count = size;
  tc_bind_stack_count = base;
}

func tc_bind_find(name: int): int {
  let i: int = 0;
  while i < tc_bind_count { if tc_bind_name[i] == name then return tc_bind_type[i]; i = i + 1; }
  return 0;
}

func tc_bind_add(name: int, ty: int): int {
  let old: int = tc_bind_find(name);
  if old != 0 then {
    let compatible: int = tc_type_equal(old, ty);
    if node_kind[old] == TY_PARAM && node_kind[ty] == TY_PARAM then compatible = tc_param_type_same(old, ty);
    if compatible == 0 then { tc_fail_types(12, node_kind[old], node_kind[ty]); return 0; }
    return 1;
  }
  ensure_tc_bindings(tc_bind_count);
  tc_bind_name[tc_bind_count] = name;
  tc_bind_type[tc_bind_count] = ty;
  tc_bind_count = tc_bind_count + 1;
  return 1;
}

func tc_bind_explicit_args(fun_node: int, args: int): int {
  let formal: int = node_aux[fun_node];
  let actual: int = args;
  while formal != 0 && actual != 0 {
    tc_check_type(actual);
    if tc_ok == 0 then { tc_fail(76); return 0; }
    formal = node_next[formal];
    actual = node_next[actual];
  }
  if formal != 0 || actual != 0 then { tc_fail(76); return 0; }
  formal = node_aux[fun_node];
  actual = args;
  while formal != 0 {
    if tc_bind_add(node_a[formal], actual) == 0 then { tc_fail(76); return 0; }
    formal = node_next[formal];
    actual = node_next[actual];
  }
  return 1;
}

func tc_is_integer_kind(kind: int): int {
  if kind == TY_INT || kind == TY_BOOL || kind == TY_CHAR || kind == TY_LONG || kind == TY_LLONG then return 1;
  if kind == TY_U8 || kind == TY_U16 || kind == TY_U32 || kind == TY_U64 then return 1;
  if kind == TY_I8 || kind == TY_I16 || kind == TY_I32 || kind == TY_I64 || kind == TY_USIZE then return 1;
  return 0;
}
func tc_is_numeric_kind(kind: int): int {
  if tc_is_integer_kind(kind) == 1 then return 1;
  if kind == TY_FLOAT || kind == TY_DOUBLE then return 1;
  return 0;
}
func tc_is_fixed_integer_kind(kind: int): int {
  if kind == TY_U8 || kind == TY_U16 || kind == TY_U32 || kind == TY_U64 then return 1;
  if kind == TY_I8 || kind == TY_I16 || kind == TY_I32 || kind == TY_I64 || kind == TY_USIZE then return 1;
  return 0;
}
func tc_is_legacy_integer_kind(kind: int): int {
  if kind == TY_INT || kind == TY_BOOL || kind == TY_CHAR || kind == TY_LONG || kind == TY_LLONG then return 1;
  return 0;
}

func tc_decimal_le(raw: int, limit: string): int {
  if raw == 0 then return 1;
  let n: int = sym_len[raw];
  let m: int = 0;
  while limit[m] != '\0' { m = m + 1; }
  if n < m then return 1;
  if n > m then return 0;
  let i: int = 0;
  while i < n {
    if source[sym_start[raw] + i] < limit[i] then return 1;
    if source[sym_start[raw] + i] > limit[i] then return 0;
    i = i + 1;
  }
  return 1;
}

func tc_literal_fits(id: int, target_kind: int): int {
  if id == 0 || node_kind[id] != N_INT || node_aux[id] == 0 then return 1;
  if target_kind == TY_INT then return tc_decimal_le(node_aux[id], "2147483647");
  if target_kind == TY_U8 then return tc_decimal_le(node_aux[id], "255");
  if target_kind == TY_U16 then return tc_decimal_le(node_aux[id], "65535");
  if target_kind == TY_U32 then return tc_decimal_le(node_aux[id], "4294967295");
  if target_kind == TY_U64 then return tc_decimal_le(node_aux[id], "18446744073709551615");
  if target_kind == TY_I8 then return tc_decimal_le(node_aux[id], "127");
  if target_kind == TY_I16 then return tc_decimal_le(node_aux[id], "32767");
  if target_kind == TY_I32 then return tc_decimal_le(node_aux[id], "2147483647");
  if target_kind == TY_I64 then return tc_decimal_le(node_aux[id], "9223372036854775807");
  if target_kind == TY_USIZE then return tc_decimal_le(node_aux[id], "18446744073709551615");
  return 1;
}

func tc_negative_integer_literal_conversion(id: int, target_kind: int, actual_kind: int): int {
  if id == 0 || node_kind[id] != N_BINOP || node_value[id] != OP_SUB then return 0;
  if node_kind[node_a[id]] != N_INT || node_kind[node_b[id]] != N_INT then return 0;
  if node_value[node_a[id]] != 0 || node_value[node_b[id]] < 0 then return 0;
  if tc_is_integer_kind(target_kind) == 0 || tc_is_integer_kind(actual_kind) == 0 then return 0;
  if target_kind == TY_U8 || target_kind == TY_U16 || target_kind == TY_U32 || target_kind == TY_U64 || target_kind == TY_USIZE then return 0;
  if target_kind == TY_I8 then { if node_value[node_b[id]] <= 128 then return 1; return 0; }
  if target_kind == TY_I16 then { if node_value[node_b[id]] <= 32768 then return 1; return 0; }
  if target_kind == TY_I32 || target_kind == TY_INT then { if node_value[node_b[id]] <= 2147483647 then return 1; return 0; }
  if target_kind == TY_I64 || target_kind == TY_LONG || target_kind == TY_LLONG then { if node_value[node_b[id]] <= 2147483647 then return 1; return 0; }
  return 0;
}
func tc_integer_literal_conversion(id: int, target_kind: int, actual_kind: int): int {
  if tc_is_integer_kind(target_kind) == 0 || tc_is_integer_kind(actual_kind) == 0 then return 0;
  if id != 0 && node_kind[id] == N_INT then {
    if tc_literal_fits(id, target_kind) == 0 then return 0;
    return 1;
  }
  return tc_negative_integer_literal_conversion(id, target_kind, actual_kind);
}

func tc_type_is_structural(kind: int): int {
  if kind == TY_PTR || kind == TY_ARRAY || kind == TY_DYN_ARRAY || kind == TY_GENERIC || kind == TY_TUPLE || kind == TY_CLOSURE || kind == TY_VARIANT then return 1;
  return 0;
}

func tc_type_equal(a: int, b: int): int {
  if a == 0 || b == 0 then return 0;
  let ak: int = node_kind[a]; let bk: int = node_kind[b];
  if ak == TY_PARAM || bk == TY_PARAM then { if ak == bk then return 1; return 0; }
  if ak != bk then return 0;
  if ak == TY_INT || ak == TY_BOOL || ak == TY_STRING || ak == TY_CHAR || ak == TY_FLOAT || ak == TY_DOUBLE || ak == TY_LONG || ak == TY_LLONG || ak == TY_VOID || tc_is_fixed_integer_kind(ak) == 1 then return 1;
  if ak == TY_NAMED then { if node_value[a] == node_value[b] then return 1; return 0; }
  if ak == TY_VARIANT then { if node_value[a] == node_value[b] && node_aux[a] == node_aux[b] then return 1; return 0; }
  if ak == TY_PTR then return tc_type_equal(node_a[a], node_a[b]);
  if ak == TY_ARRAY then return node_value[a] == node_value[b] && tc_type_equal(node_a[a], node_a[b]);
  if ak == TY_DYN_ARRAY then return tc_type_equal(node_a[a], node_a[b]);
  if ak == TY_GENERIC then {
    if node_value[a] != node_value[b] then return 0;
    let x: int = node_a[a]; let y: int = node_a[b];
    while x != 0 && y != 0 { if tc_type_equal(x, y) == 0 then return 0; x = node_next[x]; y = node_next[y]; }
    if x != 0 || y != 0 then return 0;
    return 1;
  }
  if ak == TY_TUPLE then {
    let x: int = node_a[a]; let y: int = node_a[b];
    while x != 0 && y != 0 { if tc_type_equal(x, y) == 0 then return 0; x = node_next[x]; y = node_next[y]; }
    if x != 0 || y != 0 then return 0;
    return 1;
  }
  if ak == TY_FUN || ak == TY_CLOSURE then {
    if tc_type_equal(node_b[a], node_b[b]) == 0 then return 0;
    let x: int = node_a[a]; let y: int = node_a[b];
    while x != 0 && y != 0 { if tc_type_equal(x, y) == 0 then return 0; x = node_next[x]; y = node_next[y]; }
    if x != 0 || y != 0 then return 0;
    return 1;
  }
  return 1;
}

func tc_signature_type(entry: int): int {
  if entry == 0 then return 0;
  let args: int = 0;
  let p: int = node_c[entry];
  while p != 0 {
    let src: int = node_b[p];
    let q: int = ast_node(node_kind[src], node_a[src], node_b[src], node_c[src], node_value[src], node_aux[src]);
    if args == 0 then args = q; else args = ast_link(args, q);
    p = node_next[p];
  }
  let ret: int = node_b[entry];
  if ret != 0 then ret = ast_node(node_kind[ret], node_a[ret], node_b[ret], node_c[ret], node_value[ret], node_aux[ret]);
  return ast_node(TY_FUN, args, ret, 0, 0, 0);
}

func tc_type_node_from_summary(kind: int, name: int, elem_kind: int, elem_name: int): int {
  if kind == TY_GENERIC then { if name != 0 then return name; }
  if kind == TY_TUPLE then { if name != 0 then return name; }
  if kind == TY_PARAM then { if name != 0 && node_kind[name] == TY_PARAM then return name; }
  if kind == TY_ARRAY then { if name != 0 && node_kind[name] == TY_ARRAY then return name; }
  if kind == TY_CLOSURE then { if name != 0 then return name; }
  if kind == TY_NAMED then return ast_node(TY_NAMED, 0, 0, 0, name, 0);
  if kind == TY_VARIANT then return ast_node(TY_VARIANT, 0, 0, 0, name, elem_name);
  if kind == TY_PTR || kind == TY_DYN_ARRAY then {
    let child: int = 0;
    if elem_name != 0 && tc_type_is_structural(elem_kind) == 1 then child = elem_name;
    else if elem_kind == TY_PARAM && elem_name != 0 && node_kind[elem_name] == TY_PARAM then child = elem_name;
    else child = tc_type_node_from_summary(elem_kind, elem_name, 0, 0);
    return ast_node(kind, child, 0, 0, 0, 0);
  }
  return ast_node(kind, 0, 0, 0, 0, 0);
}

func tc_generic_moves_array(fun_node: int): int {
  if fun_node == 0 then return 0;
  let ret: int = node_b[fun_node];
  if ret != 0 && node_kind[ret] == TY_DYN_ARRAY then return 1;
  let name: int = node_value[fun_node];
  if name == 0 || sym_len[name] < 4 then return 0;
  let s: int = sym_start[name];
  let n: int = sym_len[name];
  if source[s + n - 4] == 102 && source[s + n - 3] == 114 && source[s + n - 2] == 101 && source[s + n - 1] == 101 then return 1;
  return 0;
}

func tc_mark_float_expr(id: int, expected_kind: int): void {
  if id == 0 then return;
  if node_kind[id] == N_FLOAT then {
    if expected_kind == TY_FLOAT then node_aux[id] = TY_FLOAT;
    else if expected_kind == TY_DOUBLE then node_aux[id] = 0;
  } else if expected_kind == TY_FLOAT && node_kind[id] == N_BINOP then {
    tc_mark_float_expr(node_a[id], TY_FLOAT);
    tc_mark_float_expr(node_b[id], TY_FLOAT);
  }
}

func tc_match_generic_call_arg(formal: int, actual: int, expr: int): void {
  if formal != 0 && expr != 0 && node_kind[formal] == TY_PARAM then {
    let bound: int = tc_bind_find(node_value[formal]);
    if node_kind[expr] == N_INT && bound != 0 && tc_is_integer_kind(node_kind[bound]) == 1 then return;
  }
  tc_match_generic(formal, actual);
}

func tc_match_generic(formal: int, actual: int): void {
  if formal == 0 || actual == 0 then { tc_fail_types(12, 0, 0); return; }
  if node_kind[formal] == TY_PARAM then { if tc_bind_add(node_value[formal], actual) == 0 then return; return; }
  if node_kind[formal] == TY_GENERIC then {
    tc_check_type(formal);
    tc_check_type(actual);
    if node_kind[actual] != TY_GENERIC || node_value[formal] != node_value[actual] then { tc_fail_types(12, node_kind[formal], node_kind[actual]); return; }
    let f: int = node_a[formal]; let a: int = node_a[actual];
    while f != 0 && a != 0 { tc_match_generic(f, a); f = node_next[f]; a = node_next[a]; }
    if f != 0 || a != 0 then tc_fail(13);
    return;
  }
  if node_kind[formal] == TY_TUPLE then {
    if node_kind[actual] != TY_TUPLE then { tc_fail_types(12, node_kind[formal], node_kind[actual]); return; }
    let f: int = node_a[formal]; let a: int = node_a[actual];
    while f != 0 && a != 0 { tc_match_generic(f, a); f = node_next[f]; a = node_next[a]; }
    if f != 0 || a != 0 then tc_fail(13);
    return;
  }
  if node_kind[formal] == TY_FUN && node_kind[actual] == TY_FUN then {
    let fp: int = node_a[formal]; let ap: int = node_a[actual];
    while fp != 0 && ap != 0 { tc_match_generic(fp, ap); fp = node_next[fp]; ap = node_next[ap]; }
    if fp != 0 || ap != 0 then { tc_fail(13); return; }
    tc_match_generic(node_b[formal], node_b[actual]);
    return;
  }
  if node_kind[formal] == TY_PTR && node_kind[actual] == TY_PTR then { tc_match_generic(node_a[formal], node_a[actual]); return; }
  if node_kind[formal] == TY_ARRAY && node_kind[actual] == TY_ARRAY then {
    if node_value[formal] != node_value[actual] then { tc_fail_types(12, TY_ARRAY, TY_ARRAY); return; }
    tc_match_generic(node_a[formal], node_a[actual]);
    return;
  }
  if node_kind[formal] == TY_DYN_ARRAY && node_kind[actual] == TY_DYN_ARRAY then { tc_match_generic(node_a[formal], node_a[actual]); return; }
  tc_type_node(formal);
  if tc_type_equal(formal, actual) == 0 then tc_fail_types(12, node_kind[formal], node_kind[actual]);
}

func tc_substitute_type(ty: int): int {
  if ty == 0 then return 0;
  if node_kind[ty] == TY_PARAM then {
    let b: int = tc_bind_find(node_value[ty]);
    if b != 0 && b != ty then {
      if node_kind[b] == TY_PARAM && node_value[b] == node_value[ty] then return ast_node(TY_PARAM, node_a[ty], node_b[ty], node_c[ty], node_value[ty], node_aux[ty]);
      return tc_substitute_type(b);
    }
    return ast_node(TY_PARAM, node_a[ty], node_b[ty], node_c[ty], node_value[ty], node_aux[ty]);
  }
  if node_kind[ty] == TY_PTR then return ast_node(TY_PTR, tc_substitute_type(node_a[ty]), 0, 0, 0, 0);
  if node_kind[ty] == TY_ARRAY then return ast_node(TY_ARRAY, tc_substitute_type(node_a[ty]), 0, 0, node_value[ty], 0);
  if node_kind[ty] == TY_DYN_ARRAY then return ast_node(TY_DYN_ARRAY, tc_substitute_type(node_a[ty]), 0, 0, 0, 0);
  if node_kind[ty] == TY_GENERIC then {
    let args: int = 0; let p: int = node_a[ty];
    while p != 0 { let q: int = tc_substitute_type(p); if args == 0 then args = q; else args = ast_link(args, q); p = node_next[p]; }
    let result: int = ast_node(TY_GENERIC, args, 0, 0, node_value[ty], 0);
    node_scope[result] = node_scope[ty];
    return result;
  }
  if node_kind[ty] == TY_TUPLE then {
    let items: int = 0; let p: int = node_a[ty];
    while p != 0 { let q: int = tc_substitute_type(p); if items == 0 then items = q; else items = ast_link(items, q); p = node_next[p]; }
    return ast_node(TY_TUPLE, items, 0, 0, 0, 0);
  }
  if node_kind[ty] == TY_FUN || node_kind[ty] == TY_CLOSURE then {
    let args: int = 0; let p2: int = node_a[ty];
    while p2 != 0 { let q2: int = tc_substitute_type(p2); if args == 0 then args = q2; else args = ast_link(args, q2); p2 = node_next[p2]; }
    return ast_node(node_kind[ty], args, tc_substitute_type(node_b[ty]), 0, 0, 0);
  }
  return ast_node(node_kind[ty], node_a[ty], node_b[ty], node_c[ty], node_value[ty], node_aux[ty]);
}

func tc_same(a_kind: int, a_name: int, b_kind: int, b_name: int): int {
  if a_kind == TY_PTR && b_kind == TY_PTR then return 1;
  if a_kind == b_kind then {
    if a_kind == TY_NAMED then {
      if a_name == b_name then return 1;
      return 0;
    }
    return 1;
  }
  if tc_is_integer_kind(a_kind) == 1 && tc_is_integer_kind(b_kind) == 1 then return 1;
  if (a_kind == TY_VOID && b_kind == TY_INT) then return 1;
  if (a_kind == TY_INT && b_kind == TY_VOID) then return 1;
    return 0;
}
func tc_array_elem_same(a_kind: int, a_name: int, b_kind: int, b_name: int): int {
  if tc_is_legacy_integer_kind(a_kind) == 1 && tc_is_legacy_integer_kind(b_kind) == 1 then return 1;
  if a_kind != b_kind then return 0;
  if a_kind == TY_NAMED then { if a_name == b_name then return 1; return 0; }
  return 1;
}
func tc_param_type_same(a_name: int, b_name: int): int {
  if a_name == b_name then return 1;
  if a_name == 0 || b_name == 0 then return 0;
  if node_kind[a_name] != TY_PARAM || node_kind[b_name] != TY_PARAM then return 0;
  if node_value[a_name] == node_value[b_name] then return 1;
  return 0;
}
func tc_same_full(a_kind: int, a_name: int, a_elem_kind: int, a_elem_name: int, b_kind: int, b_name: int, b_elem_kind: int, b_elem_name: int): int {
  if a_kind == TY_PARAM || b_kind == TY_PARAM then { if a_kind == TY_PARAM && b_kind == TY_PARAM then return tc_param_type_same(a_name, b_name); return 0; }
  if a_kind == TY_GENERIC || b_kind == TY_GENERIC then {
    if a_kind == TY_GENERIC && b_kind == TY_GENERIC then return tc_type_equal(a_name, b_name);
    return 0;
  }
  if a_kind == TY_TUPLE || b_kind == TY_TUPLE then {
    if a_kind == TY_TUPLE && b_kind == TY_TUPLE then return tc_type_equal(a_name, b_name);
    return 0;
  }
  if a_kind == TY_CLOSURE || b_kind == TY_CLOSURE then {
    if a_kind == TY_CLOSURE && b_kind == TY_CLOSURE then return tc_type_equal(a_name, b_name);
    return 0;
  }
  if a_kind == TY_ARRAY && b_kind == TY_ARRAY then {
    if a_name != 0 && b_name != 0 then return tc_type_equal(a_name, b_name);
    return 0;
  }
  if a_kind == TY_PTR && b_kind == TY_PTR then {
    if a_elem_kind == TY_VOID || b_elem_kind == TY_VOID then return 1;
    if a_elem_kind != b_elem_kind then return 0;
    if a_elem_kind == TY_NAMED && a_elem_name != b_elem_name then return 0;
    if tc_type_is_structural(a_elem_kind) == 1 && a_elem_name != 0 && b_elem_name != 0 then return tc_type_equal(a_elem_name, b_elem_name);
    return 1;
  }
  if a_kind == b_kind then {
    if a_kind == TY_NAMED then { if a_name == b_name then return 1; return 0; }
    if a_kind == TY_DYN_ARRAY then {
      if a_elem_kind != b_elem_kind then return 0;
      if a_elem_kind == TY_NAMED && a_elem_name != b_elem_name then return 0;
      if tc_type_is_structural(a_elem_kind) == 1 && a_elem_name != 0 && b_elem_name != 0 then return tc_type_equal(a_elem_name, b_elem_name);
    }
    return 1;
  }

  if tc_is_legacy_integer_kind(a_kind) == 1 && tc_is_legacy_integer_kind(b_kind) == 1 then return 1;
  if (a_kind == TY_VOID && b_kind == TY_INT) || (a_kind == TY_INT && b_kind == TY_VOID) then return 1;
  return 0;
}

func tc_ptr_diff_ok(a_kind: int, a_elem_kind: int, a_elem_name: int, b_kind: int, b_elem_kind: int, b_elem_name: int): int {
  if a_kind != TY_PTR || b_kind != TY_PTR then return 0;
  if a_elem_kind == TY_VOID || b_elem_kind == TY_VOID then return 0;
  if a_elem_kind != b_elem_kind then return 0;
  if a_elem_kind == TY_NAMED && a_elem_name != b_elem_name then return 0;
  return 1;
}

func tc_find_struct(name: int): int {
  let item: int = node_a[tc_root];
  while item != 0 {
    if (node_kind[item] == N_STRUCT || node_kind[item] == N_GENERIC_STRUCT) && node_value[item] == name then return item;
    item = node_next[item];
  }
  return 0;
}

func tc_find_struct_ctx(name: int, ns: int): int {
  let exact: int = tc_find_struct(name);
  if exact != 0 then return exact;
  if ns == 0 then return 0;
  let scope: int = ns;
  while scope != 0 {
    let candidate: int = sym_qualified(scope, name);
    let item: int = tc_find_struct(candidate);
    if item != 0 then return item;
    let split: int = sym_find_last_scope(scope);
    if split == 0 then scope = 0;
    else scope = sym_prefix_scope(scope, split);
  }
  return 0;
}

func tc_find_enum(name: int): int {
  let item: int = node_a[tc_root];
  while item != 0 {
    if node_kind[item] == N_ENUM && node_value[item] == name then return item;
    item = node_next[item];
  }
  return 0;
}

func tc_find_enum_ctx(name: int, ns: int): int {
  let exact: int = tc_find_enum(name);
  if exact != 0 then return exact;
  if ns == 0 then return 0;
  let scope: int = ns;
  while scope != 0 {
    let candidate: int = sym_qualified(scope, name);
    let item: int = tc_find_enum(candidate);
    if item != 0 then return item;
    let split: int = sym_find_last_scope(scope);
    if split == 0 then scope = 0;
    else scope = sym_prefix_scope(scope, split);
  }
  return 0;
}

func tc_generic_arity(decl: int): int {
  if decl == 0 || node_kind[decl] != N_GENERIC_STRUCT then return 0;
  let n: int = 0; let p: int = node_c[decl];
  while p != 0 { n = n + 1; p = node_next[p]; }
  return n;
}

func tc_generic_arg_count(ty: int): int {
  if ty == 0 || node_kind[ty] != TY_GENERIC then return 0;
  let n: int = 0; let p: int = node_a[ty];
  while p != 0 { n = n + 1; p = node_next[p]; }
  return n;
}

func tc_named_exists_ctx(name: int, ns: int): int {
  if tc_find_struct_ctx(name, ns) != 0 then return 1;
  if tc_find_enum_ctx(name, ns) != 0 then return 1;
  return 0;
}

func tc_named_exists(name: int): int {
  if tc_find_struct(name) != 0 then return 1;
  if tc_find_enum(name) != 0 then return 1;
  return 0;
}

func tc_check_type(ty: int): void {
  if ty == 0 then { tc_fail(1); return; }
  let k: int = node_kind[ty];
  if k == TY_NAMED then {
    let resolved_struct: int = tc_find_struct_ctx(node_value[ty], node_scope[ty]);
    let resolved_enum: int = tc_find_enum_ctx(node_value[ty], node_scope[ty]);
    if resolved_struct != 0 then node_value[ty] = node_value[resolved_struct];
    else if resolved_enum != 0 then node_value[ty] = node_value[resolved_enum];
    else tc_fail(2);
  } else if k == TY_GENERIC then {
    let s: int = tc_find_struct_ctx(node_value[ty], node_scope[ty]);
    if s == 0 || node_kind[s] != N_GENERIC_STRUCT then tc_fail(2);
    else {
      node_value[ty] = node_value[s];
      if tc_generic_arity(s) != tc_generic_arg_count(ty) then tc_fail(37);
      let a: int = node_a[ty]; while a != 0 { tc_check_type(a); a = node_next[a]; }
    }
  } else if k == TY_PTR then tc_check_type(node_a[ty]);
  else if k == TY_ARRAY then tc_check_type(node_a[ty]);
  else if k == TY_DYN_ARRAY then tc_check_type(node_a[ty]);
  else if k == TY_TUPLE then {
    let item: int = node_a[ty];
    while item != 0 { tc_check_type(item); item = node_next[item]; }
  } else if k == TY_FUN then {

    let p: int = node_a[ty];
    while p != 0 { tc_check_type(p); p = node_next[p]; }
    tc_check_type(node_b[ty]);
  }
}

func tc_cycle_struct(name: int): int {
  let i: int = 0;
  while i < tc_path_count {
    if tc_path_name[i] == name then return 1;
    i = i + 1;
  }
  let s: int = tc_find_struct(name);
  if s == 0 then return 0;
  ensure_tc_path(tc_path_count);
  tc_path_name[tc_path_count] = name;
  tc_path_count = tc_path_count + 1;
  let f: int = node_a[s];
  let bad: int = 0;
  while f != 0 {
    if tc_cycle_type(node_b[f]) == 1 then bad = 1;
    f = node_next[f];
  }
  tc_path_count = tc_path_count - 1;
  return bad;
}
func tc_cycle_type(ty: int): int {
  if ty == 0 then return 0;
  if node_kind[ty] == TY_PTR then return 0;
  if node_kind[ty] == TY_FUN then return 0;
  if node_kind[ty] == TY_ARRAY then return tc_cycle_type(node_a[ty]);
  if node_kind[ty] == TY_DYN_ARRAY then return 0;
  if node_kind[ty] == TY_NAMED then return tc_cycle_struct(node_value[ty]);
  if node_kind[ty] == TY_GENERIC then return 0;
  return 0;
}


func tc_release_name(name: int): int {
  if bi_has_flag(name, BI_FLAG_CONSUME) == 1 then return 1;
  return 0;
}

func tc_owned_initializer(id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_CLOSURE then return 1;
  if node_kind[id] == N_MOVE then return 1;
  if node_kind[id] != N_CALL then return 0;
  if bi_has_flag(node_value[id], BI_FLAG_OWNED) == 1 then return 1;
  return 0;
}
func tc_is_owner_kind(kind: int): int {
  if kind == TY_CLOSURE then return 1;
  if kind == TY_DYN_ARRAY then return 1;
  if kind == TY_GENERIC then return 1;
  return 0;
}
func tc_is_owner_type(ty: int): int {
  if ty == 0 then return 0;
  if tc_is_owner_kind(node_kind[ty]) == 1 then return 1;
  return 0;
}
func tc_is_place(id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_VAR || node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS then return 1;
  return 0;
}
func tc_place_is_const(id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_VAR then {
    if tc_lookup_var(node_value[id]) == 1 && tc_var_const[tc_last_var_index] == 1 then return 1;
    return 0;
  }
  if node_kind[id] == N_FIELD_ACCESS || node_kind[id] == N_INDEX then {
    let base: int = node_a[id];
    if node_kind[base] == N_VAR && tc_lookup_var(node_value[base]) == 1 && tc_var_const[tc_last_var_index] == 1 && tc_last_var_type != 0 && node_kind[tc_last_var_type] == TY_PTR then return 0;
    return tc_place_is_const(base);
  }
  if node_kind[id] == N_DEREF then return 0;
  return 0;
}
func tc_place_root(id: int): int {
  if id == 0 then return 0 - 1;
  if node_kind[id] == N_VAR then {
    if tc_lookup_var(node_value[id]) == 1 then {
      if tc_var_borrow_source[tc_last_var_index] >= 0 then return tc_var_borrow_source[tc_last_var_index];
      return tc_last_var_index;
    }
    return 0 - 1;
  }
  if node_kind[id] == N_DEREF then {
    tc_expr(node_a[id]);
    if tc_expr_borrow_source >= 0 then return tc_expr_borrow_source;
    if node_kind[node_a[id]] == N_VAR && tc_lookup_var(node_value[node_a[id]]) == 1 then return tc_last_var_index;
    return 0 - 1;
  }
  if node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS then {
    tc_expr(node_a[id]);
    if tc_expr_borrow_source >= 0 then return tc_expr_borrow_source;
    if node_kind[node_a[id]] == N_VAR && tc_lookup_var(node_value[node_a[id]]) == 1 then return tc_last_var_index;
  }
  return 0 - 1;
}
func tc_place_borrow_param(id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_VAR && tc_lookup_var(node_value[id]) == 1 then return tc_var_borrow_param[tc_last_var_index];
  tc_expr(id);
  return tc_expr_borrow_param;
}
func tc_nth_arg(head: int, wanted: int): int {
  if wanted <= 0 then return 0;
  let p: int = head; let index: int = 1;
  while p != 0 {
    if index == wanted then return p;
    index = index + 1; p = node_next[p];
  }
  return 0;
}
func tc_provenance(id: int): int {
  if id == 0 then return 0 - 1;
  if node_kind[id] == N_VAR then {
    if tc_lookup_var(node_value[id]) == 0 then return 0 - 1;
    if tc_var_borrow_source[tc_last_var_index] >= 0 then return tc_var_borrow_source[tc_last_var_index];
    if tc_var_borrow_param[tc_last_var_index] > 0 then return tc_last_var_index;
    return 0 - 1;
  }
  if node_kind[id] == N_ADDRESS then {
    let address_source: int = tc_provenance(node_a[id]);
    if address_source >= 0 then return address_source;
    return tc_place_root(node_a[id]);
  }
  if node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS then {
    let place_source: int = tc_provenance(node_a[id]);
    if place_source >= 0 then return place_source;
    return tc_place_root(node_a[id]);
  }
  if node_kind[id] == N_CALL then {
    let fun: int = tc_find_function_ctx(node_value[id], node_scope[id]);
    if fun != 0 && tc_fun_return_param[fun] > 0 then return tc_provenance(tc_nth_arg(node_a[id], tc_fun_return_param[fun]));
  }
  return 0 - 1;
}
func tc_provenance_origin(id: int): int {
  if id == 0 then return 0 - 1;
  if node_kind[id] == N_VAR then {
    if tc_lookup_var(node_value[id]) == 1 then return tc_last_var_index;
    return 0 - 1;
  }
  if node_kind[id] == N_ADDRESS || node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS then return tc_provenance_origin(node_a[id]);
  if node_kind[id] == N_CALL then {
    let fun: int = tc_find_function_ctx(node_value[id], node_scope[id]);
    if fun != 0 then {
      ensure_tc_fun_meta(fun);
      if tc_fun_return_param[fun] > 0 then return tc_provenance_origin(tc_nth_arg(node_a[id], tc_fun_return_param[fun]));
    }
  }
  return 0 - 1;
}
func tc_is_loan_ancestor(ancestor: int, origin: int): int {
  if ancestor < 0 || origin < 0 then return 0;
  let current: int = origin;
  let steps: int = 0;
  while current >= 0 && current < tc_var_count && steps <= tc_var_count {
    if current == ancestor then return 1;
    current = tc_var_borrow_parent[current];
    steps = steps + 1;
  }
  return 0;
}
func tc_borrow_conflict_from(root: int, origin: int, requested_mut: int): int {
  if root < 0 then return 0;
  let i: int = 0;
  while i < tc_var_count {
    if tc_var_borrow_source[i] == root && (tc_var_borrow_mode[i] == 2 || tc_var_borrow_mode[i] == 3) then {
      if i == origin || tc_is_loan_ancestor(i, origin) == 1 then { }
      else if requested_mut == 1 || tc_var_borrow_mode[i] == 3 then return 1;
    }
    i = i + 1;
  }
  return 0;
}
func tc_provenance_param(id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_VAR then {
    if tc_lookup_var(node_value[id]) == 1 then return tc_var_borrow_param[tc_last_var_index];
    return 0;
  }
  if node_kind[id] == N_ADDRESS || node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS then return tc_provenance_param(node_a[id]);
  if node_kind[id] == N_CALL then {
    let fun: int = tc_find_function_ctx(node_value[id], node_scope[id]);
    if fun != 0 && tc_fun_return_param[fun] > 0 then return tc_provenance_param(tc_nth_arg(node_a[id], tc_fun_return_param[fun]));
  }
  return 0;
}
func tc_provenance_mut(id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_ADDRESS then {
    if node_value[id] == 1 then return 1;
    return tc_provenance_mut(node_a[id]);
  }
  if node_kind[id] == N_VAR then {
    if tc_lookup_var(node_value[id]) == 1 && tc_var_borrow_mode[tc_last_var_index] == 3 then return 1;
    return 0;
  }
  if node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS then return tc_provenance_mut(node_a[id]);
  return 0;
}
func ensure_tc_field_targets(need: int): void {
  if need < tc_field_target_cap then return;
  let n: int = next_capacity(tc_field_target_cap, need);
  tc_field_target_root = grow_ints(tc_field_target_root, tc_field_target_cap, n);
  tc_field_target_name = grow_ints(tc_field_target_name, tc_field_target_cap, n);
  tc_field_target_fun = grow_ints(tc_field_target_fun, tc_field_target_cap, n);
  tc_field_target_cap = n;
}
func tc_field_target_get(root: int, name: int): int {
  let i: int = tc_field_target_count - 1;
  while i >= 0 {
    if tc_field_target_root[i] == root && tc_field_target_name[i] == name then return tc_field_target_fun[i];
    i = i - 1;
  }
  return 0;
}
func tc_field_target_set(root: int, name: int, target: int): void {
  if root < 0 || name == 0 then return;
  let i: int = tc_field_target_count - 1;
  while i >= 0 {
    if tc_field_target_root[i] == root && tc_field_target_name[i] == name then { tc_field_target_fun[i] = target; return; }
    i = i - 1;
  }
  ensure_tc_field_targets(tc_field_target_count);
  tc_field_target_root[tc_field_target_count] = root;
  tc_field_target_name[tc_field_target_count] = name;
  tc_field_target_fun[tc_field_target_count] = target;
  tc_field_target_count = tc_field_target_count + 1;
}
func tc_field_target_root_for_place(id: int): int {
  if id == 0 then return 0 - 1;
  if node_kind[id] == N_VAR then {
    if tc_lookup_var(node_value[id]) == 1 then return tc_last_var_index;
    return 0 - 1;
  }
  if node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS then return tc_place_root(id);
  return 0 - 1;
}
func tc_fun_type_has_sensitive_param(ty: int): int {
  if ty == 0 || node_kind[ty] != TY_FUN then return 0;
  let p: int = node_a[ty];
  while p != 0 {
    let pk: int = node_kind[p];
    if pk == TY_PTR || pk == TY_STRING || pk == TY_DYN_ARRAY || pk == TY_GENERIC || pk == TY_CLOSURE then return 1;
    p = node_next[p];
  }
  return 0;
}
func tc_contract_param_position(fun: int, name: int): int {
  if fun == 0 then return 0;
  let p: int = node_c[fun]; let index: int = 1;
  while p != 0 {
    if node_a[p] == name && (node_aux[p] == 2 || node_aux[p] == 3) then return index;
    index = index + 1; p = node_next[p];
  }
  return 0;
}
func tc_contract_record(fun: int, candidate: int, mutable: int): void {
  if candidate <= 0 then return;
  ensure_tc_fun_meta(fun);
  if tc_fun_return_param[fun] == 0 then { tc_fun_return_param[fun] = candidate; tc_fun_return_mut[fun] = mutable; }
  else if tc_fun_return_param[fun] != candidate || tc_fun_return_mut[fun] != mutable then { tc_fun_return_param[fun] = 0 - 1; tc_fun_return_mut[fun] = 0; }
}
func tc_contract_expr_param(fun: int, id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_VAR then return tc_contract_param_position(fun, node_value[id]);
  if node_kind[id] == N_ADDRESS || node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS || node_kind[id] == N_MOVE then return tc_contract_expr_param(fun, node_a[id]);
  if node_kind[id] == N_CALL then {
    let called: int = tc_find_function_ctx(node_value[id], node_scope[id]);
    if called != 0 then {
      ensure_tc_fun_meta(called);
      if tc_fun_return_param[called] > 0 then return tc_contract_expr_param(fun, tc_nth_arg(node_a[id], tc_fun_return_param[called]));
    }
  }
  return 0;
}
func tc_contract_expr_mut(fun: int, id: int): int {
  if id == 0 then return 0;
  if node_kind[id] == N_ADDRESS then return node_value[id];
  if node_kind[id] == N_VAR then {
    let p: int = node_c[fun];
    while p != 0 { if node_a[p] == node_value[id] && node_aux[p] == 3 then return 1; p = node_next[p]; }
    return 0;
  }
  if node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS || node_kind[id] == N_MOVE then return tc_contract_expr_mut(fun, node_a[id]);
  if node_kind[id] == N_CALL then {
    let called: int = tc_find_function_ctx(node_value[id], node_scope[id]);
    if called != 0 then { ensure_tc_fun_meta(called); if tc_fun_return_param[called] > 0 then return tc_fun_return_mut[called]; }
  }
  return 0;
}
func tc_contract_scan_expr(fun: int, id: int): void {
  if id == 0 then return;
  if node_kind[id] == N_ADDRESS || node_kind[id] == N_VAR || node_kind[id] == N_DEREF || node_kind[id] == N_INDEX || node_kind[id] == N_FIELD_ACCESS || node_kind[id] == N_MOVE || node_kind[id] == N_CALL then {
    let pos: int = tc_contract_expr_param(fun, id);
    if pos > 0 then tc_contract_record(fun, pos, tc_contract_expr_mut(fun, id));
    return;
  }
}
func tc_contract_scan_stmt(fun: int, id: int): void {
  if id == 0 then return;
  let k: int = node_kind[id];
  if k == N_RETURN then tc_contract_scan_expr(fun, node_a[id]);
  else if k == N_BLOCK then { let p: int = node_a[id]; while p != 0 { tc_contract_scan_stmt(fun, p); p = node_next[p]; } }
  else if k == N_IF then { tc_contract_scan_stmt(fun, node_b[id]); tc_contract_scan_stmt(fun, node_c[id]); }
  else if k == N_WHILE then tc_contract_scan_stmt(fun, node_b[id]);
  else if k == N_FOR then { tc_contract_scan_stmt(fun, node_a[id]); tc_contract_scan_stmt(fun, node_c[id]); tc_contract_scan_stmt(fun, node_value[id]); }
  else if k == N_MATCH then { let arm: int = node_b[id]; while arm != 0 { tc_contract_scan_stmt(fun, node_b[arm]); arm = node_next[arm]; } }
}
func tc_prepare_return_contracts(root: int): void {
  let item: int = node_a[root];
  while item != 0 {
    if node_kind[item] == N_FUNC || node_kind[item] == N_GENERIC_FUNC then {
      ensure_tc_fun_meta(item);
      if node_b[item] != 0 && node_kind[node_b[item]] == TY_PTR then {
      tc_fun_return_param[item] = 0; tc_fun_return_mut[item] = 0;
      tc_contract_scan_stmt(item, node_a[item]);
        if tc_fun_return_param[item] < 0 then { tc_error_pos = node_pos[item]; tc_fail(69); }
      }
    }
    item = node_next[item];
  }
}
func tc_check_mutable_place(id: int): void {
  if id == 0 then { tc_fail(70); return; }
  if node_kind[id] == N_VAR then {
    if tc_lookup_var(node_value[id]) == 0 then { tc_fail(5); return; }
    if tc_var_const[tc_last_var_index] == 1 then { tc_fail(31); return; }
    if tc_var_mode[tc_last_var_index] == 2 then { tc_fail(70); return; }
    if tc_borrow_conflict(tc_last_var_index) == 1 then { tc_fail(37); return; }
    return;
  }
  if tc_is_place(id) == 0 then { tc_fail(70); return; }
  if tc_place_is_const(id) == 1 then { tc_fail(31); return; }
  tc_expr(id);
  let root: int = tc_expr_borrow_source;
  if root < 0 then root = tc_place_root(id);
  if root < 0 then { tc_fail(70); return; }
  if tc_expr_borrow_mut == 1 then {
    if root < tc_var_count && tc_var_borrow_mut[root] == 1 && tc_var_borrow_count[root] == 0 then return;
  }
  tc_fail(37);
}
func tc_borrow_conflict(index: int): int {
  if index < 0 then return 0;
  if index < tc_var_count && (tc_var_borrow_count[index] > 0 || tc_var_borrow_mut[index] > 0) then return 1;
  return 0;
}
func tc_mut_borrow_conflict(index: int): int {
  if index < 0 then return 0;
  if index < tc_var_count && (tc_var_borrow_count[index] > 0 || tc_var_borrow_mut[index] > 0) then return 1;
  return 0;
}
func tc_move_var(index: int): void {
  if index < 0 then { tc_fail(5); return; }
  if index < tc_var_count then { } else { tc_fail(5); return; }
  if tc_borrow_conflict(index) == 1 then { tc_fail(37); return; }
  if tc_var_moved[index] == 1 then { tc_fail(34); return; }
  if tc_var_owned[index] == 0 then { tc_fail(35); return; }
  tc_var_moved[index] = 1;
  tc_var_owned[index] = 0;
}
func tc_move_value(id: int): void {
  if id == 0 || node_kind[id] != N_VAR then return;
  if tc_loop_depth > 0 then { tc_fail(75); return; }
  if tc_lookup_var(node_value[id]) == 0 then { tc_fail(5); return; }
  if tc_is_owner_type(tc_last_var_type) == 1 then tc_move_var(tc_last_var_index);
  else tc_fail(58);
}
func tc_check_call_borrow(arg: int, mode: int): void {
  if mode == 0 then return;
  if mode == 1 then {
    if arg != 0 && node_kind[arg] == N_MOVE then return;
    tc_fail(40);
    return;
  }
  let source_index: int = 0 - 1;
  if arg != 0 && node_kind[arg] == N_VAR then {
    if tc_lookup_var(node_value[arg]) == 1 then source_index = tc_last_var_index;
  } else {
    source_index = tc_expr_borrow_source;
  }
  if source_index < 0 then { tc_fail(59); return; }
  if source_index >= tc_var_count then { tc_fail(59); return; }
  if tc_var_moved[source_index] == 1 then { tc_fail(33); return; }
  if mode == 2 then {
    if tc_var_borrow_mut[source_index] > 0 && tc_expr_borrow_mut == 0 then tc_fail(37);
  } else if mode == 3 then {
    if tc_expr_borrow_mut == 0 && (tc_var_mode[source_index] == 2 || tc_var_borrow_mode[source_index] == 2) then { tc_fail(37); return; }
    if tc_expr_borrow_mut == 1 && tc_var_borrow_mut[source_index] == 1 && tc_var_borrow_count[source_index] == 0 then { }
    else if tc_var_borrow_count[source_index] > 0 || tc_var_borrow_mut[source_index] > 0 then tc_fail(37);
  }
}
func tc_check_return_escape(source_index: int): void {
  if source_index < 0 then return;
  if source_index < tc_global_count then return;
  if source_index < tc_var_count && tc_var_param[source_index] == 1 && (tc_var_mode[source_index] == 2 || tc_var_mode[source_index] == 3) then return;
  tc_fail(72);
}
func tc_check_explicit_return_address_escape(source_index: int): void {
  if source_index < 0 then return;
  if source_index < tc_global_count then return;
  if source_index < tc_var_count && tc_var_param[source_index] == 1 && (tc_var_mode[source_index] == 2 || tc_var_mode[source_index] == 3) then return;
  tc_fail(38);
}
func tc_record_borrow_ex(destination: int, source_index2: int, mode: int, origin: int): void {
  if destination < 0 || source_index2 < 0 then return;
  if destination >= tc_var_count || source_index2 >= tc_var_count then return;
  if tc_var_moved[source_index2] == 1 then { tc_fail(33); return; }
  if origin < 0 then origin = source_index2;
  if tc_borrow_conflict_from(source_index2, origin, mode == 3) == 1 then { tc_fail(37); return; }
  if mode == 3 then tc_var_borrow_mut[source_index2] = tc_var_borrow_mut[source_index2] + 1;
  else tc_var_borrow_count[source_index2] = tc_var_borrow_count[source_index2] + 1;
  tc_var_borrow_source[destination] = source_index2;
